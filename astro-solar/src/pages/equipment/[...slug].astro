---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import ProductDetail from '../../components/pages/ProductDetail.tsx';
import { getCollection } from 'astro:content';

// Generate static paths for all products
export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

if (!product) {
  return Astro.redirect('/equipment');
}
---

<DashboardLayout
  title={product.data.name}
  description={product.data.description || `Chi tiết sản phẩm ${product.data.name} - EPCVINA Solar`}
>
  <DashboardShell client:load>
    <ProductDetail client:load product={product.data} />
  </DashboardShell>
</DashboardLayout>
