---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ProductDetail from '../../components/pages/ProductDetail.tsx';
import { localProducts } from '../../data/products';

// Generate static paths for all products
export function getStaticPaths() {
  return localProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { slug } = Astro.params;
const { product } = Astro.props;

if (!product) {
  return Astro.redirect('/equipment');
}
---

<DashboardLayout
  title={product.name}
  description={product.description || `Chi tiết sản phẩm ${product.name} - EPCVINA Solar`}
>
  <ProductDetail client:load product={product} />
</DashboardLayout>
