---
// EPCVINA Corporate Header
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-red-600 to-red-800 rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-lg">E</span>
        </div>
        <div>
          <h1 class="text-xl font-bold text-gray-900">EPCVINA</h1>
          <p class="text-xs text-gray-500">MEP & Energy Solutions</p>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8">
        <a href="/" class="text-sm font-medium text-gray-700 hover:text-red-600 transition-colors">Trang chủ</a>
        <a href="/about" class="text-sm font-medium text-gray-700 hover:text-red-600 transition-colors">Giới thiệu</a>
        <a href="/services" class="text-sm font-medium text-gray-700 hover:text-red-600 transition-colors">Lĩnh vực hoạt động</a>
        <a href="/projects" class="text-sm font-medium text-gray-700 hover:text-red-600 transition-colors">Dự án</a>
        <a href="https://epcvina-solar.com" class="text-sm font-semibold text-orange-600 hover:text-orange-700 transition-colors flex items-center gap-1">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
          EPCVINA Solar
        </a>
        <a href="/profile" class="text-sm font-medium text-gray-700 hover:text-red-600 transition-colors">Hồ sơ năng lực</a>
        <a href="/news" class="text-sm font-medium text-gray-700 hover:text-red-600 transition-colors">Tin tức</a>
        <a href="/contact" class="text-sm font-medium text-gray-700 hover:text-red-600 transition-colors">Liên hệ</a>
      </nav>

      <!-- CTA Button -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="tel:0988446113" class="inline-flex items-center gap-2 px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-full transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          0988 446 113
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden lg:hidden py-4 border-t border-gray-200">
      <nav class="flex flex-col gap-3">
        <a href="/" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Trang chủ</a>
        <a href="/about" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Giới thiệu</a>
        <a href="/services" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Lĩnh vực hoạt động</a>
        <a href="/projects" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Dự án</a>
        <a href="https://epcvina-solar.com" class="px-4 py-2 text-sm font-semibold text-orange-600 hover:bg-orange-50 rounded-lg">EPCVINA Solar</a>
        <a href="/profile" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Hồ sơ năng lực</a>
        <a href="/news" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Tin tức</a>
        <a href="/contact" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Liên hệ</a>
        <a href="/contact" class="mx-4 mt-2 inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-red-600 text-white text-sm font-semibold rounded-full">
          Nhận tư vấn
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
