---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="Tin tức – Sự kiện & Cập nhật ngành | EPCVINA">
  <!-- Hero Section -->
  <section class="pt-24 lg:pt-32 bg-gradient-to-br from-blue-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-4xl">
        <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          Tin tức <span class="text-red-600">& Sự kiện</span>
        </h1>
        <p class="text-xl text-gray-600 leading-relaxed">
          Cập nhật thông tin về EPCVINA và xu hướng ngành cơ điện, năng lượng
        </p>
      </div>
    </div>
  </section>

  <!-- News Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- News 1 -->
        <article class="group bg-white rounded-xl shadow-sm hover:shadow-xl transition-all border border-gray-200 overflow-hidden">
          <div class="aspect-video bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center">
            <svg class="w-16 h-16 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-red-100 text-blue-700 text-xs font-semibold rounded-full">Tin tức</span>
              <span class="text-xs text-gray-500">15/06/2024</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-red-600 transition-colors">
              EPCVINA hoàn thành dự án MEP cho tòa nhà 15 tầng
            </h3>
            <p class="text-sm text-gray-600 mb-4">
              Dự án hệ thống cơ điện hoàn chỉnh cho tòa nhà văn phòng tại Hà Nội...
            </p>
            <a href="#" class="inline-flex items-center gap-1 text-sm text-red-600 font-semibold">
              Đọc tiếp
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </article>

        <!-- News 2 -->
        <article class="group bg-white rounded-xl shadow-sm hover:shadow-xl transition-all border border-gray-200 overflow-hidden">
          <div class="aspect-video bg-gradient-to-br from-orange-100 to-orange-200 flex items-center justify-center">
            <svg class="w-16 h-16 text-orange-600" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-orange-100 text-orange-700 text-xs font-semibold rounded-full">Năng lượng</span>
              <span class="text-xs text-gray-500">10/06/2024</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-orange-600 transition-colors">
              Xu hướng điện mặt trời kết hợp lưu trữ BESS 2024
            </h3>
            <p class="text-sm text-gray-600 mb-4">
              Giải pháp Hybrid giúp tối ưu hiệu quả sử dụng năng lượng mặt trời...
            </p>
            <a href="#" class="inline-flex items-center gap-1 text-sm text-orange-600 font-semibold">
              Đọc tiếp
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </article>

        <!-- News 3 -->
        <article class="group bg-white rounded-xl shadow-sm hover:shadow-xl transition-all border border-gray-200 overflow-hidden">
          <div class="aspect-video bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center">
            <svg class="w-16 h-16 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded-full">Công nghệ</span>
              <span class="text-xs text-gray-500">05/06/2024</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-green-600 transition-colors">
              EV Charger – Hạ tầng thiết yếu cho xe điện tại Việt Nam
            </h3>
            <p class="text-sm text-gray-600 mb-4">
              EPCVINA triển khai hệ thống trạm sạc xe điện cho khu đô thị...
            </p>
            <a href="#" class="inline-flex items-center gap-1 text-sm text-green-600 font-semibold">
              Đọc tiếp
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </article>

        <!-- News 4 -->
        <article class="group bg-white rounded-xl shadow-sm hover:shadow-xl transition-all border border-gray-200 overflow-hidden">
          <div class="aspect-video bg-gradient-to-br from-purple-100 to-purple-200 flex items-center justify-center">
            <svg class="w-16 h-16 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-purple-100 text-purple-700 text-xs font-semibold rounded-full">Hướng dẫn</span>
              <span class="text-xs text-gray-500">01/06/2024</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-purple-600 transition-colors">
              Tiêu chuẩn PCCC mới cho công trình công nghiệp
            </h3>
            <p class="text-sm text-gray-600 mb-4">
              Cập nhật các quy định mới về phòng cháy chữa cháy năm 2024...
            </p>
            <a href="#" class="inline-flex items-center gap-1 text-sm text-purple-600 font-semibold">
              Đọc tiếp
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </article>

        <!-- News 5 -->
        <article class="group bg-white rounded-xl shadow-sm hover:shadow-xl transition-all border border-gray-200 overflow-hidden">
          <div class="aspect-video bg-gradient-to-br from-cyan-100 to-cyan-200 flex items-center justify-center">
            <svg class="w-16 h-16 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-cyan-100 text-cyan-700 text-xs font-semibold rounded-full">Sự kiện</span>
              <span class="text-xs text-gray-500">25/05/2024</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-cyan-600 transition-colors">
              EPCVINA tham gia triển lãm VietBuild 2024
            </h3>
            <p class="text-sm text-gray-600 mb-4">
              Giới thiệu giải pháp cơ điện và năng lượng tại triển lãm lớn...
            </p>
            <a href="#" class="inline-flex items-center gap-1 text-sm text-cyan-600 font-semibold">
              Đọc tiếp
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </article>

        <!-- News 6 -->
        <article class="group bg-white rounded-xl shadow-sm hover:shadow-xl transition-all border border-gray-200 overflow-hidden">
          <div class="aspect-video bg-gradient-to-br from-yellow-100 to-yellow-200 flex items-center justify-center">
            <svg class="w-16 h-16 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-3 py-1 bg-yellow-100 text-yellow-700 text-xs font-semibold rounded-full">Phân tích</span>
              <span class="text-xs text-gray-500">20/05/2024</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-yellow-600 transition-colors">
              ROI của hệ thống điện mặt trời mái nhà năm 2024
            </h3>
            <p class="text-sm text-gray-600 mb-4">
              Phân tích hiệu quả đầu tư và thời gian hoàn vốn thực tế...
            </p>
            <a href="#" class="inline-flex items-center gap-1 text-sm text-yellow-600 font-semibold">
              Đọc tiếp
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-red-600 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold mb-6">Đăng ký nhận tin</h2>
      <p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">
        Nhận thông tin cập nhật về xu hướng ngành và ưu đãi từ EPCVINA
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center max-w-2xl mx-auto">
        <input 
          type="email" 
          placeholder="Email của bạn" 
          class="flex-1 px-6 py-4 rounded-full text-gray-900 focus:outline-none focus:ring-2 focus:ring-white"
        />
        <button class="px-8 py-4 bg-white hover:bg-gray-100 text-red-600 font-semibold rounded-full transition-all hover:shadow-lg">
          Đăng ký
        </button>
      </div>
    </div>
  </section>
</PageLayout>
