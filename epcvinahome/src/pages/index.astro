---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../components/sections/HeroSection';
import VideoSection from '../components/sections/VideoSection';
import AnimatedStatsCounter from '../components/sections/AnimatedStatsCounter';
import ClientLogosCarousel from '../components/sections/ClientLogosCarousel';
import FAQAccordion from '../components/sections/FAQAccordion';
---

<PageLayout title="EPCVINA – Nhà thầu MEP hàng đầu Việt Nam | epc.com.vn"
  description="EPCVINA chuyên cơ điện MEP: HVAC, điện, cấp thoát nước, PCCC cho công trình công nghiệp, thương mại, dân dụng. 15+ năm kinh nghiệm, 200+ dự án.">
  <!-- Hero Section (React with animations) -->
  <HeroSection client:only="react" />

  <!-- Video Introduction Section (React with modal) -->
  <VideoSection client:only="react" />

  <!-- About Section -->
  <section class="py-20 lg:py-28 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">Về EPCVINA</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          EPCVINA là đơn vị hoạt động trong lĩnh vực xây lắp cơ điện, cung cấp các giải pháp kỹ thuật cho công trình dân dụng, thương mại, công nghiệp và hạ tầng kỹ thuật.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-6 bg-gradient-to-br from-red-50 to-white rounded-xl border border-red-100">
          <div class="w-12 h-12 bg-red-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Nền tảng cơ điện MEP</h3>
          <p class="text-gray-600">Chuyên môn sâu rộng trong lĩnh vực cơ điện công trình</p>
        </div>
        
        <div class="p-6 bg-gradient-to-br from-green-50 to-white rounded-xl border border-green-100">
          <div class="w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Đội ngũ kỹ thuật</h3>
          <p class="text-gray-600">Kinh nghiệm và chuyên môn cao</p>
        </div>
        
        <div class="p-6 bg-gradient-to-br from-orange-50 to-white rounded-xl border border-orange-100">
          <div class="w-12 h-12 bg-orange-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">An toàn & Chất lượng</h3>
          <p class="text-gray-600">Thi công theo tiêu chuẩn an toàn</p>
        </div>
        
        <div class="p-6 bg-gradient-to-br from-purple-50 to-white rounded-xl border border-purple-100">
          <div class="w-12 h-12 bg-purple-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Kiểm soát tiến độ</h3>
          <p class="text-gray-600">Đảm bảo chất lượng và thời gian</p>
        </div>
        
        <div class="p-6 bg-gradient-to-br from-cyan-50 to-white rounded-xl border border-cyan-100">
          <div class="w-12 h-12 bg-cyan-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Bảo trì dài hạn</h3>
          <p class="text-gray-600">Vận hành và bảo trì chuyên nghiệp</p>
        </div>
        
        <div class="p-6 bg-gradient-to-br from-yellow-50 to-white rounded-xl border border-yellow-100">
          <div class="w-12 h-12 bg-yellow-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Solar, BESS, EV Charger</h3>
          <p class="text-gray-600">Mở rộng giải pháp năng lượng mới</p>
        </div>
      </div>
      
      <div class="text-center mt-12">
        <a href="/about" class="inline-flex items-center gap-2 px-8 py-4 bg-gray-900 hover:bg-gray-800 text-white font-semibold rounded-lg transition-all hover:shadow-lg">
          Tìm hiểu về EPCVINA
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Animated Stats Counter (React with counting animation) -->
  <AnimatedStatsCounter client:only="react" />

  <!-- Client Logos Section (React with carousel) -->
  <ClientLogosCarousel client:only="react" />

  <!-- Services Section -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">Lĩnh vực hoạt động</h2>
