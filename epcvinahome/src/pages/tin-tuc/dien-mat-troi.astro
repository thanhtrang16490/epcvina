---
import PageLayout from '../../layouts/PageLayout.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Lắp điện mặt trời hết bao nhiêu tiền?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Chi phí lắp điện mặt trời phụ thuộc công suất: Hệ 3-5kW cho gia đình khoảng 60-100 triệu, hệ 10-20kW khoảng 150-350 triệu, hệ công nghiệp 100kWp+ từ 1,5 tỷ. Xem báo giá chi tiết tại EPCVINA Solar."
      }
    },
    {
      "@type": "Question",
      "name": "Điện mặt trời On-Grid và Hybrid khác nhau thế nào?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On-Grid hòa lưới trực tiếp, không lưu trữ, chi phí thấp nhất. Hybrid có pin lưu trữ, backup khi mất điện, phù hợp gia đình cần ổn định nguồn 24/7."
      }
    },
    {
      "@type": "Question",
      "name": "Thời gian hoàn vốn điện mặt trời bao lâu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trung bình 3-6 năm tùy công suất và mức tiêu thụ điện. Sau hoàn vốn, hệ thống tiếp tục sản xuất điện miễn phí 20-25 năm nữa."
      }
    },
    {
      "@type": "Question",
      "name": "Mái nhà nào lắp được điện mặt trời?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mái tôn, mái ngói, mái bằng, sân thượng đều lắp được. Diện tích tối thiểu khoảng 15-20m² cho hệ gia đình. Hướng Nam, Tây Nam tối ưu nhất."
      }
    }
  ]
};
---

<PageLayout 
  title="Điện Mặt Trời – Kiến Thức A-Z | EPCVINA Solar"
  description="Tổng hợp kiến thức về điện mặt trời: chi phí, lợi ích, phân loại On-Grid/Hybrid, quy trình lắp đặt, bảo trì. Tư vấn miễn phí từ EPCVINA Solar – 500+ dự án.">

  <!-- Hero -->
  <section class="pt-24 lg:pt-32 bg-gradient-to-br from-orange-50 via-white to-yellow-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-4xl">
        <div class="inline-block px-4 py-2 bg-orange-100 text-orange-700 text-sm font-semibold rounded-full mb-4">
          ☀️ Cẩm nang điện mặt trời
        </div>
        <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          Điện Mặt Trời <span class="text-orange-600">A–Z</span>
        </h1>
        <p class="text-xl text-gray-600 leading-relaxed">
          Tất cả những gì bạn cần biết về lắp đặt điện mặt trời cho gia đình, doanh nghiệp. 
          Từ chi phí, loại hệ thống, đến quy trình triển khai – được tổng hợp bởi 
          <a href="https://epcvina.com" target="_blank" rel="noopener" class="text-orange-600 hover:underline font-semibold">EPCVINA Solar</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Stats -->
  <section class="py-12 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-3xl font-bold text-orange-600">500+</div>
          <div class="text-sm text-gray-600 mt-1">Dự án triển khai</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-green-600">3-5 năm</div>
          <div class="text-sm text-gray-600 mt-1">Thời gian hoàn vốn</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-blue-600">25 năm</div>
          <div class="text-sm text-gray-600 mt-1">Bảo hành hiệu suất</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-red-600">90%</div>
          <div class="text-sm text-gray-600 mt-1">Tiết kiệm điện</div>
        </div>
      </div>
    </div>
  </section>

  <!-- System Types -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">Các Loại Hệ Thống Điện Mặt Trời</h2>
        <p class="text-lg text-gray-600">Chọn giải pháp phù hợp với nhu cầu của bạn</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- On-Grid -->
        <div class="bg-gradient-to-br from-blue-50 to-white rounded-2xl border-2 border-blue-100 p-8 hover:shadow-xl transition-shadow">
          <div class="w-14 h-14 bg-blue-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">On-Grid</h3>
          <p class="text-gray-600 mb-4">Hòa lưới trực tiếp, không pin lưu trữ. Chi phí thấp nhất, ROI nhanh nhất.</p>
          <ul class="space-y-2 text-sm text-gray-600 mb-6">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Phù hợp ban ngày dùng nhiều</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Hoàn vốn 3-4 năm</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Đầu tư từ 50 triệu</li>
          </ul>
          <a href="https://epcvina.com/solar-home/on-grid" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-blue-600 font-semibold text-sm hover:gap-2 transition-all">
            Chi tiết On-Grid →
          </a>
        </div>

        <!-- Hybrid -->
        <div class="bg-gradient-to-br from-orange-50 to-white rounded-2xl border-2 border-orange-200 p-8 hover:shadow-xl transition-shadow relative">
          <div class="absolute top-4 right-4 px-3 py-1 bg-orange-600 text-white text-xs font-bold rounded-full">Phổ biến</div>
          <div class="w-14 h-14 bg-orange-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Hybrid + BESS</h3>
          <p class="text-gray-600 mb-4">Có pin lưu trữ, backup khi mất điện. Ổn định 24/7.</p>
          <ul class="space-y-2 text-sm text-gray-600 mb-6">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-orange-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Backup toàn bộ tải critical</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-orange-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Dùng được ban đêm</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-orange-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Hoàn vốn 4-6 năm</li>
          </ul>
          <a href="https://epcvina.com/solar-home/hybrid" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-orange-600 font-semibold text-sm hover:gap-2 transition-all">
            Chi tiết Hybrid →
          </a>
        </div>

        <!-- Industrial -->
        <div class="bg-gradient-to-br from-green-50 to-white rounded-2xl border-2 border-green-100 p-8 hover:shadow-xl transition-shadow">
          <div class="w-14 h-14 bg-green-600 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Công Nghiệp</h3>
          <p class="text-gray-600 mb-4">Hệ 50kWp-1MWp+ cho nhà xưởng, KCN. Tiết kiệm tỷ đồng/năm.</p>
          <ul class="space-y-2 text-sm text-gray-600 mb-6">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Giảm 50-70% tiền điện</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Đáp ứng tiêu chuẩn ESG</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Thi công 7-15 ngày</li>
          </ul>
          <a href="https://epcvina.com/ung-dung/dien-cong-nghiep" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-green-600 font-semibold text-sm hover:gap-2 transition-all">
            Chi tiết C&I →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost Guide -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">Bảng Chi Phí Lắp Đặt Tham Khảo</h2>
        <p class="text-lg text-gray-600">Cập nhật 2025 – Nguồn: <a href="https://epcvina.com/bao-gia" target="_blank" rel="noopener" class="text-orange-600 hover:underline font-semibold">EPCVINA Solar</a></p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full bg-white rounded-xl overflow-hidden shadow-sm">
          <thead class="bg-orange-600 text-white">
            <tr>
              <th class="px-6 py-4 text-left text-sm font-semibold">Hệ thống</th>
              <th class="px-6 py-4 text-left text-sm font-semibold">Công suất</th>
              <th class="px-6 py-4 text-left text-sm font-semibold">Chi phí</th>
              <th class="px-6 py-4 text-left text-sm font-semibold">Tiết kiệm/tháng</th>
              <th class="px-6 py-4 text-left text-sm font-semibold">Hoàn vốn</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr class="hover:bg-orange-50 transition-colors">
