  <!-- Related Articles -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">Bài Viết Liên Quan</h2>
        <p class="text-lg text-gray-600">Tìm hiểu thêm từ chuyên gia EPCVINA</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <a href="/tin-tuc/dien-mat-troi-cho-nha-may" class="group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
          <div class="aspect-video bg-gradient-to-br from-purple-100 to-orange-100 flex items-center justify-center">
            <span class="text-5xl">🏭</span>
          </div>
          <div class="p-6">
            <span class="text-xs font-semibold text-purple-600 bg-purple-50 px-2 py-1 rounded-full">Công nghiệp</span>
            <h3 class="text-lg font-semibold text-gray-900 mt-3 group-hover:text-orange-600 transition-colors">Điện mặt trời cho nhà máy, xưởng sản xuất</h3>
            <p class="text-sm text-gray-600 mt-2">Tiết kiệm 50-70% chi phí điện, ROI 3-5 năm cho nhà xưởng 1000m²+.</p>
          </div>
        </a>

        <a href="/tin-tuc/lap-dien-mat-troi-cho-gia-dinh" class="group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
          <div class="aspect-video bg-gradient-to-br from-blue-100 to-green-100 flex items-center justify-center">
            <span class="text-5xl">🏠</span>
          </div>
          <div class="p-6">
            <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-1 rounded-full">Gia đình</span>
            <h3 class="text-lg font-semibold text-gray-900 mt-3 group-hover:text-orange-600 transition-colors">Hướng dẫn lắp điện mặt trời cho gia đình 2025</h3>
            <p class="text-sm text-gray-600 mt-2">Từ A-Z: chọn hệ thống, tính chi phí, thủ tục EVN, giám sát thi công.</p>
          </div>
        </a>

        <a href="/tin-tuc/on-grid-vs-hybrid-phan-biet" class="group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
          <div class="aspect-video bg-gradient-to-br from-yellow-100 to-orange-100 flex items-center justify-center">
            <span class="text-5xl">⚡</span>
          </div>
          <div class="p-6">
