              <td class="px-6 py-4 text-gray-600">3-4 năm</td>
            </tr>
            <tr class="hover:bg-orange-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">Nhà máy</td>
              <td class="px-6 py-4 text-gray-600">100kWp+</td>
              <td class="px-6 py-4 text-gray-600">1.5 tỷ+</td>
              <td class="px-6 py-4 text-green-600 font-semibold">30-50 triệu</td>
              <td class="px-6 py-4 text-gray-600">3-4 năm</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="text-center mt-8">
        <a href="https://epcvina.com/bao-gia" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-8 py-4 bg-orange-600 hover:bg-orange-700 text-white font-semibold rounded-full transition-all hover:shadow-lg">
          Nhận báo giá chi tiết miễn phí
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">Quy Trình Lắp Đặt</h2>
        <p class="text-lg text-gray-600">Từ khảo sát đến vận hành – <a href="https://epcvina.com/quy-trinh-thi-cong" target="_blank" rel="noopener" class="text-orange-600 hover:underline font-semibold">Xem chi tiết tại EPCVINA Solar</a></p>
      </div>

      <div class="grid md:grid-cols-5 gap-6">
        <div class="text-center">
          <div class="w-16 h-16 bg-orange-600 rounded-full flex items-center justify-center mx-auto mb-4 text-white text-2xl font-bold">1</div>
          <h3 class="font-semibold text-gray-900 mb-2">Khảo sát</h3>
          <p class="text-sm text-gray-600">Đánh giá mái, kết cấu, hướng nắng</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-orange-600 rounded-full flex items-center justify-center mx-auto mb-4 text-white text-2xl font-bold">2</div>
          <h3 class="font-semibold text-gray-900 mb-2">Thiết kế</h3>
          <p class="text-sm text-gray-600">Bản vẽ 3D, tính sản lượng</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-orange-600 rounded-full flex items-center justify-center mx-auto mb-4 text-white text-2xl font-bold">3</div>
