              <td class="px-6 py-4 text-gray-600">4-5 năm</td>
            </tr>
            <tr class="hover:bg-orange-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">Gia đình lớn</td>
              <td class="px-6 py-4 text-gray-600">5-8kWp</td>
              <td class="px-6 py-4 text-gray-600">100-160 triệu</td>
              <td class="px-6 py-4 text-green-600 font-semibold">1.5-2.5 triệu</td>
              <td class="px-6 py-4 text-gray-600">3-5 năm</td>
            </tr>
