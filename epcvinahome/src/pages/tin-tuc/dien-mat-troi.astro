              <td class="px-6 py-4 text-gray-600">3-5 năm</td>
            </tr>
            <tr class="hover:bg-orange-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">Nhà xưởng nhỏ</td>
              <td class="px-6 py-4 text-gray-600">50kWp</td>
              <td class="px-6 py-4 text-gray-600">~750 triệu</td>
