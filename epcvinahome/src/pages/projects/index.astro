        <div class="text-center">
          <div class="text-5xl font-bold text-red-400 mb-2">200+</div>
          <div class="text-gray-300">Dự án hoàn thành</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-red-400 mb-2">50+</div>
          <div class="text-gray-300">Khách hàng lớn</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-red-400 mb-2">15+</div>
          <div class="text-gray-300">Tỉnh thành</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-red-400 mb-2">2011</div>
          <div class="text-gray-300">Năm thành lập</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-red-600 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold mb-6">Bạn có dự án cần tư vấn?</h2>
      <p class="text-xl text-red-100 mb-8 max-w-3xl mx-auto">
        Liên hệ để được khảo sát và tư vấn giải pháp MEP tối ưu nhất
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white hover:bg-gray-100 text-red-600 font-semibold rounded-full transition-all hover:shadow-lg">
