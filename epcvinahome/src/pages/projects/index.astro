---

<PageLayout title="Dự án tiêu biểu – Công trình MEP & Năng lượng | EPCVINA">
  <!-- Hero Section -->
  <section class="pt-24 lg:pt-32 bg-gradient-to-br from-blue-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="max-w-4xl">
        <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          Dự án <span class="text-red-600">tiêu biểu</span>
        </h1>
        <p class="text-xl text-gray-600 leading-relaxed">
          Hơn 200 công trình MEP đã thực hiện cho Samsung, VinFast, Lotte, Keangnam, Vinhomes và các đối tác lớn
        </p>
      </div>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allProjects.map((project) => (
          <article
            class="project-card group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-xl transition-all"
            data-category={project.category}
          >
            <div class="aspect-video bg-gradient-to-br from-blue-100 to-gray-200 flex items-center justify-center overflow-hidden">
              {project.image ? (
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <svg class="w-16 h-16 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
              )}
            </div>
            
            <div class="p-6">
              {project.highlight && (
                <span class="inline-block px-3 py-1 bg-red-100 text-red-700 text-xs font-semibold rounded-full mb-3">Nổi bật</span>
              )}
              
              <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-red-600 transition-colors">
                {project.title}
              </h3>
              
              <p class="text-sm text-gray-600 mb-4">{project.description}</p>
              
              <div class="space-y-2 mb-4 text-sm">
                <div class="flex items-center gap-2 text-gray-600">
                  <svg class="w-4 h-4 text-red-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05c7.822 0 14.15 6.328 14.15 14.15 0 7.822-6.328 14.15-14.15 14.15-7.822 0-14.15-6.328-14.15-14.15 0-7.822 6.328-14.15 14.15-14.15zM5 10a5 5 0 1110 0 5 5 0 01-10 0z" clip-rule="evenodd"/>
                  </svg>
                  <span>{project.location}</span>
                </div>
                <div class="flex items-center gap-2 text-gray-600">
                  <svg class="w-4 h-4 text-red-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                  </svg>
                  <span>{project.year}</span>
                </div>
                <div class="flex items-center gap-2 text-gray-600">
                  <svg class="w-4 h-4 text-red-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/>
                  </svg>
                  <span>{project.client}</span>
                </div>
              </div>
              
              <div class="border-t border-gray-200 pt-4 mb-4">
                <h4 class="text-xs font-semibold text-gray-700 mb-2 uppercase">Phạm vi triển khai</h4>
                <div class="flex flex-wrap gap-2">
                  {project.scope.map((item) => (
                    <span class="px-2 py-1 bg-red-50 text-red-700 text-xs rounded-md">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
              
              <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                <span class={`inline-flex items-center gap-1 text-xs font-semibold px-3 py-1 rounded-full ${
                  project.status === 'Đang thi công'
                    ? 'bg-yellow-100 text-yellow-700'
                    : 'bg-green-100 text-green-700'
                }`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${
                    project.status === 'Đang thi công' ? 'bg-yellow-600' : 'bg-green-600'
                  }`}></span>
                  {project.status}
                </span>
                <span class="text-xs text-gray-500">{project.category}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-20 bg-gradient-to-br from-gray-900 to-gray-800 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
