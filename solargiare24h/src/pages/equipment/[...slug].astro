---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import ProductDetail from '../../components/pages/product-detail/ProductDetail.tsx';
import { getCollection } from 'astro:content';

// Generate static paths for all products
export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

if (!product) {
  return Astro.redirect('/equipment');
}

const productId = product.id.replace('.md', '');

// Product structured data with epcvina.com backlink
const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.data.name,
  description: product.data.description,
  brand: { '@type': 'Brand', name: product.data.brand },
  model: product.data.model,
  category: product.data.category,
  url: `https://epcvina.com/thiet-bi/${productId}`,
  offers: {
    '@type': 'Offer',
    url: `https://epcvina.com/thiet-bi/${productId}`,
    priceCurrency: 'VND',
    price: product.data.price || '0',
    availability: product.data.is_available ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    seller: { '@type': 'Organization', name: 'EPCVINA' },
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang Chủ', item: 'https://solargiare24h.com' },
    { '@type': 'ListItem', position: 2, name: 'Thiết Bị', item: 'https://solargiare24h.com/equipment' },
    { '@type': 'ListItem', position: 3, name: product.data.category?.toUpperCase() || 'Sản Phẩm', item: `https://solargiare24h.com/equipment/${product.data.category || ''}` },
    { '@type': 'ListItem', position: 4, name: product.data.name, item: `https://solargiare24h.com/equipment/${productId}` },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

<DashboardLayout
  title={`${product.data.name} - Solar Giá Rẻ 24h`}
  description={product.data.description || `Chi tiết sản phẩm ${product.data.name} - Thiết bị điện mặt trời chính hãng`}
  breadcrumbs={[
    {name: "Trang Chủ", url: "/"},
    {name: "Thiết Bị", url: "/equipment"},
    {name: product.data.category?.toUpperCase() || 'Sản Phẩm', url: `/equipment/${product.data.category || ''}`},
    {name: product.data.name, url: `/equipment/${productId}`}
  ]}
>
  <DashboardShell client:load>
    <ProductDetail 
      client:visible 
      product={{...product.data, id: productId}}
    />
  </DashboardShell>
</DashboardLayout>
