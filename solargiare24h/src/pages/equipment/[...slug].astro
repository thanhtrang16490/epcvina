---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import ProductDetail from '../../components/pages/product-detail/ProductDetail.tsx';
import { getCollection } from 'astro:content';

// Generate static paths for all products
export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

if (!product) {
  return Astro.redirect('/equipment');
}

// Fetch related projects that use this product
const allProjects = await getCollection('projects');
const productId = product.id.replace('.md', '');
const productCategory = product.data.category;
const relatedProjects = allProjects
  .filter(project => {
    // Check if project equipment items reference this product
    const equipmentItems = project.data.equipment_items || [];
    return equipmentItems.some(item => {
      const productSlug = item.product_slug || '';
      return productSlug.includes(productId) || 
             productId.includes(productSlug.split('/').pop() || '') ||
             productSlug.includes(productCategory);
    });
  })
  .slice(0, 3); // Limit to 3 projects
---

<DashboardLayout
  title={`${product.data.name} - Solar Giá Rẻ 24h`}
  description={product.data.description || `Chi tiết sản phẩm ${product.data.name} - Thiết bị điện mặt trời chính hãng`}
  breadcrumbs={[
    {name: "Trang Chủ", url: "/"},
    {name: "Thiết Bị", url: "/equipment"},
    {name: product.data.category?.toUpperCase() || 'Sản Phẩm', url: `/equipment/${product.data.category || ''}`},
    {name: product.data.name, url: `/equipment/${product.id.replace('.md', '')}`}
  ]}
>
  <DashboardShell client:load>
    <ProductDetail 
      client:visible 
      product={product.data}
      relatedProjects={relatedProjects}
    />
  </DashboardShell>
</DashboardLayout>
