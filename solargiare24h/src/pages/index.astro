---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell';
import GigaDigitalHomepage from '../components/home/ecommerce/GigaDigitalHomepage';
import { getCollection } from 'astro:content';

// Fetch all products from content collection
const allProducts = await getCollection('products');

// Group products by category
const productsByCategory: Record<string, any[]> = {};
for (const product of allProducts) {
  const cat = product.data.category;
  if (!productsByCategory[cat]) productsByCategory[cat] = [];
  productsByCategory[cat].push({
    id: product.id.replace('.md', ''),
    name: product.data.name,
    brand: product.data.brand,
    category: cat,
    model: product.data.model,
    description: product.data.description,
    price: product.data.price || 0,
    specifications: product.data.specifications || {},
    features: product.data.features || [],
    warranty: product.data.warranty || '',
    warranty_years: product.data.warranty_years || 0,
    main_image: product.data.main_image || '',
    is_available: product.data.is_available,
    product_type: product.data.product_type || cat,
  });
}

// Get unique brands
const brands = [...new Set(allProducts.map(p => p.data.brand))].sort();

// Stats
const totalProducts = allProducts.length;
const totalBrands = brands.length;
---

<DashboardLayout
  title="Solar Giá Rẻ 24h - Thiết Bị Điện Mặt Trời Chính Hãng"
  description="Solar Giá Rẻ 24h - Chuyên cung cấp thiết bị điện mặt trời chính hãng: tấm pin, biến tần, pin lưu trữ, phụ kiện. Giá tốt nhất thị trường."
  keywords="thiết bị điện mặt trời, tấm pin năng lượng, biến tần solar, inverter, pin lưu trữ, phụ kiện solar, giá thiết bị điện mặt trời"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Solar Giá Rẻ 24h",
    "url": "https://solargiare24h.com",
    "description": "Thiết bị điện mặt trời chính hãng giá tốt",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://solargiare24h.com/equipment?search={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Lắp điện mặt trời có cần xin phép không?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Có. Theo Nghị định 135/2024/NĐ-CP, hệ thống điện mặt trời mái nhà dưới 1 MWp cần thông báo với Điện lực địa phương. Chúng tôi hỗ trợ toàn bộ thủ tục phép, đấu nối lưới và đăng ký bán điện dư với EVN miễn phí cho khách hàng."
        }
      },
      {
        "@type": "Question",
        "name": "Lắp điện mặt trời có thực sự tiết kiệm tiền điện không?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Có. Hệ thống điện mặt trời giúp giảm 70–90% hóa đơn điện hàng tháng. Với giá điện ngày càng tăng, mức tiết kiệm sẽ càng lớn theo thời gian. Trung bình một hệ 5 kWp tiết kiệm được 1.5–2.5 triệu đồng/tháng."
        }
      },
      {
        "@type": "Question",
        "name": "Thời gian hoàn vốn là bao lâu?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Thời gian hoàn vốn trung bình từ 3–5 năm cho hệ On-Grid và 5–7 năm cho hệ Hybrid. Sau khi hoàn vốn, bạn sẽ sử dụng điện miễn phí trong suốt tuổi thọ còn lại của hệ thống (20–25 năm)."
        }
      },
      {
        "@type": "Question",
        "name": "Tấm pin mặt trời bền được bao lâu? Bảo hành như thế nào?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tấm pin chất lượng cao có tuổi thọ trên 25 năm với hiệu suất giảm dần khoảng 0.5%/năm. Chúng tôi cung cấp bảo hành tấm pin 25 năm, inverter 5–10 năm. Hỗ trợ kỹ thuật và bảo trì định kỳ trong suốt vòng đời hệ thống."
        }
      },
      {
        "@type": "Question",
        "name": "Hệ thống có hoạt động trong ngày mưa hoặc trời âm u không?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Có, hệ thống vẫn phát điện trong điều kiện ít nắng, tuy nhiên sản lượng sẽ giảm 50–80% so với ngày nắng. Hệ thống được thiết kế dựa trên sản lượng trung bình cả năm nên đã tính đến các ngày mưa."
        }
      },
      {
        "@type": "Question",
        "name": "Chi phí phát sinh sau khi lắp đặt là bao nhiêu?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Chi phí bảo trì rất thấp: chủ yếu là vệ sinh tấm pin 2–4 lần/năm (có thể tự làm bằng nước sạch). Không có chi phí nhiên liệu hay phụ tùng thay thế định kỳ. Bảo trì chuyên nghiệp khoảng 500.000–1.000.000đ/năm."
        }
      }
    ]
  })} />
  <DashboardShell client:load showFooter={false}>
    <GigaDigitalHomepage 
      client:visible
      productsByCategory={productsByCategory}
      brands={brands}
      totalProducts={totalProducts}
      totalBrands={totalBrands}
    />
  </DashboardShell>
</DashboardLayout>
