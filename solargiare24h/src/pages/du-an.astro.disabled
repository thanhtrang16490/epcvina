---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell';
import ProjectsPage from '../components/pages/projects/ProjectsPage';
---

<DashboardLayout
  title="Dự Án Điện Mặt Trời Đã Triển Khai | Solar Giá Rẻ 24h"
  description="Xem các dự án điện mặt trời đã triển khai. Hơn 100 công trình On-Grid và Hybrid trên toàn quốc. Sản phẩm chính hãng, bảo hành 25 năm."
  keywords="dự án điện mặt trời, công trình solar, hệ thống điện mặt trời, On-Grid, Hybrid, solar đã lắp đặt"
  breadcrumbs={[{name: "Trang Chủ", url: "/"}, {name: "Dự Án", url: "/du-an"}]}
>
  <DashboardShell client:load>
    <ProjectsPage client:idle />
  </DashboardShell>
</DashboardLayout>