---
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{name: string, url: string}>;
}

const {
  title = 'Solar Giá Rẻ 24h - Hệ Thống Điện Mặt Trời Chính Hãng Giá Tốt',
  description = 'Solar Giá Rẻ 24h - Chuyên cung cấp hệ thống điện mặt trời chính hãng, giá rẻ. Giải pháp On-Grid & Hybrid tiết kiệm điện đến 90%.',
  keywords = 'điện mặt trời, giá điện mặt trời, solar giá rẻ, tấm pin năng lượng, inverter, hệ thống điện mặt trời, combo điện mặt trời, on-grid, hybrid',
  ogImage = '/favicon.svg',
  noindex = false,
  breadcrumbs = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Solar Giá Rẻ 24h",
  "description": description,
  "url": "https://solargiare24h.com",
  "logo": "https://solargiare24h.com/favicon.svg",
  "image": "https://solargiare24h.com/favicon.svg",
  "sameAs": [],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hệ thống điện mặt trời",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Hệ thống điện mặt trời On-Grid"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Hệ thống điện mặt trời Hybrid"
        }
      }
    ]
  }
};
---

<!DOCTYPE html>
<html lang="vi" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />


    <!-- SEO Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook / Zalo -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Solar Giá Rẻ 24h" />
    <meta property="og:image:type" content="image/png" />
    
    <!-- Facebook App ID (for Facebook Insights) -->
    <meta property="fb:app_id" content="YOUR_FACEBOOK_APP_ID" />
    
    <!-- Zalo / Vietnamese Social Networks -->
    <meta property="og:updated_time" content={new Date().toISOString()} />
    <meta name="zalo-app-id" content="YOUR_ZALO_APP_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@solargiare24h" />
    <meta name="twitter:creator" content="@solargiare24h" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={title} />
    
    <!-- Pinterest -->
    <meta name="pinterest-rich-pin" content="true" />
    <meta property="og:image" content={ogImageURL.href} />
    
    <!-- LinkedIn -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    
    <!-- WhatsApp -->
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/logo-favicon.svg?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=2" />

    <!-- Fonts - Optimized for Mobile -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load only necessary weights to reduce bundle size -->
    <link 
      href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,400;8..144,500;8..144,600;8..144,700&display=swap" 
      rel="stylesheet" 
      media="print" 
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,400;8..144,500;8..144,600;8..144,700&display=swap" rel="stylesheet" />
    </noscript>

    <!-- Preload hero image (LCP element) - WebP format for performance -->
    <link rel="preload" as="image" href="/hero-bg-1920.webp" imagesrcset="/hero-bg-768.webp 768w, /hero-bg-1280.webp 1280w, /hero-bg-1920.webp 1920w" />

    <!-- Google Analytics 4 - Replace G-XXXXXXXXXX with your actual Measurement ID -->
    <!-- Setup: https://analytics.google.com -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX', {
        'send_page_view': true,
        'custom_map': {
          'dimension1': 'user_type',
          'dimension2': 'page_category'
        }
      });
      
      // Track phone clicks
      function trackPhoneClick() {
        gtag('event', 'phone_click', {
          'event_category': 'contact',
          'event_label': 'phone_number',
          'value': 1
        });
      }
      
      // Track form submissions
      function trackFormSubmit(formName) {
        gtag('event', 'form_submit', {
          'event_category': 'lead',
          'event_label': formName,
          'value': 1
        });
      }
    </script>

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {breadcrumbs && breadcrumbs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbs.map((item, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": item.name,
          "item": item.url
        }))
      })} />
    )}

    <!-- Google Analytics - Deferred for Mobile Performance -->
    <script 
      async 
      src="https://www.googletagmanager.com/gtag/js?id=G-2VLQ1GQBQL"
      onload="window.gtagLoaded=true"
    ></script>
    <script is:inline>
      // Defer GA initialization until after page load on mobile
      function initGA() {
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-2VLQ1GQBQL', {
          'send_page_view': false, // Manual control
          'transport_type': 'beacon' // Better for mobile
        });
        gtag('event', 'page_view');
      }
      
      // Initialize after page load to not block rendering
      if (document.readyState === 'complete') {
        setTimeout(initGA, 100);
      } else {
        window.addEventListener('load', function() {
          setTimeout(initGA, 100);
        });
      }
    </script>

    <!-- Service Worker Registration - Mobile Caching -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then((registration) => {
              console.log('[SW] Registered:', registration.scope);
            })
            .catch((error) => {
              console.log('[SW] Registration failed:', error);
            });
        });
      }
    </script>

    <!-- Theme color -->
    <meta name="theme-color" content="#f97316" />
    <meta name="author" content="Solar Giá Rẻ 24h" />
  </head>
  <body class="min-h-full">
    <slot />
    
    <!-- JSON-LD Structured Data: Breadcrumbs -->
    {breadcrumbs.length > 0 && (
      <script type="application/ld+json" define:vars={{breadcrumbs}}>
        {JSON.stringify({
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": breadcrumbs.map((item, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "name": item.name,
            "item": item.url
          }))
        })}
      </script>
    )}
  </body>
</html>

<style is:global>
  @import "../styles/globals.css";
</style>
