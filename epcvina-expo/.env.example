# App Environment Configuration
# Copy to .env and fill in your values

# Environment
NODE_ENV=development

# API URL
# Local Development
EXPO_PUBLIC_API_URL=https://app.epcvina.com/api/mobile

# Production
# Production uses the same epcvinaadmin gateway.

# App URL (for redirects, etc.)
# Local Development
EXPO_PUBLIC_APP_URL=http://localhost:8080

# Production
EXPO_PUBLIC_APP_URL=https://app.appejv.app

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_ERROR_TRACKING=false
