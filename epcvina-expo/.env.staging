# Staging Environment Configuration

# API URL - Staging
EXPO_PUBLIC_API_URL=https://app.epcvina.com/api/mobile

# App URL - Staging
EXPO_PUBLIC_APP_URL=https://staging-app.appejv.app

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_ERROR_TRACKING=true

# OAuth Configuration - Google (Staging)
GOOGLE_CLIENT_ID=your_staging_google_client_id_here
GOOGLE_IOS_CLIENT_ID=your_staging_google_ios_client_id_here
GOOGLE_ANDROID_CLIENT_ID=your_staging_google_android_client_id_here
GOOGLE_REDIRECT_URI=appejv://oauth/google/callback

# OAuth Configuration - Facebook (Staging)
FACEBOOK_APP_ID=your_staging_facebook_app_id_here
FACEBOOK_REDIRECT_URI=appejv://oauth/facebook/callback

# OAuth Configuration - Zalo (Staging)
ZALO_APP_ID=your_staging_zalo_app_id_here
ZALO_APP_SECRET=your_staging_zalo_app_secret_here
ZALO_REDIRECT_URI=appejv://oauth/zalo/callback
