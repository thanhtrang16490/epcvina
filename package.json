{
  "name": "epcvina",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EPCVINA - Dual website deployment (epcvinahome + epcvinasolar)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:home && npm run build:solar && npm run merge",
    "build:home": "cd epcvinahome && npm ci && npm run build",
    "build:solar": "cd epcvinasolar && npm ci && npm run build",
    "merge": "cp -r epcvinahome/dist/* epcvinasolar/dist/client/ 2>/dev/null || true",
    "start": "cd epcvinasolar && node ./dist/server/entry.mjs",
    "dev": "echo 'Run: npm run dev:home or npm run dev:solar'",
    "dev:home": "cd epcvinahome && npm run dev",
    "dev:solar": "cd epcvinasolar && npm run dev"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3"
  },
  "devDependencies": {
    "lighthouse": "^12.8.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
