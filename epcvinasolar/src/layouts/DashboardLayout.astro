---
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{name: string, url: string}>;
}

const {
  title = 'EPC Solar - Điện Mặt Trời Trọn Gói | Lắp Đặt Tại Hà Nội',
  description = 'EPC Solar - Chuyên lắp đặt hệ thống điện mặt trời trọn gói cho hộ gia đình và doanh nghiệp. Giải pháp On-Grid & Hybrid tiết kiệm điện đến 90%. Hotline: 0988 446 113.',
  keywords = 'điện mặt trời, lắp đặt điện mặt trời, solar panel, EPC Solar, điện mặt trời Hà Nội, hệ thống điện mặt trời, combo điện mặt trời, on-grid, hybrid',
  ogImage = '/opengraph-epcvina-medium.jpeg',
  noindex = false,
  breadcrumbs = [],
} = Astro.props;

const gtmId = import.meta.env.PUBLIC_GTM_ID;
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const cleanMeta = (value: string) => value.replace(/\s+/g, ' ').trim();
const truncateMeta = (value: string, maxLength: number) => {
  const cleanValue = cleanMeta(value);
  if (cleanValue.length <= maxLength) return cleanValue;
  const shortened = cleanValue.slice(0, maxLength + 1);
  const lastSpace = shortened.lastIndexOf(' ');
  return `${shortened.slice(0, lastSpace > maxLength * 0.7 ? lastSpace : maxLength).trim()}…`;
};
const seoTitle = truncateMeta(title, 58);
const seoDescription = truncateMeta(description, 150);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "EPC Solar - Công ty Cổ phần Xây lắp EPC Việt Nam",
  "description": seoDescription,
  "url": "https://epcvina.com",
  "logo": "https://epcvina.com/favicon.svg",
  "image": "https://epcvina.com/favicon.svg",
  "telephone": "+84988446113",
  "email": "epcvinasolar@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Phòng 315, Khu thương mại – Chung cư Học viện Quốc phòng, Đường Xuân Tảo",
    "addressLocality": "Tây Hồ",
    "addressRegion": "Hà Nội",
    "addressCountry": "VN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "21.0485",
    "longitude": "105.7951"
  },
  "openingHours": "Mo-Sa 08:00-17:30",
  "priceRange": "$$",
  "sameAs": [
    "https://www.facebook.com/epcvinacom/",
    "https://www.youtube.com/@EPCVINA",
    "https://www.linkedin.com/company/epcvina",
    "https://zalo.me/epcvina"
  ],
  "serviceArea": {
    "@type": "GeoCircle",
    "geoMidpoint": {
      "@type": "GeoCoordinates",
      "latitude": "21.0285",
      "longitude": "105.8542"
    },
    "geoRadius": "100000"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hệ thống điện mặt trời",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Lắp đặt điện mặt trời On-Grid"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Lắp đặt điện mặt trời Hybrid"
        }
      }
    ]
  }
};
---

<!DOCTYPE html>
<html lang="vi" class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />


    <!-- SEO Meta -->
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      if (window.location.hostname === 'www.epcvina.com') {
        window.location.replace(`https://epcvina.com${window.location.pathname}${window.location.search}${window.location.hash}`);
      }
    </script>

    <!-- Open Graph / Facebook / Zalo -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seoTitle} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="EPCVINA Solar" />
    <meta property="og:image:type" content={ogImage.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    
    <!-- Zalo / Vietnamese Social Networks -->
    <meta property="og:updated_time" content={new Date().toISOString()} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@epcvina" />
    <meta name="twitter:creator" content="@epcvina" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={seoTitle} />
    
    <!-- Pinterest Rich Pin -->
    <meta name="pinterest-rich-pin" content="true" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/logo-favicon.svg?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#f97316" />

    <!-- PWA: Web App Manifest -->
    <link rel="manifest" href="/manifest.json" />

    <!-- PWA: iOS / Apple Mobile -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="EPCVINA Solar" />

    <!-- PWA: Android / General -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="EPCVINA Solar" />

    <!-- Fonts - Match calculator reference -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,400..900&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,400..900&display=swap" rel="stylesheet" /></noscript>

    <!-- Preload hero image (LCP element) - WebP format for performance -->
    {Astro.url.pathname === '/' && (
      <link rel="preload" as="image" href="/hero-bg-1920.webp" imagesrcset="/hero-bg-768.webp 768w, /hero-bg-1280.webp 1280w, /hero-bg-1920.webp 1920w" imagesizes="100vw" fetchpriority="high" />
    )}

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Persist ad attribution across internal navigation before a lead is submitted -->
    <script is:inline>
      (function () {
        try {
          var keys = ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid','gbraid','wbraid','fbclid'];
          var params = new URLSearchParams(window.location.search);
          var touch = {};
          keys.forEach(function (key) { var value = params.get(key); if (value) touch[key] = value; });
          if (!Object.keys(touch).length) return;
          touch.landing_page = window.location.href;
          touch.referrer = document.referrer || undefined;
          touch.captured_at = new Date().toISOString();
          var storageKey = 'epcvina_attribution_v1';
          var stored = {};
          try { stored = JSON.parse(window.localStorage.getItem(storageKey) || '{}'); } catch (_) {}
          if (!stored.first_touch) stored.first_touch = touch;
          stored.last_touch = touch;
          window.localStorage.setItem(storageKey, JSON.stringify(stored));
        } catch (_) {}
      })();
    </script>

    <!-- Google tag (Google Analytics + Google Ads) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18369898149"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){window.dataLayer.push(arguments);};
      window.gtag('js', new Date());
      window.gtag('config', 'G-2VLQ1GQBQL');
      window.gtag('config', 'AW-18369898149');

      window.epcConversionLabels = window.epcConversionLabels || {
        lead_submit: 'epcvina_lead_submit',
        hotline_click: 'epcvina_hotline_click',
        zalo_click: 'epcvina_zalo_click',
      };
      window.epcTrackConversion = window.epcTrackConversion || function(eventName, params) {
        var defaultLabel = window.epcConversionLabels[eventName] || eventName;
        window.gtag('event', eventName, Object.assign({
          event_category: 'conversion',
          conversion_label: defaultLabel
        }, params || {}));
      };

      // Record every website hotline/Zalo click against its dedicated
      // Google Ads conversion action. Delegation covers static Astro links
      // as well as links rendered later by hydrated React components.
      var adsClickDestinations = {
        hotline_click: 'AW-18369898149/LJZKCK7ut9wcEKXNubdE',
        zalo_click: 'AW-18369898149/90_ECKvut9wcEKXNubdE',
      };

      document.addEventListener('click', function (event) {
        if (event.defaultPrevented || event.button !== 0) return;

        var target = event.target;
        if (!(target instanceof Element)) return;

        var link = target.closest('a[href]');
        if (!link) return;

        var href = link.getAttribute('href') || '';
        var eventName = href.indexOf('tel:') === 0
          ? 'hotline_click'
          : href.indexOf('zalo.me/') !== -1
            ? 'zalo_click'
            : '';
        if (!eventName) return;

        var destination = adsClickDestinations[eventName];
        var opensNewContext = link.target === '_blank' || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;
        var navigated = false;
        var continueNavigation = function () {
          if (navigated || opensNewContext) return;
          navigated = true;
          window.location.href = link.href;
        };

        if (!opensNewContext) event.preventDefault();

        window.gtag('event', 'conversion', {
          send_to: destination,
          value: 1.0,
          currency: 'VND',
          event_callback: continueNavigation,
          event_timeout: 800,
        });

        // Preserve navigation if an ad blocker or network issue prevents the
        // Google callback from running.
        if (!opensNewContext) window.setTimeout(continueNavigation, 850);
      }, true);

    </script>

    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){
          w[l]=w[l]||[];
          w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],
              j=d.createElement(s),
              dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;
          j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}

    {metaPixelId && (
      <script is:inline define:vars={{ metaPixelId }}>
        !function(f,b,e,v,n,t,s){
          if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)
        }(window, document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', metaPixelId);
        fbq('track', 'PageView');
      </script>
    )}

    <!-- Service Worker Registration - PWA Caching -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then((registration) => {
              console.log('[SW] Registered:', registration.scope);
              // Check for updates periodically
              setInterval(() => registration.update(), 60 * 60 * 1000);
            })
            .catch((error) => {
              console.log('[SW] Registration failed:', error);
            });
        });

        // Notify user when new content is available
        let refreshing = false;
        navigator.serviceWorker.addEventListener('updatefound', () => {
          const newWorker = navigator.serviceWorker.controller;
          if (newWorker) {
            newWorker.addEventListener('statechange', () => {
              if (newWorker.state === 'activated' && !refreshing) {
                refreshing = true;
                window.location.reload();
              }
            });
          }
        });
      }
    </script>

    <!-- Theme color -->
    <meta name="theme-color" content="#f97316" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="author" content="EPC Solar - Công ty CP Xây lắp EPC Việt Nam" />
  </head>
  <body class="min-h-full">
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    <slot />
    
    <!-- JSON-LD Structured Data: Breadcrumbs -->
    {breadcrumbs.length > 0 && (
      <script type="application/ld+json" define:vars={{breadcrumbs}}>
        {JSON.stringify({
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": breadcrumbs.map((item, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "name": item.name,
            "item": item.url
          }))
        })}
      </script>
    )}
  </body>
</html>

<style is:global>
  @import "../styles/globals.css";
</style>
