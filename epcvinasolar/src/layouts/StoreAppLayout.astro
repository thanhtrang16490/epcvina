---
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  variant: 'app-store' | 'chplay';
  noindex?: boolean;
}

const { title, description, variant, noindex = true } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const isAppStore = variant === 'app-store';
const brand = isAppStore
  ? { name: 'App Store', mark: '', accent: '#111111', tint: '#f5f5f7', heroBg: '#ffffff' }
  : { name: 'CH Play', mark: '▶', accent: '#34A853', tint: '#f8f9fa', heroBg: '#ffffff' };
---

<!DOCTYPE html>
<html lang="vi" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body class="min-h-screen text-slate-900 antialiased" style={`background:${brand.tint};`}>
    <div class={`store-app store-app--${variant}`}>
      <div class="store-app__wash" />
      <header class="store-app__header">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
          <a href="/" class="flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900">
            <span
              class="store-app__mark inline-flex h-9 w-9 items-center justify-center rounded-full text-white"
              style={`background:${brand.accent}`}
            >
              {brand.mark}
            </span>
            <span>EPCVINA</span>
          </a>
          <nav class="flex items-center gap-2 text-sm">
            <a href="/ung-dung/app-store" class={`rounded-full px-4 py-2 font-medium transition-colors ${isAppStore ? 'bg-black text-white' : 'text-slate-600 hover:bg-black/5'}`}>
              App Store
            </a>
            <a href="/ung-dung/chplay" class={`rounded-full px-4 py-2 font-medium transition-colors ${!isAppStore ? 'bg-[#34A853] text-white' : 'text-slate-600 hover:bg-black/5'}`}>
              CH Play
            </a>
          </nav>
        </div>
      </header>

      <main class="store-app__main">
        <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8 lg:pt-8">
          <div class="store-app__banner flex flex-wrap items-center justify-between gap-3 px-4 py-3">
            <div>
              <p class="text-[11px] uppercase tracking-[0.24em] text-slate-400 font-display">EPCVINA / ứng dụng</p>
              <p class="mt-1 text-sm font-medium text-slate-900 font-display">{title}</p>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-500">
              <span class={`store-app__pill rounded-full px-3 py-1 font-medium ${isAppStore ? 'bg-black text-white' : 'bg-[#34A853] text-white'}`}>{brand.name}</span>
              <span class="hidden sm:inline">Giữ người dùng ở trong hệ thống nội bộ</span>
            </div>
          </div>
        </div>
        <slot />
      </main>
    </div>

    <style>
      .store-app {
        min-height: 100vh;
        position: relative;
        overflow: hidden;
      }

      .store-app::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at top left, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.62) 34%, transparent 72%),
          radial-gradient(circle at 100% 0%, rgba(255, 255, 255, 0.14), transparent 28%),
          linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(255, 255, 255, 0.34));
        pointer-events: none;
      }

      .store-app--app-store::before {
        background:
          radial-gradient(circle at top left, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.7) 34%, transparent 72%),
          radial-gradient(circle at 100% 0%, rgba(17, 17, 17, 0.08), transparent 30%),
          linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.38));
      }

      .store-app--chplay::before {
        background:
          radial-gradient(circle at top left, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.68) 34%, transparent 72%),
          radial-gradient(circle at 100% 0%, rgba(52, 168, 83, 0.14), transparent 30%),
          linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.38));
      }

      .store-app__wash {
        position: absolute;
        inset-x: 0;
        top: 0;
        height: 16rem;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.86), transparent);
        pointer-events: none;
      }

      .store-app__header {
        position: sticky;
        top: 0;
        z-index: 30;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(20px);
      }

      .store-app__main {
        position: relative;
      }

      .store-app__banner {
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 1.5rem;
        background: rgba(255, 255, 255, 0.75);
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.04);
        backdrop-filter: blur(16px);
      }

      .store-app__mark {
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.15);
      }

      .store-app__pill {
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
      }
    </style>
  </body>
</html>
