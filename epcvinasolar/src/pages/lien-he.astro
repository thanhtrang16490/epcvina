---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell.astro';
import ContactPage from '../components/pages/contact/ContactPage';
import { buildLocalBusinessSchema } from '../lib/schema';

const localBusinessSchema = buildLocalBusinessSchema({
  name: 'EPCVINA Solar',
  description: 'Văn phòng EPCVINA Solar cung cấp tư vấn, thiết kế và thi công điện mặt trời tại Hà Nội và toàn quốc.',
  url: 'https://epcvina.com/lien-he',
  telephone: '0988446113',
  email: 'epcvinasolar@gmail.com',
  streetAddress: 'Phòng 315, Khu thương mại – Chung cư Học viện Quốc phòng, Đường Xuân Tảo',
  addressLocality: 'Tây Hồ',
  addressRegion: 'Hà Nội',
  addressCountry: 'VN',
  latitude: 21.0500148,
  longitude: 105.7999521,
  openingHours: 'Mo-Sa 08:00-17:30',
  priceRange: '$$',
  sameAs: ['https://maps.app.goo.gl/QUxgHjPC4AUu3cPK9'],
});
---

<DashboardLayout
  title="Liên Hệ EPCVINA Solar"
  description="Liên hệ EPCVINA Solar để được tư vấn miễn phí lắp đặt điện mặt trời. Hotline: 0988 446 113. Đội ngũ kỹ sư tư vấn tận nơi, báo giá trong 24h."
  keywords="liên hệ EPCVINA, tư vấn điện mặt trời, báo giá solar, lắp đặt điện mặt trời, hotline EPCVINA"
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[{name: "Trang Chủ", url: "https://epcvina.com"}, {name: "Liên Hệ", url: "https://epcvina.com/lien-he"}]}
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <DashboardShell>
    <ContactPage client:idle />
  </DashboardShell>
</DashboardLayout>
