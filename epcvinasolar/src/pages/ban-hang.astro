---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell.astro';
import JoinSalesPage from '../components/pages/ban-hang/JoinSalesPage';

export const prerender = true;

const breadcrumbs = [
  { name: 'Trang chủ', url: 'https://epcvina.com' },
  { name: 'Bán hàng', url: 'https://epcvina.com/ban-hang' },
];
---

<DashboardLayout
  title="Bán Hàng Cùng EPCVINA Solar"
  description="Tham gia công tác bán hàng cùng EPCVINA Solar. EPCVINA hỗ trợ toàn bộ tài liệu, tư vấn kỹ thuật, giám sát cơ hội và phối hợp triển khai."
  keywords="cộng tác bán hàng điện mặt trời, bán hàng EPCVINA, hợp tác solar, cộng tác viên điện mặt trời"
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={breadcrumbs}
>
  <DashboardShell>
    <JoinSalesPage client:visible />
  </DashboardShell>
</DashboardLayout>
