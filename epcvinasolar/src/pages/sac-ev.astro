---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell';
import EVChargerPage from '../components/pages/ev-charger/EVChargerPage';
---

<DashboardLayout
  title="Trạm Sạc Xe Điện EV Charger - Tích Hợp Năng Lượng Mặt Trời | EPCVINA Solar"
  description="Lắp đặt trạm sạc xe điện EV Charger cho gia đình và doanh nghiệp. Tích hợp năng lượng mặt trời, tiết kiệm chi phí vận hành. Tương thích VF3, VF5, VF6."
  keywords="trạm sạc xe điện, EV charger, V-GREEN, sạc xe điện năng lượng mặt trời, wallbox, EPCVINA Solar"
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Sạc Xe Điện', url: 'https://epcvina.com/sac-ev' }
  ]}
>
  <DashboardShell client:load>
    <EVChargerPage client:idle />
  </DashboardShell>
</DashboardLayout>
