---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell';
import SolarCIPage from '../components/pages/solar-ci/SolarCIPage';
---

<DashboardLayout
  title="Solar Công Nghiệp | EPCVINA"
  description="Giải pháp điện mặt trời cho thương mại và công nghiệp. Công suất 100kWp - 5MWp, hoàn vốn 4-6 năm, tuổi thọ 30+ năm. EPCVINA - đối tác doanh nghiệp."
  keywords="điện mặt trời công nghiệp, solar C&I, điện mặt trời nhà xưởng, điện mặt trời KCN, tiết kiệm điện doanh nghiệp, EPCVINA"
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Solar Công Nghiệp', url: 'https://epcvina.com/solar-cong-nghiep' }
  ]}
>
  <DashboardShell client:load>
    <SolarCIPage client:idle pathname={Astro.url.pathname} />
  </DashboardShell>
</DashboardLayout>
