---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import HeaderBar from '../../components/home/layout/HeaderBar';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id.replace('.md', '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const projectSlug = project.id.replace('.md', '');

// Get related projects
const allProjects = await getCollection('projects');
const relatedProjects = allProjects
  .filter(p => 
    p.id !== project.id && 
    (p.data.system_type === project.data.system_type || 
     p.data.capacity === project.data.capacity)
  )
  .slice(0, 3);

const tagColors: Record<string, string> = {
  'Hybrid có lưu trữ': 'bg-blue-100 text-blue-700',
  'Hòa Lưới bám tải': 'bg-sky-100 text-sky-700',
  'On Grid / Hybrid': 'bg-emerald-100 text-emerald-700',
};

const testimonial = project.data.testimonial;

// Gallery pagination
const gallery = project.data.gallery || [];
const initialCount = 4;
const expandedCount = 8;
const hasMore = gallery.length > initialCount;
const hasMoreAfterExpand = gallery.length > expandedCount;

// Fetch product images for equipment items
const allProducts = await getCollection('products');
const equipmentWithImages = project.data.equipment_items?.map(item => {
  if (item.product_slug) {
    const productSlug = item.product_slug; // e.g., "panel/tam-pin-mat-troi-longi-550w-hi-mo-5"
    // Try to match by finding product where category + slug matches
    const product = allProducts.find(p => {
      // Extract slug from product id (remove .md)
      const productId = p.id.replace('.md', '');
      // Match: "panel/tam-pin-mat-troi-longi-550w-hi-mo-5" includes "tam-pin-mat-troi-longi-550w-hi-mo-5"
      return productId === productSlug || productSlug.includes(productId) || productId.includes(productSlug.split('/').pop() || '');
    });
    return {
      ...item,
      product_image: product?.data.main_image,
    };
  }
  return { ...item, product_image: null };
});

// Extract performance data
const performance = project.data.performance;
const faq = project.data.faq || [];
---

<DashboardLayout
  title={`${project.data.title} | EPCVINA Solar`}
  description={project.data.description}
  keywords={`dự án điện mặt trời, ${project.data.system_type}, ${project.data.location}, ${project.data.capacity}`}
  breadcrumbs={[
    {name: "Trang Chủ", url: "/"}, 
    {name: "Dự Án", url: "/du-an"},
    {name: project.data.title, url: ""}
  ]}
  ogImage={project.data.image}
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" define:vars={{project}}>\n    JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": project.data.title,
      "description": project.data.description,
      "image": project.data.image,
      "author": {
        "@type": "Organization",
        "name": "EPCVINA Solar"
      },
      "publisher": {
        "@type": "Organization",
        "name": "EPCVINA Solar",
        "logo": {
          "@type": "ImageObject",
          "url": "https://epcvina.com/logo-epcvina.svg"
        }
      },
      "datePublished": project.data.completion_date,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://epcvina.com/du-an/${project.id.replace('.md', '')}`
      }
    })
  </script>
  <DashboardShell client:load>
    <div class="min-h-screen bg-white">
      <HeaderBar client:load />
    
    <!-- Hero Section -->
    <section class="bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16">
        <!-- Back Link -->
        <a 
          href="/du-an" 
          class="inline-flex items-center gap-2 text-emerald-600 hover:text-emerald-700 mb-6 transition-colors group"
        >
          <span class="transform group-hover:-translate-x-1 transition-transform">←</span> 
          <span class="text-sm font-medium">Quay lại danh sách dự án</span>
        </a>

        <!-- Hero: Image + Info Grid -->
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
          <!-- Left: Project Image -->
          <div 
            data-gallery="project"
            class="relative rounded-2xl overflow-hidden shadow-2xl aspect-square cursor-pointer group"
          >
            <img 
              src={project.data.image} 
              alt={project.data.title}
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="eager"
              fetchpriority="high"
            />
            <!-- Zoom hint -->
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
              <div class="opacity-0 group-hover:opacity-100 transition-opacity bg-white/90 rounded-full p-3 shadow-lg">
                <svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Right: Project Info -->
          <div class="flex flex-col">
            <!-- Title -->
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 mb-4 leading-tight">
              {project.data.title}
            </h1>
            
            <!-- Description -->
            <p class="text-base sm:text-lg text-gray-600 mb-8 leading-relaxed">
              {project.data.description}
            </p>

            <!-- Info Grid -->
            <div class="grid grid-cols-2 gap-4 mb-8">
              <!-- Capacity -->
              <div class="bg-emerald-50 rounded-xl p-4 border border-emerald-100">
                <div class="text-xs uppercase tracking-wider text-emerald-600 font-semibold mb-1">Công suất</div>
                <div class="text-xl sm:text-2xl font-bold text-gray-900">{project.data.capacity}</div>
              </div>
              
              <!-- Location -->
              <div class="bg-blue-50 rounded-xl p-4 border border-blue-100">
                <div class="text-xs uppercase tracking-wider text-blue-600 font-semibold mb-1">Vị trí</div>
                <div class="text-lg sm:text-xl font-bold text-gray-900">{project.data.location.split(' - ').pop()}</div>
              </div>
              
              <!-- Completion Date -->
              <div class="bg-amber-50 rounded-xl p-4 border border-amber-100">
                <div class="text-xs uppercase tracking-wider text-amber-600 font-semibold mb-1">Hoàn thành</div>
                <div class="text-lg sm:text-xl font-bold text-gray-900">{project.data.completion_date}</div>
              </div>
              
              <!-- Customer -->
              <div class="bg-purple-50 rounded-xl p-4 border border-purple-100">
                <div class="text-xs uppercase tracking-wider text-purple-600 font-semibold mb-1">Khách hàng</div>
                <div class="text-lg sm:text-xl font-bold text-gray-900">{project.data.customer}</div>
              </div>
            </div>
            
            <!-- CTA Button -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
              <a 
                href="/calculator"
                class="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-500 hover:to-emerald-400 text-white font-semibold px-8 py-3.5 rounded-lg transition-all shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/50 hover:-translate-y-0.5"
              >
                <span class="inline-block w-2 h-2 bg-white rounded-full"></span>
                <span>Tư vấn miễn phí</span>
              </a>
              <a 
                href="tel:0988446113"
                class="inline-flex items-center gap-2 text-emerald-600 hover:text-emerald-700 font-semibold text-sm"
              >
                <span>📞</span>
                <span>0988 446 113</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Project Overview Section -->
    <section class="py-12 sm:py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">Tổng quan dự án</h2>
          <p class="text-gray-600 text-base">Thông tin chi tiết về giải pháp và thiết bị sử dụng</p>
        </div>
        
        <div class="grid lg:grid-cols-3 gap-8">
          <!-- Main Content - Left 2/3 -->
          <div class="lg:col-span-2 space-y-8">
            <!-- Description -->
            <div class="bg-gray-50 rounded-2xl p-6 sm:p-8 border border-gray-100">
              <h3 class="text-xl font-bold text-gray-900 mb-4">Mô tả dự án</h3>
              <p class="text-gray-700 leading-relaxed">{project.data.description}</p>
            </div>
            
            <!-- Markdown Content -->
            <article class="prose prose-lg max-w-none">
              <Content />
            </article>
            
            <!-- Special Notes -->
            {project.data.special_notes && (
              <div class="p-6 bg-amber-50 border-l-4 border-amber-500 rounded-r-lg">
                <div class="flex items-start gap-3">
                  <div class="text-2xl flex-shrink-0 mt-1"></div>
                  <div>
                    <h3 class="text-lg font-bold text-amber-900 mb-2">Đặc điểm công trình</h3>
                    <p class="text-amber-800">{project.data.special_notes}</p>
                  </div>
                </div>
              </div>
            )}
          </div>
          
          <!-- Sidebar - Right 1/3 -->
          <aside class="space-y-6">
            <!-- Equipment Card -->
            <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-2xl p-6 border border-emerald-100">
              <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                <span>Thiết bị chính</span>
              </h3>
                        
              {equipmentWithImages && equipmentWithImages.length > 0 ? (
                <div class="space-y-3">
                  {equipmentWithImages.map((item) => (
                    <a 
                      href={item.product_slug ? `/thiet-bi/${item.product_slug}` : '#'}
                      class={`bg-white rounded-lg p-3 border border-emerald-200 hover:border-emerald-400 transition-all group flex items-center gap-3 ${item.product_slug ? 'cursor-pointer hover:shadow-md' : 'cursor-default'}`}
                    >
                      <!-- Product Image -->
                      {item.product_image ? (
                        <div class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden bg-gray-100">
                          <img 
                            src={item.product_image}
                            alt={item.value}
                            loading="lazy"
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                          />
                        </div>
                      ) : (
                        <div class="flex-shrink-0 w-16 h-16 rounded-lg bg-gradient-to-br from-emerald-100 to-teal-100 flex items-center justify-center text-2xl">
                          
                        </div>
                      )}
                      
                      <!-- Equipment Info -->
                      <div class="flex-1 min-w-0">
                        <div class="text-xs text-gray-500 mb-1">{item.label}</div>
                        <div class="text-sm font-semibold text-gray-900 truncate">{item.value}</div>
                      </div>
                      
                      <!-- Arrow Icon -->
                      {item.product_slug && (
                        <div class="flex-shrink-0 text-emerald-600 opacity-0 group-hover:opacity-100 transition-opacity">
                          →
                        </div>
                      )}
                    </a>
                  ))}
                </div>
              ) : (
                <div class="space-y-3">
                  {project.data.equipment.split('\n').map((item) => {
                    const parts = item.split(':');
                    const label = parts[0]?.trim();
                    const value = parts.slice(1).join(':').trim();
                    return (
                      <div class="bg-white rounded-lg p-3 border border-emerald-200">
                        <div class="text-xs text-gray-500 mb-1">{label}</div>
                        <div class="text-sm font-semibold text-gray-900">{value}</div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
            
            <!-- Project Info Card -->
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
              <h3 class="text-lg font-bold text-gray-900 mb-4">Thông tin</h3>
              <div class="space-y-3">
                <div class="flex justify-between items-center py-2 border-b border-gray-200">
                  <span class="text-sm text-gray-600">Loại hệ thống</span>
                  <span class="text-sm font-semibold text-gray-900">{project.data.system_type}</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-200">
                  <span class="text-sm text-gray-600">Công suất</span>
                  <span class="text-sm font-semibold text-emerald-600">{project.data.capacity}</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-200">
                  <span class="text-sm text-gray-600">Vị trí</span>
                  <span class="text-sm font-semibold text-gray-900">{project.data.location}</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-200">
                  <span class="text-sm text-gray-600">Hoàn thành</span>
                  <span class="text-sm font-semibold text-gray-900">{project.data.completion_date}</span>
                </div>
                <div class="flex justify-between items-center py-2">
                  <span class="text-sm text-gray-600">Khách hàng</span>
                  <span class="text-sm font-semibold text-gray-900">{project.data.customer}</span>
                </div>
              </div>
            </div>
            
            <!-- CTA Card -->
            <div class="bg-gradient-to-br from-emerald-600 to-emerald-500 rounded-2xl p-6 text-white">
              <h3 class="text-lg font-bold mb-3">Bạn quan tâm?</h3>
              <p class="text-emerald-100 mb-4 text-sm leading-relaxed">
                Liên hệ ngay để được tư vấn giải pháp tương tự cho công trình của bạn
              </p>
              <a 
                href="/calculator"
                class="flex items-center justify-center gap-2 bg-white text-emerald-600 font-semibold px-6 py-3 rounded-lg hover:bg-emerald-50 transition-colors w-full"
              >
                Tư vấn miễn phí
              </a>
              <div class="mt-3 text-center">
                <a href="tel:0988446113" class="text-sm text-emerald-100 hover:text-white transition-colors">
                  Hoặc gọi: 0988 446 113
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
    
    <!-- Gallery Section -->
    {project.data.gallery && project.data.gallery.length > 0 && (
      <section class="py-12 sm:py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-10">
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">📸 Thư viện ảnh dự án</h2>
            <p class="text-gray-600 text-base">Hình ảnh thực tế quá trình thi công và hoàn thiện</p>
          </div>
          
          <!-- Gallery Grid -->
          <div id="gallery-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {gallery.slice(0, initialCount).map((img, index) => (
              <div class="gallery-item group relative aspect-square overflow-hidden rounded-xl bg-gray-200 cursor-pointer hover:shadow-lg transition-shadow" data-gallery="project">
                <img 
                  src={img}
                  alt={`${project.data.title} - Ảnh ${index + 1}`}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                  <div class="text-white">
                    <div class="text-sm font-semibold">Ảnh {index + 1}</div>
                    <div class="text-xs text-gray-300">Nhấn để phóng to</div>
                  </div>
                </div>
              </div>
            ))}
            
            {hasMore && gallery.slice(initialCount, expandedCount).map((img, index) => (
              <div class="gallery-item hidden group relative aspect-square overflow-hidden rounded-xl bg-gray-200 cursor-pointer hover:shadow-lg transition-shadow" data-gallery="project" style="display: none;">
                <img 
                  src={img}
                  alt={`${project.data.title} - Ảnh ${initialCount + index + 1}`}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                  <div class="text-white">
                    <div class="text-sm font-semibold">Ảnh {initialCount + index + 1}</div>
                    <div class="text-xs text-gray-300">Nhấn để phóng to</div>
                  </div>
                </div>
              </div>
            ))}
            
            {hasMoreAfterExpand && gallery.slice(expandedCount).map((img, index) => (
              <div class="gallery-item hidden group relative aspect-square overflow-hidden rounded-xl bg-gray-200 cursor-pointer hover:shadow-lg transition-shadow" data-gallery="project" data-extra="true" style="display: none;">
                <img 
                  src={img}
                  alt={`${project.data.title} - Ảnh ${expandedCount + index + 1}`}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                  <div class="text-white">
                    <div class="text-sm font-semibold">Ảnh {expandedCount + index + 1}</div>
                    <div class="text-xs text-gray-300">Nhấn để phóng to</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          
          <!-- Show More Button -->
          {hasMore && (
            <div class="text-center mt-6">
              <button 
                id="show-more-btn"
                class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl transition-colors shadow-md hover:shadow-lg"
              >
                <span id="show-more-text">Xem thêm {gallery.length - initialCount} ảnh</span>
                <span class="text-xl">↓</span>
              </button>
            </div>
          )}
          
          <p class="text-center text-sm text-gray-500 mt-4">Nhấn vào ảnh để xem chi tiết</p>
        </div>
      </section>
    )}
    
    <!-- Performance & ROI Section -->
    {performance && (
      <section class="py-12 sm:py-16 bg-gradient-to-br from-blue-50 to-indigo-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-10">
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">Hiệu suất & ROI dự kiến</h2>
            <p class="text-gray-600 text-base">Ước tính dựa trên công suất {project.data.capacity} và vị trí lắp đặt</p>
          </div>
          
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-8">
            {performance.annual_production_kwh && (
              <div class="bg-white rounded-2xl p-6 border border-blue-100 hover:shadow-xl transition-all hover:-translate-y-1">
                <div class="text-xs uppercase tracking-wider text-emerald-600 font-semibold mb-1">Sản lượng</div>
                <div class="text-2xl sm:text-3xl font-bold text-blue-600 mb-1">
                  {performance.annual_production_kwh.toLocaleString('vi-VN')}
                </div>
                <div class="text-sm text-gray-600">kWh/năm</div>
                <div class="text-xs text-gray-500 mt-2">Sản lượng điện tạo ra</div>
              </div>
            )}
            
            {performance.annual_savings_vnd && (
              <div class="bg-white rounded-2xl p-6 border border-emerald-100 hover:shadow-xl transition-all hover:-translate-y-1">
                <div class="text-xs uppercase tracking-wider text-emerald-600 font-semibold mb-1">Tài chính</div>
                <div class="text-xl sm:text-2xl font-bold text-emerald-600 mb-1">
                  {(performance.annual_savings_vnd / 1000000).toFixed(0)} triệu
                </div>
                <div class="text-sm text-gray-600">VNĐ/năm</div>
                <div class="text-xs text-gray-500 mt-2">Tiết kiệm dự kiến</div>
              </div>
            )}
            
            {performance.co2_reduction_kg && (
              <div class="bg-white rounded-2xl p-6 border border-green-100 hover:shadow-xl transition-all hover:-translate-y-1">
                <div class="text-4xl mb-3">🌱</div>
                <div class="text-2xl sm:text-3xl font-bold text-green-600 mb-1">
                  {(performance.co2_reduction_kg / 1000).toFixed(1)} tấn
                </div>
                <div class="text-sm text-gray-600">CO2/năm</div>
                <div class="text-xs text-gray-500 mt-2">Giảm phát thải</div>
              </div>
            )}
            
            {performance.self_sufficiency_percent && (
              <div class="bg-white rounded-2xl p-6 border border-purple-100 hover:shadow-xl transition-all hover:-translate-y-1">
                <div class="text-xs uppercase tracking-wider text-emerald-600 font-semibold mb-1">Lưu trữ</div>
                <div class="text-2xl sm:text-3xl font-bold text-purple-600 mb-1">
                  {performance.self_sufficiency_percent}%
                </div>
                <div class="text-sm text-gray-600">Tự chủ điện</div>
                <div class="text-xs text-gray-500 mt-2">Tỷ lệ tự cung cấp</div>
              </div>
            )}
          </div>
          
          {performance.payback_years && (
            <div class="bg-gradient-to-r from-emerald-600 to-teal-600 rounded-2xl p-6 sm:p-8 text-white shadow-xl">
              <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6">
                <div class="text-5xl sm:text-6xl">📈</div>
                <div class="flex-1 text-center sm:text-left">
                  <div class="text-lg sm:text-xl font-semibold mb-2">Thời gian hoàn vốn dự kiến</div>
                  <div class="text-4xl sm:text-5xl font-bold mb-2">{performance.payback_years} năm</div>
                  <div class="text-sm text-emerald-100">Hệ thống hoạt động 25-30 năm, lợi ích dài hạn rất lớn</div>
                </div>
                <div class="text-6xl sm:text-7xl font-bold opacity-20">{performance.payback_years}yr</div>
              </div>
            </div>
          )}
          
          <p class="text-center text-xs text-gray-500 mt-6">
            * Số liệu ước tính dựa trên điều kiện thực tế, có thể thay đổi tùy theo thời tiết và mức tiêu thụ
          </p>
        </div>
      </section>
    )}
    
    <!-- Benefits Section -->
    <section class="py-12 sm:py-16 bg-gradient-to-br from-emerald-50 to-teal-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
