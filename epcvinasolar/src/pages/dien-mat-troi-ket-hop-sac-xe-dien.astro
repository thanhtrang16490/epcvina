---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import KetHopSacXeLandingPage from '../components/pages/kethop/KetHopSacXeLandingPage';

export const prerender = true;

const seoTitle = 'Điện Mặt Trời Kết Hợp Sạc Xe Điện 2026 | EPCVINA Solar';
const seoDescription = 'Giải pháp điện mặt trời kết hợp trạm sạc xe điện. Giảm 70% chi phí sạc, xe chạy bằng năng lượng sạch. Tư vấn miễn phí: 0988 446 113';
const seoKeywords = 'điện mặt trời kết hợp sạc xe, solar car charger, sạc xe điện bằng năng lượng mặt trời, EPCVINA';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Có thể kết hợp điện mặt trời với sạc xe không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Có. Kết hợp giúp giảm 50-70% chi phí sạc. Xe chạy hoàn toàn bằng năng lượng sạch."
      }
    },
    {
      "@type": "Question",
      "name": "Chi phí hệ kết hợp bao nhiêu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Từ 80-200 triệu tùy cấu hình. Hệ 5kWp + trạm sạc 7kW từ 80 triệu."
      }
    }
  ]
};
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Điện Mặt Trời Kết Hợp Sạc Xe', url: 'https://epcvina.com/dien-mat-troi-ket-hop-sac-xe-dien' }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <KetHopSacXeLandingPage client:visible />
</DashboardLayout>
