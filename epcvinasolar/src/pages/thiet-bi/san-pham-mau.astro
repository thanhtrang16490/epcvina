---
import EquipmentLayout from '../../layouts/EquipmentLayout.astro';
import ProductDetailPreview from '../../components/pages/product-detail/ProductDetailPreview';
import { localProducts } from '../../data/products';

export const prerender = true;

const sampleProduct =
  localProducts.find((item) => item.slug === 'tam-pin-mat-troi-aiko-650w-mat-kinh-stellar-2n-66-202') ||
  localProducts[0];

const sampleImages = [
  sampleProduct.main_image,
  '/images/products/tam-pin-mat-troi-aiko-650w-mat-kinh-stellar-2n-66-202/tam-pin-mat-troi-aiko-650w-mat-kinh-stellar-2n-66-202-1.png',
  '/images/products/tam-pin-mat-troi-aiko-650w-mat-kinh-stellar-2n-66-202/tam-pin-mat-troi-aiko-650w-mat-kinh-stellar-2n-66-202-2.png',
  '/images/products/tam-pin-mat-troi-aiko-650w-mat-kinh-stellar-2n-66-202/tam-pin-mat-troi-aiko-650w-mat-kinh-stellar-2n-66-202-3.png',
].filter(Boolean);
---

<EquipmentLayout
  title="San pham mau | EPCVINA Solar"
  description="Trang mẫu giao diện chi tiết sản phẩm kiểu marketplace để review trước khi áp dụng cho các PDP thật."
  ogImage="/hero-bg-1920.webp"
>
  <ProductDetailPreview client:load product={sampleProduct} images={sampleImages} />
</EquipmentLayout>
