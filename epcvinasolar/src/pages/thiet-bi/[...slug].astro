---
import EquipmentLayout from '../../layouts/EquipmentLayout.astro';
import ProductDetail from '../../components/pages/product-detail/ProductDetail';
import { getCollection } from 'astro:content';
import { getOptimizedProductImage } from '../../lib/optimized-product-images';

// Generate static paths for all products
export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.flatMap((product) => {
    const productId = product.id.replace('.md', '');
    const categorySlug = product.data.category || 'thiet-bi';

    return [
      {
        params: { slug: `${categorySlug}/${productId}` },
        props: { product },
      },
      {
        params: { slug: productId },
        props: { product },
      },
    ];
  });
}

const { product } = Astro.props;

if (!product) {
  return Astro.redirect('/thiet-bi');
}

// Fetch related projects that use this product
const allProjects = await getCollection('projects');
const productId = product.id.replace('.md', '');
const productCategory = product.data.category;
const relatedProjects = allProjects
  .filter(project => {
    // Check if project equipment items reference this product
    const equipmentItems = project.data.equipment_items || [];
    return equipmentItems.some(item => {
      const productSlug = item.product_slug || '';
      return productSlug.includes(productId) || 
             productId.includes(productSlug.split('/').pop() || '') ||
             productSlug.includes(productCategory);
    });
  })
  .slice(0, 3); // Limit to 3 projects

const optimizedMainImage = await getOptimizedProductImage(product.data.main_image, {
  width: 900,
  quality: 82,
});

const optimizedProductData = {
  ...product.data,
  main_image: optimizedMainImage,
};

// Product structured data schema
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.data.name,
  "description": product.data.description || `Sản phẩm ${product.data.name} chính hãng - EPCVINA Solar`,
  "sku": productId,
  "model": product.data.model || '',
  "brand": {
    "@type": "Brand",
    "name": product.data.brand
  },
  "image": product.data.main_image ? `https://epcvina.com${product.data.main_image}` : 'https://epcvina.com/images/placeholder.png',
  "category": product.data.category,
  "material": product.data.specifications?.['Loại cell'] || product.data.specifications?.['Công nghệ'] || '',
  "manufacturer": {
    "@type": "Organization",
    "name": product.data.brand
  },
  "offers": {
    "@type": "Offer",
    "url": `https://epcvina.com/thiet-bi/${productCategory}/${productId}`,
    "priceCurrency": "VND",
    "price": product.data.price || 0,
    "priceValidUntil": new Date(new Date().getFullYear(), 11, 31).toISOString().split('T')[0],
    "availability": product.data.is_available ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "seller": {
      "@type": "Organization",
      "name": "EPCVINA Solar"
    },
    "warranty": product.data.warranty || '',
  },
};

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Trang Chủ", "item": "https://epcvina.com" },
    { "@type": "ListItem", "position": 2, "name": "Thiết Bị", "item": "https://epcvina.com/thiet-bi" },
    { "@type": "ListItem", "position": 3, "name": product.data.name, "item": `https://epcvina.com/thiet-bi/${productCategory}/${productId}` }
  ]
};
---
<EquipmentLayout
  title={product.data.name}
  description={`${product.data.name}. ${product.data.description || 'Thiết bị điện mặt trời chính hãng, tư vấn và bảo hành bởi EPCVINA Solar.'}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <ProductDetail client:visible product={optimizedProductData} relatedProjects={relatedProjects} />
</EquipmentLayout>
