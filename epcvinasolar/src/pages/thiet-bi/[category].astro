---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import EquipmentPage from '../../components/pages/equipment/EquipmentPage';

export const prerender = false;

const { category } = Astro.params;

const categoryMeta: Record<string, { title: string; description: string; keywords: string }> = {
  'panel': {
    title: 'Tấm Pin Mặt Trời Chính Hãng - AIKO, Longi, Huawei | EPCVINA',
    description: 'Tấm pin mặt trời chính hãng AIKO, Longi, Huawei hiệu suất cao. Bảo hành 25 năm, hiệu suất 21-23%. Giá tốt nhất Hà Nội.',
    keywords: 'tấm pin mặt trời, solar panel chính hãng, pin AIKO, pin Longi, pin Huawei, pin mặt trời giá rẻ'
  },
  'inverter-on-grid': {
    title: 'Inverter On-Grid - Growatt, SAJ, Deye Chính Hãng | EPCVINA',
    description: 'Inverter hòa lưới chính hãng Growatt, SAJ, Deye. Hiệu suất 97-98%, bảo hành 5-10 năm. Phù hợp hệ on-grid 3-50kW.',
    keywords: 'inverter on-grid, biến tần hòa lưới, inverter Growatt, inverter SAJ, inverter Deye'
  },
  'hybrid-inverter': {
    title: 'Inverter Hybrid - AIKO, Huawei, Deye Chính Hãng | EPCVINA',
    description: 'Inverter hybrid chính hãng AIKO, Huawei, Deye. Hỗ trợ pin lưu trữ, backup điện khi mất. Bảo hành 5-10 năm.',
    keywords: 'inverter hybrid, biến tần hybrid, inverter AIKO, inverter Huawei, inverter có lưu trữ'
  },
  'battery': {
    title: 'Pin Lưu Trữ BESS - Pylontech, BYD, Deye Chính Hãng | EPCVINA',
    description: 'Pin lưu trữ BESS chính hãng Pylontech, BYD, Deye. Dung lượng 5-20kWh, bảo hành 5-10 năm. Lưu trữ điện cho hệ hybrid.',
    keywords: 'pin lưu trữ BESS, pin lithium solar, pin Pylontech, pin BYD, pin Deye, pin lưu trữ điện mặt trời'
  },
  'mounting': {
    title: 'Phụ Kiện Mounting - Khung Giàn Lắp Đặt Pin Mặt Trời | EPCVINA',
    description: 'Phụ kiện mounting, khung giàn nhôm, rail, kẹp pin, móc mái. Đầy đủ cho mái tôn, mái ngói, mái bằng. Chịu gió bão cấp 12.',
    keywords: 'phụ kiện mounting, khung giàn solar, rail nhôm, kẹp pin, móc mái, phụ kiện lắp pin mặt trời'
  },
  'ev-charger': {
    title: 'Trạm Sạc Xe Điện EV Charger - Wallbox Chính Hãng | EPCVINA',
    description: 'Trạm sạc xe điện EV Charger wallbox 7kW-22kW. Tương thích VF3, VF5, VF6, VinFast. Lắp đặt nhanh 1 ngày.',
    keywords: 'trạm sạc xe điện, EV charger, wallbox, sạc VF3 VF5 VF6, sạc xe điện tại nhà'
  }
};

const meta = categoryMeta[category || ''] || {
  title: `Thiết Bị ${category} - Điện Mặt Trời Chính Hãng | EPCVINA Solar`,
  description: `Thiết bị điện mặt trời ${category} chính hãng, bảo hành đầy đủ. Tư vấn miễn phí: 0988 446 113`,
  keywords: `thiết bị ${category}, điện mặt trời, EPCVINA Solar`
};
if (!category) {
  return Astro.redirect('/thiet-bi', 301);
}
---

<DashboardLayout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Thiết Bị', url: 'https://epcvina.com/thiet-bi' },
    { name: category || '', url: `https://epcvina.com/thiet-bi/${category}` }
  ]}
>
  <DashboardShell client:load>
    <EquipmentPage category={category!} client:idle />
  </DashboardShell>
</DashboardLayout>
