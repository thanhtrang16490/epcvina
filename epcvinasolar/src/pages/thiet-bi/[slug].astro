---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import BrandPage from '../../components/pages/brand/BrandPage';
import { localBrands, getBrandBySlug } from '../../data/brands';

export function getStaticPaths() {
  return localBrands.map(brand => ({
    params: { slug: brand.slug },
    props: { brand },
  }));
}

const { brand } = Astro.props;
const seoTitle = `Thiết bị điện mặt trời ${brand.name} chính hãng | EPCVINA Solar`;
const seoDescription = `${brand.description || `Sản phẩm ${brand.name} chính hãng`} - Bảo hành chính hãng, hỗ trợ kỹ thuật 24/7. Giá tốt nhất tại EPCVINA Solar.`;
---

<DashboardLayout title={seoTitle} description={seoDescription}>
  <DashboardShell client:load>
    <BrandPage client:idle brand={brand.slug} brandName={brand.name} />
  </DashboardShell>
</DashboardLayout>
