---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell.astro';
import HeaderBar from '../components/home/layout/HeaderBar';
import InternshipRecruitmentForm from '../components/pages/recruitment/InternshipRecruitmentForm';
import { buildFaqSchema } from '../lib/schema';

const faqSchema = buildFaqSchema([
  {
    q: 'Em sẽ được làm gì khi thực tập?',
    a: 'Em sẽ được học khảo sát hiện trường, đọc bản vẽ cơ bản, hỗ trợ thiết kế hệ thống điện mặt trời và đi cùng kỹ sư trong các dự án thực tế.',
  },
  {
    q: 'Sinh viên nào có thể đăng ký?',
    a: 'Ưu tiên sinh viên năm 3, năm 4 hoặc mới tốt nghiệp các ngành Điện, Điện - Điện tử, Năng lượng tái tạo, Cơ điện và ngành liên quan.',
  },
  {
    q: 'Thực tập có hỗ trợ chi phí không?',
    a: 'Có. Ứng viên phù hợp sẽ được hỗ trợ chi phí thực tập theo thời gian tham gia và mức độ phù hợp với vị trí.',
  },
  {
    q: 'Nộp thông tin thế nào?',
    a: 'Chỉ cần điền form trên trang này, thông tin sẽ được gửi trực tiếp cho nhân sự và sẽ có người liên hệ lại sớm.',
  },
  {
    q: 'QR trên trang để làm gì?',
    a: 'QR giúp mở nhanh đúng trang tuyển dụng này, rất tiện để in poster, dán standee hoặc gửi cho bạn bè, nhóm lớp.',
  },
]);
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<DashboardLayout
  title="Tuyển Thực Tập Sinh Kỹ Sư Điện Mặt Trời | EPCVINA Solar"
  description="Cơ hội thực tập sinh cho sinh viên ngành điện mặt trời tại EPCVINA Solar. Được đào tạo thực tế, tham gia dự án, hỗ trợ kỹ sư và phát triển nghề nghiệp."
  keywords="thực tập sinh kỹ sư điện mặt trời, tuyển thực tập sinh solar, internship điện mặt trời, EPCVINA Solar"
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[{ name: 'Trang Chủ', url: 'https://epcvina.com' }, { name: 'Tuyển Dụng', url: 'https://epcvina.com/tuyen-dung-thuc-tap-sinh-ky-su-dien-mat-troi' }]}
>
  <DashboardShell>
    <HeaderBar client:idle pathname={Astro.url.pathname} />
    <section class="relative overflow-hidden text-white">
      <div class="absolute inset-0">
        <img src="/images/tuyen-dung-thuc-tap-solar-hero.png" alt="" class="h-full w-full object-cover object-center" />
        <div class="absolute inset-0 bg-gradient-to-r from-[#5f1116]/92 via-[#b11f28]/76 to-[#f5831f]/48"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(255,255,255,0.16),_transparent_28%)]"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 sm:pt-28 sm:pb-20 min-h-[620px] flex items-center">
        <div class="max-w-3xl">
          <p class="text-orange-100 text-sm font-semibold uppercase tracking-[0.24em] mb-4 drop-shadow-sm">Tuyển Dụng Thực Tập Sinh</p>
          <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-5 drop-shadow-sm">
            Thực Tập Sinh Kỹ Sư
            <span class="block text-orange-100">Điện Mặt Trời</span>
          </h1>
          <p class="text-lg sm:text-xl text-white/92 max-w-2xl drop-shadow-sm">
            Dành cho sinh viên muốn học nghề thực tế, được kèm cặp bởi kỹ sư giàu kinh nghiệm và tham gia vào các dự án điện mặt trời từ khảo sát đến triển khai. Có hỗ trợ chi phí thực tập cho ứng viên phù hợp.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#dang-ky" class="inline-flex items-center gap-2 bg-white text-red-700 font-bold px-6 py-3 rounded-2xl hover:bg-orange-50 transition-colors shadow-lg shadow-black/10">
              Đăng ký ngay
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-14">
      <section class="hidden sm:grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="bg-white rounded-3xl border border-gray-100 p-6 sm:p-8 shadow-sm">
          <div class="inline-flex items-center rounded-full bg-red-50 px-4 py-1.5 text-sm font-semibold text-red-700 mb-4">
            QR truy cập nhanh
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">Quét QR để mở nhanh trang tuyển dụng</h2>
          <p class="text-sm sm:text-base text-gray-600 max-w-2xl">
            Dùng điện thoại quét mã này để truy cập trực tiếp trang tuyển dụng thực tập sinh kỹ sư điện mặt trời, tiện cho in poster, chia sẻ nội bộ hoặc gửi cho sinh viên.
          </p>
          <div class="mt-6 grid gap-4 sm:grid-cols-[280px_1fr] sm:items-center">
            <div class="relative aspect-square w-full max-w-[280px] justify-self-center rounded-3xl border border-gray-200 bg-white p-3 shadow-sm sm:justify-self-start">
              <img
                src={`https://api.qrserver.com/v1/create-qr-code/?size=280x280&margin=14&data=${encodeURIComponent(Astro.url.href)}`}
                alt="QR truy cập trang tuyển dụng thực tập sinh kỹ sư điện mặt trời"
                width="280"
                height="280"
                class="h-full w-full rounded-2xl"
              />
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="rounded-2xl border border-gray-200 bg-white p-2 shadow-lg">
                  <img src="/logo-favicon.svg" alt="EPCVINA Solar" class="h-12 w-12 rounded-xl object-contain" loading="lazy" />
                </div>
              </div>
            </div>
            <div class="space-y-3 text-sm text-gray-600 text-center sm:text-left">
              <p><strong class="text-gray-900">URL:</strong> {Astro.url.href}</p>
              <p>Phù hợp để in lên standee, poster tuyển dụng hoặc gửi qua Zalo cho ứng viên.</p>
              <button
                type="button"
                data-qr-modal-open
                class="inline-flex items-center justify-center rounded-2xl border border-red-200 bg-red-50 px-4 py-2.5 font-semibold text-red-700 transition hover:bg-red-100 sm:self-start"
              >
                Mở QR kích thước lớn
              </button>
              <p class="text-xs text-gray-400">Logo giữa QR giúp nhận diện thương hiệu, vẫn giữ nền trắng quanh logo để dễ quét hơn.</p>
            </div>
          </div>
        </div>

        <aside class="bg-gradient-to-br from-slate-900 to-red-700 text-white rounded-3xl p-6 sm:p-8">
          <h3 class="text-xl font-bold mb-3">Dùng cho</h3>
          <ul class="space-y-3 text-white/90 text-sm">
            <li>Poster tuyển dụng tại trường đại học</li>
            <li>Standee ở văn phòng / sự kiện nghề nghiệp</li>
            <li>Nhóm Zalo lớp, fanpage, email tuyển dụng</li>
            <li>Quét nhanh bằng điện thoại khi gặp sinh viên</li>
          </ul>
          <div class="mt-6 rounded-2xl bg-white/10 p-4">
            <p class="text-sm text-white/80">Trang đích</p>
            <p class="text-base font-semibold break-all">{Astro.url.pathname}</p>
          </div>
        </aside>
      </section>

      <section class="grid gap-6 lg:grid-cols-3">
        <div class="lg:col-span-2 bg-white rounded-3xl border border-gray-100 p-6 sm:p-8 shadow-sm">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">Bạn sẽ được học gì?</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl bg-orange-50 p-5">
              <h3 class="font-semibold text-gray-900 mb-2">Thực chiến dự án</h3>
              <p class="text-sm text-gray-600">Tham gia cùng đội ngũ kỹ sư ở các dự án điện mặt trời dân dụng và công nghiệp.</p>
            </div>
            <div class="rounded-2xl bg-red-50 p-5">
              <h3 class="font-semibold text-gray-900 mb-2">Đào tạo từ đầu</h3>
              <p class="text-sm text-gray-600">Được hướng dẫn cách khảo sát, đọc bản vẽ, hiểu thiết bị và quy trình thi công cơ bản.</p>
            </div>
            <div class="rounded-2xl bg-emerald-50 p-5">
              <h3 class="font-semibold text-gray-900 mb-2">Hỗ trợ kỹ năng nghề</h3>
              <p class="text-sm text-gray-600">Rèn luyện tư duy kỹ thuật, giao tiếp với khách hàng và phối hợp nhóm dự án.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 p-5">
              <h3 class="font-semibold text-gray-900 mb-2">Cơ hội phát triển</h3>
              <p class="text-sm text-gray-600">Ứng viên phù hợp có thể được xem xét lên vị trí nhân sự chính thức sau giai đoạn thực tập.</p>
            </div>
            <div class="rounded-2xl bg-amber-50 p-5 sm:col-span-2">
              <h3 class="font-semibold text-gray-900 mb-2">Hỗ trợ chi phí thực tập</h3>
              <p class="text-sm text-gray-600">Có hỗ trợ chi phí theo thời gian tham gia và mức độ phù hợp với vị trí, trao đổi cụ thể khi phỏng vấn.</p>
            </div>
          </div>
        </div>

        <aside class="bg-gradient-to-br from-gray-900 to-red-700 text-white rounded-3xl p-6 sm:p-8">
          <h2 class="text-2xl font-bold mb-4">Phù hợp với</h2>
          <ul class="space-y-3 text-white/90 text-sm">
            <li>Sinh viên năm 3, năm 4 hoặc mới tốt nghiệp</li>
            <li>Ngành Điện, Điện - Điện tử, Cơ điện, Năng lượng tái tạo</li>
            <li>Muốn học việc thực tế thay vì chỉ lý thuyết</li>
            <li>Có tinh thần chủ động, ham học hỏi và trách nhiệm</li>
          </ul>
          <div class="mt-6 rounded-2xl bg-white/10 p-4">
            <p class="text-sm text-white/80">Hình thức</p>
            <p class="text-lg font-semibold">Thực tập / Part-time linh hoạt</p>
          </div>
          <div class="mt-4 rounded-2xl bg-white/10 p-4">
            <p class="text-sm text-white/80">Hỗ trợ</p>
            <p class="text-lg font-semibold">Có hỗ trợ chi phí thực tập</p>
          </div>
        </aside>
      </section>

      <section id="dang-ky" class="bg-white rounded-3xl border border-gray-100 p-6 sm:p-8 shadow-sm">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 text-center mb-3">Đăng ký ứng tuyển</h2>
          <p class="text-gray-500 text-center mb-8">Điền thông tin, chúng tôi sẽ tạo lead và liên hệ lại sớm qua SĐT hoặc bộ phận tuyển dụng.</p>
          <InternshipRecruitmentForm client:load />
        </div>
      </section>

      <section>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 text-center mb-8">Câu hỏi thường gặp</h2>
        <div class="max-w-3xl mx-auto space-y-3">
          <details class="group bg-white rounded-2xl border border-gray-100 overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-semibold text-gray-900">
              Em sẽ được làm gì khi thực tập?
              <svg class="h-5 w-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-4 text-sm text-gray-600">
              Em sẽ được học khảo sát hiện trường, đọc bản vẽ cơ bản, hỗ trợ thiết kế hệ thống điện mặt trời và đi cùng kỹ sư trong các dự án thực tế.
            </div>
          </details>
          <details class="group bg-white rounded-2xl border border-gray-100 overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-semibold text-gray-900">
              Sinh viên nào có thể đăng ký?
              <svg class="h-5 w-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-4 text-sm text-gray-600">
              Ưu tiên sinh viên năm 3, năm 4 hoặc mới tốt nghiệp các ngành Điện, Điện - Điện tử, Năng lượng tái tạo, Cơ điện và ngành liên quan.
            </div>
          </details>
          <details class="group bg-white rounded-2xl border border-gray-100 overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-semibold text-gray-900">
              Thực tập có hỗ trợ chi phí không?
              <svg class="h-5 w-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-4 text-sm text-gray-600">
              Có. Ứng viên phù hợp sẽ được hỗ trợ chi phí thực tập theo thời gian tham gia và mức độ phù hợp với vị trí.
            </div>
          </details>
          <details class="group bg-white rounded-2xl border border-gray-100 overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-semibold text-gray-900">
              Nộp thông tin thế nào?
              <svg class="h-5 w-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-4 text-sm text-gray-600">
              Chỉ cần điền form trên trang này, thông tin sẽ được gửi trực tiếp cho nhân sự và sẽ có người liên hệ lại sớm.
            </div>
          </details>
          <details class="group bg-white rounded-2xl border border-gray-100 overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-semibold text-gray-900">
              QR trên trang để làm gì?
              <svg class="h-5 w-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-4 text-sm text-gray-600">
              QR giúp mở nhanh đúng trang tuyển dụng này, rất tiện để in poster, dán standee hoặc gửi cho bạn bè, nhóm lớp.
            </div>
          </details>
        </div>
      </section>
    </div>

    <div data-qr-modal class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/70 px-4 py-6">
      <div class="relative w-full max-w-2xl overflow-hidden rounded-3xl bg-white shadow-2xl">
        <div class="flex items-center justify-between border-b border-gray-100 px-5 py-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-red-600">QR truy cập nhanh</p>
            <h3 class="text-lg font-bold text-gray-900">Quét để mở trang tuyển dụng</h3>
          </div>
          <button type="button" data-qr-modal-close class="rounded-full p-2 text-gray-500 transition hover:bg-gray-100 hover:text-gray-700" aria-label="Đóng modal">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="grid gap-6 p-5 sm:grid-cols-[320px_1fr] sm:p-6">
          <div class="mx-auto w-full max-w-[320px]">
            <div class="relative aspect-square rounded-3xl border border-gray-200 bg-white p-4 shadow-sm">
              <img
                src={`https://api.qrserver.com/v1/create-qr-code/?size=420x420&margin=16&data=${encodeURIComponent(Astro.url.href)}`}
                alt="QR truy cập trang tuyển dụng thực tập sinh kỹ sư điện mặt trời"
                width="420"
                height="420"
                class="h-full w-full rounded-2xl"
              />
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="rounded-2xl border border-gray-200 bg-white p-2 shadow-lg">
                  <img src="/logo-favicon.svg" alt="EPCVINA Solar" class="h-12 w-12 rounded-xl object-contain" loading="lazy" />
                </div>
              </div>
            </div>
          </div>
          <div class="flex flex-col justify-center gap-3 text-sm text-gray-600">
            <p class="text-base font-semibold text-gray-900">Dùng cho in poster, standee hoặc gửi nhanh trong nhóm lớp.</p>
            <p class="break-all"><strong class="text-gray-900">URL:</strong> {Astro.url.href}</p>
            <p>Quét mã này sẽ mở đúng landing page tuyển dụng thực tập sinh kỹ sư điện mặt trời.</p>
            <div class="flex flex-wrap gap-3 pt-2">
              <a
                href={`https://api.qrserver.com/v1/create-qr-code/?size=420x420&margin=16&data=${encodeURIComponent(Astro.url.href)}`}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center justify-center rounded-2xl bg-red-600 px-4 py-2.5 font-semibold text-white transition hover:bg-red-700"
              >
                Mở ảnh QR
              </a>
              <button type="button" data-qr-modal-close class="inline-flex items-center justify-center rounded-2xl border border-gray-200 bg-white px-4 py-2.5 font-semibold text-gray-700 transition hover:bg-gray-50">
                Đóng
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </DashboardShell>
</DashboardLayout>

<script>
  const modal = document.querySelector('[data-qr-modal]');
  const openButtons = document.querySelectorAll('[data-qr-modal-open]');
  const closeButtons = document.querySelectorAll('[data-qr-modal-close]');

  const openModal = () => {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    document.body.style.overflow = '';
  };

  openButtons.forEach((button) => button.addEventListener('click', openModal));
  closeButtons.forEach((button) => button.addEventListener('click', closeModal));
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeModal();
  });
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeModal();
  });
</script>
