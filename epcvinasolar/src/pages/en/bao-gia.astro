---
const target = '/en/quote';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,follow" />
    <meta name="description" content="Request a solar system quote from EPCVINA Solar." />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <title>Solar quote | EPCVINA Solar</title>
  </head>
  <body>
    <p>Redirecting...</p>
  </body>
</html>
