---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell';
import FamilyLandingPage from '../components/pages/ad-landing/DienMatTroiGiaDinh';

export const prerender = true;

// SEO-optimized metadata for ad landing page
const seoTitle = 'Điện Mặt Trời Gia Đình 2026 - Giảm 90% Tiền Điện | EPCVINA Solar';
const seoDescription = 'Lắp điện mặt trời gia đình từ 60 triệu. Giảm 50-90% hóa đơn điện, có điện khi mất điện. Bảo hành 10 năm, 500+ gia đình tin dùng. Tư vấn miễn phí: 0988 446 113';
const seoKeywords = 'điện mặt trời gia đình, điện mặt trời hybrid, điện mặt trời on-grid, lắp điện mặt trời hà nội, giá điện mặt trời 2026, pin lưu trữ điện, EPCVINA Solar, giảm tiền điện';

// FAQ Schema for rich snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Điện mặt trời có hiệu quả không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Có. Trung bình giảm 70-85% hóa đơn điện. Hệ thống hoạt động 25-30 năm, hoàn vốn trong 3-5 năm."
      }
    },
    {
      "@type": "Question",
      "name": "Bao lâu hoàn vốn điện mặt trời?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trung bình 3-5 năm cho On-Grid, 5-7 năm cho Hybrid. Sau đó sử dụng điện miễn phí 20+ năm."
      }
    },
    {
      "@type": "Question",
      "name": "Mất điện có dùng được điện mặt trời không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hệ On-Grid sẽ ngắt khi mất điện (an toàn). Hệ Hybrid có pin lưu trữ nên vẫn dùng được bình thường."
      }
    },
    {
      "@type": "Question",
      "name": "15 kWp phù hợp với đối tượng nào?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Phù hợp gia đình sử dụng điện 3-5 triệu/tháng, diện tích mái 80-100m2, muốn tiết kiệm 70-90% hóa đơn điện."
      }
    },
    {
      "@type": "Question",
      "name": "Bảo hành điện mặt trời bao lâu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tấm pin bảo hành 10 năm, biến tần 5-10 năm, pin lưu trữ 5 năm. EPCVINA hỗ trợ kỹ thuật trọn đời."
      }
    },
    {
      "@type": "Question",
      "name": "Nhà tôi có phù hợp lắp điện mặt trời không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hầu hết các mái nhà đều lắp được. EPCVINA khảo sát miễn phí để đánh giá chính xác hướng nắng, diện tích và kết cấu mái."
      }
    },
    {
      "@type": "Question",
      "name": "Mưa nhiều có đủ điện không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tấm pin vẫn sản xuất điện khi mưa (giảm 10-20%). Hệ thống được thiết kế dựa trên dữ liệu thời tiết địa phương để đảm bảo hiệu quả."
      }
    },
    {
      "@type": "Question",
      "name": "Có phải bảo trì thường xuyên không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Không. Chỉ cần vệ sinh tấm pin 2-4 lần/năm. EPCVINA bảo hành 10 năm và hỗ trợ kỹ thuật trọn đời."
      }
    },
    {
      "@type": "Question",
      "name": "Pin lưu trữ có cần thiết không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pin lưu trữ giúp dự phòng khi mất điện và sử dụng điện vào buổi tối. Đặc biệt hữu ích cho khu vực hay mất điện."
      }
    },
    {
      "@type": "Question",
      "name": "Thi công có ảnh hưởng sinh hoạt không?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Không. Thi công nhanh 1-2 ngày, không ảnh hưởng đến sinh hoạt hàng ngày của gia đình."
      }
    },
    {
      "@type": "Question",
      "name": "Quy trình thanh toán như thế nào?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "30% đặt cọc khi ký hợp đồng, 60% khi giao thiết bị, 10% sau nghiệm thu. Minh bạch từng hạng mục."
      }
    },
    {
      "@type": "Question",
      "name": "EPCVINA phục vụ khu vực nào?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "EPCVINA phục vụ Hà Nội và 15 tỉnh miền Bắc: Hải Dương, Hưng Yên, Bắc Ninh, Nam Định, Thái Bình, Vĩnh Phúc, Phú Thọ, Hòa Bình, Hà Nam, Ninh Bình, Quảng Ninh, Hải Phòng, Bắc Giang, Lạng Sơn, Lào Cai."
      }
    }
  ]
};

// Product Schema for combos
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Gói Điện Mặt Trời Gia Đình EPCVINA",
  "description": "Hệ thống điện mặt trời trọn gói cho gia đình: On-Grid và Hybrid với pin lưu trữ",
  "brand": {
    "@type": "Brand",
    "name": "EPCVINA Solar"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "VND",
    "lowPrice": "60000000",
    "highPrice": "219000000",
    "offerCount": "5",
    "availability": "https://schema.org/InStock"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "500",
    "bestRating": "5",
    "worstRating": "1"
  }
};

// Service Schema
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Lắp đặt điện mặt trời gia đình",
  "provider": {
    "@type": "LocalBusiness",
    "name": "EPCVINA Solar",
    "telephone": "+84988446113",
    "areaServed": {
      "@type": "State",
      "name": "Hà Nội và miền Bắc Việt Nam"
    }
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Gói điện mặt trời",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Điện mặt trời On-Grid 5kWp"
        },
        "price": "60000000",
        "priceCurrency": "VND"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Điện mặt trời Hybrid 8.8kWp"
        },
        "price": "148300000",
        "priceCurrency": "VND"
      }
    ]
  }
};

// VideoObject Schema for construction video
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Quy trình thi công điện mặt trời EPCVINA Solar",
  "description": "Video thực tế quy trình lắp đặt hệ thống điện mặt trời 15kWp từ khảo sát đến nghiệm thu",
  "thumbnailUrl": "https://epcvina.com/thumb-video.png",
  "contentUrl": "https://epcvina.com/home_image.mp4",
  "uploadDate": new Date().toISOString(),
  "duration": "PT1M45S",
  "publisher": {
    "@type": "Organization",
    "name": "EPCVINA Solar",
    "logo": {
      "@type": "ImageObject",
      "url": "https://epcvina.com/logo-epcvina-solar.png"
    }
  }
};
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Điện Mặt Trời Gia Đình', url: 'https://epcvina.com/dien-mat-troi-gia-dinh' }
  ]}
>
  {/* FAQ Schema for rich snippets */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  {/* Product Schema */}
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  
  {/* Service Schema */}
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  
  {/* VideoObject Schema */}
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
  
  {/* Mobile Optimization: Use client:visible for below-fold React components */}
  <DashboardShell client:load>
      <FamilyLandingPage client:visible />
    </DashboardShell>
</DashboardLayout>
