---
import { buildFaqSchema, buildProductSchema } from '../lib/schema';

import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell.astro';
import FamilyLandingPage from '../components/pages/ad-landing/DienMatTroiGiaDinh';

export const prerender = true;

// SEO-optimized metadata for ad landing page
const seoTitle = 'Điện Mặt Trời Gia Đình | EPCVINA';
const seoDescription = 'Lắp điện mặt trời gia đình từ 60 triệu. Giảm 50-90% hóa đơn điện, có điện khi mất điện. Chọn On-Grid hoặc Hybrid theo nhu cầu thực tế. Tư vấn: 0988 446 113';
const seoKeywords = 'điện mặt trời gia đình, điện mặt trời hybrid, điện mặt trời on-grid, lắp điện mặt trời hà nội, giá điện mặt trời 2026, pin lưu trữ điện, EPCVINA Solar, giảm tiền điện';

// FAQ Schema for rich snippets - must match FAQ_DATA in data.ts exactly
const faqSchema = buildFaqSchema([
  { q: "Điện mặt trời có hiệu quả không?", a: "Có. Trung bình giảm 70-85% hóa đơn điện. Hệ thống hoạt động 25-30 năm, hoàn vốn trong 3-5 năm." },
  { q: "Nhà tôi có phù hợp không?", a: "Hầu hết các mái nhà đều lắp được. Chúng tôi khảo sát miễn phí để đánh giá chính xác." },
  { q: "Bao lâu hoàn vốn?", a: "Trung bình 3-5 năm cho On-Grid, 5-7 năm cho Hybrid. Sau đó sử dụng điện miễn phí 20+ năm." },
  { q: "Mất điện có dùng được không?", a: "Hệ On-Grid sẽ ngắt khi mất điện (an toàn). Hệ Hybrid có pin lưu trữ nên vẫn dùng được." },
  { q: "Có thể sạc xe điện không?", a: "Có. Chúng tôi tích hợp EV Charger vào hệ Hybrid, sạc miễn phí từ năng lượng mặt trời." },
  { q: "Mưa nhiều có đủ điện không?", a: "Tấm pin vẫn sản xuất điện khi mưa (giảm 10-20%). Hệ thống được thiết kế dựa trên dữ liệu thời tiết địa phương." },
  { q: "Có phải bảo trì thường xuyên không?", a: "Không. Chỉ cần vệ sinh tấm pin 2-4 lần/năm. Chúng tôi bảo hành 10 năm toàn bộ hệ thống." },
  { q: "15 kWp phù hợp với đối tượng nào?", a: "Phù hợp gia đình sử dụng điện 3-5 triệu/tháng, diện tích mái 80-100m2, muốn tiết kiệm 70-90% hóa đơn điện." },
  { q: "Pin lưu trữ có cần thiết không?", a: "Pin lưu trữ giúp dự phòng khi mất điện và sử dụng điện vào buổi tối. Đặc biệt hữu ích cho khu vực hay mất điện." },
  { q: "Bảo hành các thiết bị bao lâu?", a: "Tấm pin bảo hành 10 năm, biến tần 5-10 năm, pin lưu trữ 5 năm. EPCVINA hỗ trợ kỹ thuật trọn đời." },
  { q: "Thi công có ảnh hưởng sinh hoạt không?", a: "Không. Thi công nhanh 1-2 ngày, không ảnh hưởng đến sinh hoạt hàng ngày." },
  { q: "Có được hỗ trợ vay ngân hàng không?", a: "Hiện tại chúng tôi không hỗ trợ trả góp. Khách hàng thanh toán theo tiến độ hợp đồng." },
  { q: "Hệ thống có tự động ngắt khi sự cố?", a: "Có. Hệ thống có nhiều lớp bảo vệ: chống quá tải, chống đoản mạch, chống sét, tiếp địa an toàn." },
  { q: "Có thể mở rộng hệ thống sau này không?", a: "Có. Hệ Hybrid cho phép thêm pin lưu trữ hoặc mở rộng tấm pin sau này." },
  { q: "Quy trình thanh toán như thế nào?", a: "30% đặt cọc khi ký hợp đồng, 60% khi giao thiết bị, 10% sau nghiệm thu. Minh bạch từng hạng mục." },
]);

// Product Schema for combos
const productSchema = buildProductSchema({
  name: "Gói Điện Mặt Trời Gia Đình EPCVINA",
  description: "Hệ thống điện mặt trời trọn gói cho gia đình: On-Grid và Hybrid với pin lưu trữ",
  brandName: "EPCVINA Solar",
  lowPrice: 60000000,
  highPrice: 219000000,
  offerCount: 5,
});

// Service Schema
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Lắp đặt điện mặt trời gia đình",
  "provider": {
    "@type": "LocalBusiness",
    "name": "EPCVINA Solar",
    "telephone": "+84988446113",
    "areaServed": {
      "@type": "State",
      "name": "Hà Nội và miền Bắc Việt Nam"
    }
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Gói điện mặt trời",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Điện mặt trời On-Grid 5kWp"
        },
        "price": 60000000,
        "priceCurrency": "VND"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Điện mặt trời Hybrid 8.8kWp"
        },
        "price": 148300000,
        "priceCurrency": "VND"
      }
    ]
  }
};

// VideoObject Schema for construction video
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Quy trình thi công điện mặt trời EPCVINA Solar",
  "description": "Video thực tế quy trình lắp đặt hệ thống điện mặt trời 15kWp từ khảo sát đến nghiệm thu",
  "thumbnailUrl": "https://epcvina.com/thumb-video.png",
  "contentUrl": "https://epcvina.com/home_image.mp4",
  "uploadDate": new Date().toISOString(),
  "duration": "PT1M45S",
  "publisher": {
    "@type": "Organization",
    "name": "EPCVINA Solar",
    "logo": {
      "@type": "ImageObject",
      "url": "https://epcvina.com/favicon.svg"
    }
  }
};
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Điện Mặt Trời Gia Đình', url: 'https://epcvina.com/dien-mat-troi-gia-dinh' }
  ]}
>
  {/* FAQ Schema for rich snippets */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  
  {/* Product Schema */}
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  
  {/* Service Schema */}
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  
  {/* VideoObject Schema */}
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
  
  {/* Ad landing mode: keep the page focused on calculator, hotline and lead form. */}
  <DashboardShell showFooter={false}>
      <FamilyLandingPage client:visible />
    </DashboardShell>
</DashboardLayout>
