---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell';
import HybridBESSPage from '../components/pages/hybrid/HybridBESSPage';
import { buildFaqSchema } from '../lib/schema';

export const prerender = true;

const seoTitle = 'Điện Mặt Trời Hybrid & BESS | EPCVINA';
const seoDescription = 'Hệ thống điện mặt trời Hybrid kết hợp pin lưu trữ BESS. Giảm 70-90% tiền điện, có điện khi mất điện. Bảo hành 10 năm. Tư vấn miễn phí: 0988 446 113';
const seoKeywords = 'điện mặt trời hybrid, hệ thống hybrid, pin lưu trữ BESS, điện mặt trời có lưu trữ, hybrid solar, BESS, EPCVINA Solar, mất điện vẫn có điện';

const faqSchema = buildFaqSchema([
  { q: 'Hệ thống Hybrid là gì?', a: 'Hệ thống Hybrid kết hợp điện mặt trời với pin lưu trữ. Vừa giảm tiền điện, vừa có điện dự phòng khi mất điện lưới.' },
  { q: 'Pin BESS là gì?', a: 'BESS (Battery Energy Storage System) là hệ thống lưu trữ năng lượng bằng pin. Lưu điện dư thừa ban ngày để dùng ban đêm hoặc khi mất điện.' },
  { q: 'Hybrid khác On-Grid như thế nào?', a: 'On-Grid chỉ phát điện lên lưới, mất điện thì ngắt. Hybrid có pin lưu trữ nên vẫn dùng được khi mất điện, tự chủ năng lượng cao hơn.' },
  { q: 'Chi phí hệ Hybrid bao nhiêu?', a: 'Từ 120-250 triệu tùy công suất. Gói 5kWp + pin 5kWh từ 120 triệu, gói 10kWp + pin 10kWh từ 200 triệu. Hoàn vốn 5-7 năm.' },
  { q: 'Pin lưu trữ dùng được bao lâu?', a: 'Pin lithium có tuổi thọ 10-15 năm, bảo hành 5 năm. Sau 10 năm vẫn đạt 80% dung lượng ban đầu.' },
]);
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Điện Mặt Trời Hybrid', url: 'https://epcvina.com/dien-mat-troi-hybrid' }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <DashboardShell client:load>
      <HybridBESSPage client:visible />
    </DashboardShell>
</DashboardLayout>
