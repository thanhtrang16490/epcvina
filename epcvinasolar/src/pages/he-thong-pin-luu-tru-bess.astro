---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell';
import BESSLandingPage from '../components/pages/bess/BESSLandingPage';
import { buildFaqSchema } from '../lib/schema';

export const prerender = true;

const seoTitle = 'Hệ Thống Pin Lưu Trữ BESS | EPCVINA';
const seoDescription = 'Lắp đặt hệ thống pin lưu trữ BESS cho gia đình và doanh nghiệp. Lưu trữ năng lượng mặt trời, có điện khi mất điện. Bảo hành 5 năm. Tư vấn miễn phí: 0988 446 113';
const seoKeywords = 'pin lưu trữ BESS, hệ thống lưu trữ điện, battery storage, pin lithium, lưu trữ năng lượng mặt trời, BESS gia đình, EPCVINA';

const faqSchema = buildFaqSchema([
  { q: 'Pin BESS là gì?', a: 'BESS (Battery Energy Storage System) là hệ thống lưu trữ năng lượng bằng pin lithium. Lưu điện dư thừa từ điện mặt trời để dùng khi cần.' },
  { q: 'Tại sao cần pin lưu trữ?', a: 'Pin lưu trữ giúp: 1) Có điện khi mất điện lưới, 2) Dùng điện mặt trời vào ban đêm, 3) Tăng tự chủ năng lượng, 4) Giảm phụ thuộc vào điện lưới.' },
  { q: 'Chi phí pin lưu trữ bao nhiêu?', a: 'Pin 5kWh từ 35-50 triệu, pin 10kWh từ 70-100 triệu, pin 15kWh từ 100-150 triệu. Giá phụ thuộc vào thương hiệu và công nghệ pin.' },
  { q: 'Pin lưu trữ dùng được bao lâu?', a: 'Pin lithium có tuổi thọ 10-15 năm (6000+ chu kỳ). Bảo hành 5 năm. Sau 10 năm vẫn đạt 80% dung lượng.' },
  { q: 'Có thể lắp pin lưu trữ riêng không?', a: 'Có thể lắp riêng hoặc kết hợp với hệ điện mặt trời có sẵn. EPCVINA tư vấn giải pháp phù hợp với nhu cầu và ngân sách.' },
]);
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Hệ Thống Pin Lưu Trữ BESS', url: 'https://epcvina.com/he-thong-pin-luu-tru-bess' }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <DashboardShell client:load>
      <BESSLandingPage client:visible />
    </DashboardShell>
</DashboardLayout>
