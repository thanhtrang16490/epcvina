---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell';
import ProjectsPage from '../components/pages/projects/ProjectsPage';
---

<DashboardLayout
  title="Dự Án Điện Mặt Trời Tiêu Biểu | EPCVINA Solar"
  description="Xem các dự án điện mặt trời đã thi công bởi EPCVINA Solar. Hơn 500 công trình tại Hà Nội và các tỉnh phía Bắc. Chất lượng đảm bảo, khách hàng hài lòng."
  keywords="dự án điện mặt trời, thi công solar, công trình điện mặt trời Hà Nội, EPCVINA Solar projects"
  breadcrumbs={[{name: "Trang Chủ", url: "https://epcvina.com"}, {name: "Dự Án", url: "https://epcvina.com/du-an"}]}
>
  <DashboardShell client:load>
    <ProjectsPage client:idle />
  </DashboardShell>
</DashboardLayout>
