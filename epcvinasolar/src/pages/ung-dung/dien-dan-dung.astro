    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Ứng Dụng', url: 'https://epcvina.com/ung-dung/dien-dan-dung' },
    { name: 'Điện Dân Dụng', url: 'https://epcvina.com/ung-dung/dien-dan-dung' }
  ]}
>
  <DashboardShell>
    <ResidentialApplicationPage client:idle />
