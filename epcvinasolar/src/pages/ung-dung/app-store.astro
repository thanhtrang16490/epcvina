---
import StoreAppLayout from '../../layouts/StoreAppLayout.astro';

const features = [
  { title: 'Theo dõi dự án', desc: 'Xem tiến độ, mốc nghiệm thu và lịch bàn giao.' },
  { title: 'Nhận hỗ trợ', desc: 'Gửi yêu cầu kỹ thuật và theo dõi phản hồi.' },
  { title: 'Tra cứu nhanh', desc: 'Mở catalogue, tài liệu và hướng dẫn sử dụng.' },
];

const screenshots = [
  { title: 'Dashboard', note: 'Theo dõi nhanh tiến độ dự án và thông báo mới.' },
  { title: 'Hỗ trợ kỹ thuật', note: 'Gửi yêu cầu, xem trạng thái xử lý.' },
  { title: 'Tài liệu', note: 'Catalogue, hướng dẫn và checklist bàn giao.' },
];

const ratings = [
  { value: '4.9', label: 'Xếp hạng nội bộ', detail: '2,4 N đánh giá mô phỏng' },
  { value: '12+', label: 'Độ tuổi', detail: 'Phù hợp khách hàng trưởng thành' },
  { value: 'EPCVINA', label: 'Nhà phát triển', detail: 'Đội ngũ nội bộ' },
  { value: 'VI + EN', label: 'Ngôn ngữ', detail: 'Tiếng Việt và English' },
  { value: '24,6 MB', label: 'Kích cỡ', detail: 'Tối ưu gọn nhẹ' },
  { value: 'Offline', label: 'Trạng thái', detail: 'Xem dữ liệu đã đồng bộ' },
];

const releaseNotes = [
  'Tối ưu điều hướng giữa dự án, hỗ trợ và tài liệu để mở đúng màn hình nhanh hơn.',
  'Cải thiện chế độ xem trên mobile, giúp đọc trạng thái và phản hồi rõ ràng hơn.',
];

const privacyData = [
  {
    title: 'Dữ Liệu Liên Kết Với Bạn',
    items: ['Vị trí', 'Thông tin liên hệ', 'Danh bạ', 'Nội dung của người dùng', 'Mã định danh'],
  },
  {
    title: 'Dữ Liệu Không Liên Kết Với Bạn',
    items: ['Mã định danh', 'Dữ liệu sử dụng', 'Chẩn đoán'],
  },
];
---

<StoreAppLayout
  title="Ứng dụng EPCVINA nội bộ | App Store"
  description="Trang nội bộ kiểu App Store giới thiệu ứng dụng EPCVINA và giữ người dùng ở trong hệ thống."
  variant="app-store"
  noindex={true}
>
  <section class="mx-auto max-w-6xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="mb-4 flex items-center gap-3 text-sm text-slate-500">
      <a href="/" class="flex items-center gap-2 font-medium text-slate-600 hover:text-slate-900">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-black text-white text-base leading-none"></span>
        EPCVINA
      </a>
      <span class="text-slate-300">/</span>
      <span class="font-medium text-slate-500">Ứng dụng EPCVINA</span>
    </div>

    <div class="rounded-[2.25rem] bg-white p-5 shadow-[0_20px_90px_rgba(15,23,42,0.08)] ring-1 ring-black/5 sm:p-6 lg:p-8">
      <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr]">
        <div class="space-y-6">
          <div class="flex items-start gap-5">
            <div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-[1.9rem] bg-gradient-to-br from-slate-950 via-slate-900 to-slate-700 text-4xl text-white shadow-[0_18px_50px_rgba(15,23,42,0.22)]">
              
            </div>
            <div class="min-w-0 flex-1 pt-1">
              <p class="text-3xl font-semibold tracking-tight text-slate-950 font-display sm:text-4xl">EPCVINA Mobile</p>
              <p class="mt-2 text-2xl font-medium tracking-tight text-slate-700 font-display sm:text-3xl">Một nơi để theo dõi. Một nơi để xử lý.</p>
              <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-500">
                <span>Miễn phí</span>
                <span>·</span>
                <span>Không quảng cáo</span>
                <a href="/ung-dung/epcvina-app" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50">
                  Mở app web
                </a>
              </div>
              <div class="mt-5 flex flex-wrap gap-2">
                {['Theo dõi dự án', 'Hỗ trợ kỹ thuật', 'Tài liệu', 'Báo cáo', 'Riêng tư', 'Tối ưu mobile'].map((category, index) => (
                  <span class={`rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] ${index === 0 ? 'bg-black text-white' : 'bg-slate-100 text-slate-600'}`}>
                    {category}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 font-medium text-slate-700">
              <span class="text-slate-900">4.9</span>
              <span>★</span>
              <span>2,4 N đánh giá</span>
            </span>
            <span>12+ giao diện nội bộ</span>
            <span>EPCVINA</span>
            <span>VI + EN</span>
            <span>24,6 MB</span>
          </div>

          <div class="space-y-3 text-[15px] leading-7 text-slate-600">
            <p>Giao diện nội bộ lấy cảm hứng từ App Store, nhưng vẫn giữ người dùng ở trong hệ sinh thái EPCVINA.</p>
            <p>Ứng dụng hỗ trợ theo dõi dự án, nhận hỗ trợ kỹ thuật và tra cứu tài liệu trong một luồng gọn và riêng tư.</p>
          </div>

          <div class="grid gap-3 sm:grid-cols-3">
            {features.map((feature) => (
              <div class="rounded-[1.5rem] border border-slate-200 bg-white p-4 shadow-sm">
                <p class="text-sm font-semibold text-slate-950 font-display">{feature.title}</p>
                <p class="mt-1 text-sm leading-6 text-slate-600">{feature.desc}</p>
              </div>
            ))}
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-white p-4 sm:p-5 shadow-sm">
            <div class="mb-4 flex items-center justify-between gap-3">
              <div>
                <p class="text-xs uppercase tracking-[0.22em] text-slate-500 font-display">Sơ đồ luồng</p>
                <p class="mt-1 text-sm font-semibold text-slate-900 font-display">Cách app được dùng trong công trình</p>
              </div>
              <span class="text-xs text-slate-400">Edit view</span>
            </div>
            <div class="overflow-x-auto">
              <svg viewBox="0 0 960 220" class="h-[220px] min-w-[760px] w-full" role="img" aria-label="Sơ đồ luồng sử dụng ứng dụng EPCVINA">
                <defs>
                  <linearGradient id="flowAccent" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#0f172a" />
                    <stop offset="100%" stop-color="#f97316" />
                  </linearGradient>
                  <marker id="arrowHead" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
                    <path d="M0,0 L0,6 L8,3 z" fill="#cbd5e1" />
                  </marker>
                </defs>

                <rect x="24" y="32" rx="28" ry="28" width="240" height="156" fill="#ffffff" stroke="#cbd5e1" />
                <rect x="360" y="32" rx="28" ry="28" width="240" height="156" fill="#0f172a" stroke="#0f172a" />
                <rect x="696" y="32" rx="28" ry="28" width="240" height="156" fill="#ffffff" stroke="#cbd5e1" />

                <path d="M264 110H336" stroke="url(#flowAccent)" stroke-width="4" stroke-linecap="round" marker-end="url(#arrowHead)" />
                <path d="M600 110H672" stroke="url(#flowAccent)" stroke-width="4" stroke-linecap="round" marker-end="url(#arrowHead)" />

                <circle cx="120" cy="72" r="14" fill="#0f172a" />
                <circle cx="456" cy="72" r="14" fill="#f97316" />
                <circle cx="792" cy="72" r="14" fill="#0f172a" />

                <text x="120" y="78" text-anchor="middle" font-size="12" font-weight="700" fill="#ffffff">1</text>
                <text x="456" y="78" text-anchor="middle" font-size="12" font-weight="700" fill="#ffffff">2</text>
                <text x="792" y="78" text-anchor="middle" font-size="12" font-weight="700" fill="#ffffff">3</text>

                <text x="48" y="120" font-size="20" font-weight="700" fill="#0f172a">Dự án</text>
                <text x="48" y="148" font-size="14" fill="#475569">Mốc tiến độ, nghiệm thu, bàn giao</text>

                <text x="384" y="120" font-size="20" font-weight="700" fill="#ffffff">Hỗ trợ</text>
                <text x="384" y="148" font-size="14" fill="#cbd5e1">Gửi yêu cầu, xem trạng thái xử lý</text>

                <text x="720" y="120" font-size="20" font-weight="700" fill="#0f172a">Tài liệu</text>
                <text x="720" y="148" font-size="14" fill="#475569">Catalogue, checklist, hướng dẫn</text>
              </svg>
            </div>
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-[#fbfbfd] p-4 sm:p-5">
            <div class="mb-4 flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-[0.22em] text-slate-500 font-display">Ảnh chụp màn hình</p>
                <p class="mt-1 text-sm font-semibold text-slate-900 font-display">Xem nhanh các màn hình chính</p>
              </div>
              <span class="text-xs text-slate-400">Vuốt để xem</span>
            </div>
            <div class="flex gap-4 overflow-x-auto pb-2 snap-x snap-mandatory">
              {screenshots.map((shot, index) => (
                <div class="min-w-[78%] snap-start sm:min-w-[320px]">
                  <div class={`rounded-[2rem] p-4 shadow-sm ring-1 ring-black/5 ${index === 0 ? 'bg-slate-950 text-white' : index === 1 ? 'bg-slate-100 text-slate-900' : 'bg-white text-slate-900'}`}>
                    <div class="flex items-center justify-between">
                      <span class={`text-xs font-semibold uppercase tracking-[0.22em] font-display ${index === 0 ? 'text-white/50' : 'text-slate-400'}`}>0{index + 1}</span>
                      <span class={`rounded-full px-3 py-1 text-xs font-medium ${index === 0 ? 'bg-white/10 text-white' : 'bg-black/5 text-slate-600'}`}>{shot.title}</span>
                    </div>
                    <div class="mt-4 rounded-[1.5rem] border border-dashed border-current/15 p-4">
                      <div class={`aspect-[9/16] rounded-[1.2rem] p-4 ${index === 0 ? 'bg-white/6' : 'bg-white'}`}>
                        <div class="flex h-full flex-col justify-between rounded-[1rem] p-4" style={`background: ${index === 0 ? 'linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02))' : 'linear-gradient(180deg, #ffffff, #f8fafc)'}`}>
                          <div class="space-y-2">
                            <div class="h-3 w-24 rounded-full bg-current/10"></div>
                            <div class="h-6 w-2/3 rounded-full bg-current/15"></div>
                            <div class="grid grid-cols-2 gap-2 pt-2">
                              <div class="h-20 rounded-2xl bg-current/10"></div>
                              <div class="h-20 rounded-2xl bg-current/10"></div>
                            </div>
                          </div>
                          <div class="space-y-2">
                            <div class="h-10 rounded-2xl bg-current/10"></div>
                            <div class="h-3 w-3/4 rounded-full bg-current/10"></div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <p class={`mt-4 text-sm leading-6 ${index === 0 ? 'text-white/75' : 'text-slate-600'}`}>{shot.note}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5">
            <div class="flex items-center gap-4">
              <div class="flex h-14 w-14 items-center justify-center rounded-[1.25rem] bg-gradient-to-br from-slate-950 to-slate-700 text-xl text-white"></div>
              <div>
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500 font-display">Ứng dụng EPCVINA</p>
                <p class="text-base font-semibold text-slate-900 font-display">EPCVINA Mobile</p>
              </div>
              <a href="/ung-dung/chplay" class="ml-auto inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50">
                Xem CH Play
              </a>
            </div>
          </div>
        </div>

        <div class="space-y-5">
          <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-[#fbfbfd]">
            <div class="border-b border-slate-200 px-5 py-4">
                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-black text-white"></div>
                  <div>
                  <p class="text-xs uppercase tracking-[0.2em] text-slate-500 font-display">Ứng dụng EPCVINA</p>
                  <p class="text-sm font-semibold text-slate-900 font-display">EPCVINA Mobile</p>
                  </div>
                </div>
            </div>
            <div class="space-y-4 p-5">
              <div class="rounded-[1.5rem] bg-white p-4 shadow-sm ring-1 ring-black/5">
                <div class="flex items-start gap-4">
                  <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-[1.25rem] bg-gradient-to-br from-slate-900 to-slate-700 text-xl text-white"></div>
                  <div class="min-w-0 flex-1">
                    <p class="text-base font-semibold text-slate-950 font-display">EPCVINA Mobile</p>
                    <p class="mt-1 text-sm text-slate-500">Ứng dụng nội bộ cho khách hàng EPCVINA</p>
                    <div class="mt-3 flex items-center gap-3">
                      <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 font-display">4.9 ★</span>
                      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-600 font-display">Miễn phí</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-3">
                <div class="rounded-[1.25rem] bg-slate-100 p-3 text-center">
                  <div class="text-lg font-semibold text-slate-900 font-display">365</div>
                  <div class="mt-1 text-[11px] text-slate-500">Ngày hỗ trợ</div>
                </div>
                <div class="rounded-[1.25rem] bg-slate-100 p-3 text-center">
                  <div class="text-lg font-semibold text-slate-900 font-display">24/7</div>
                  <div class="mt-1 text-[11px] text-slate-500">Giám sát</div>
                </div>
                <div class="rounded-[1.25rem] bg-slate-100 p-3 text-center">
                  <div class="text-lg font-semibold text-slate-900 font-display">1 chạm</div>
                  <div class="mt-1 text-[11px] text-slate-500">Liên hệ</div>
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5">
            <p class="text-xs uppercase tracking-[0.22em] text-slate-500 font-display">Xếp hạng và chi tiết</p>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
              {ratings.map((item) => (
                <div class="rounded-[1.25rem] bg-slate-50 p-4">
                  <p class="text-sm font-semibold text-slate-950 font-display">{item.label}</p>
                  <p class="mt-1 text-2xl font-semibold text-slate-950 font-display">{item.value}</p>
                  <p class="mt-1 text-sm text-slate-500">{item.detail}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-[0.22em] text-slate-500 font-display">Tính Năng Mới</p>
                <p class="mt-1 text-sm font-semibold text-slate-900 font-display">Phiên bản gần đây</p>
              </div>
              <button class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700">Xem tất cả</button>
            </div>
            <div class="mt-4 space-y-4 text-sm leading-6 text-slate-600">
              {releaseNotes.map((note, index) => (
                <div class="rounded-[1.25rem] bg-slate-50 p-4">
                  <p class="text-xs uppercase tracking-[0.18em] text-slate-500 font-display">Phiên bản 26.08.01 {index === 0 ? '2 ngày trước' : '1 tuần trước'}</p>
                  <p class="mt-2">{note}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-[0.22em] text-slate-500 font-display">Chế độ riêng tư</p>
                <p class="mt-1 text-sm font-semibold text-slate-900 font-display">Dữ liệu được sử dụng</p>
              </div>
              <span class="text-xs text-slate-400">Thông tin minh bạch</span>
            </div>
            <div class="mt-4 space-y-4">
              {privacyData.map((block) => (
                <div class="rounded-[1.25rem] bg-slate-50 p-4">
                  <p class="text-sm font-semibold text-slate-950 font-display">{block.title}</p>
                  <ul class="mt-2 space-y-1 text-sm text-slate-600">
                    {block.items.map((item) => (
                      <li>• {item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</StoreAppLayout>
