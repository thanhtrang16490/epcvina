---
import StoreAppLayout from '../../layouts/StoreAppLayout.astro';

const features = [
  { title: 'Theo dõi dự án', desc: 'Xem tiến độ, mốc nghiệm thu và lịch bàn giao.' },
  { title: 'Nhận hỗ trợ', desc: 'Gửi yêu cầu kỹ thuật và theo dõi phản hồi.' },
  { title: 'Tra cứu nhanh', desc: 'Mở catalogue, tài liệu và hướng dẫn sử dụng.' },
];

const categories = ['Tất cả', 'Nổi bật', 'Năng lượng', 'Theo dõi', 'Hỗ trợ', 'Tài liệu'];
const screenshots = [
  { title: 'Dashboard', note: 'Theo dõi nhanh tiến độ dự án và thông báo mới.' },
  { title: 'Hỗ trợ kỹ thuật', note: 'Gửi yêu cầu, xem trạng thái xử lý.' },
  { title: 'Tài liệu', note: 'Catalogue, hướng dẫn và checklist bàn giao.' },
];
---

<StoreAppLayout
  title="App Store EPCVINA"
  description="Trang nội bộ kiểu App Store giới thiệu ứng dụng EPCVINA."
  variant="app-store"
>
  <section class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="mb-4 flex items-center gap-3 text-sm text-slate-500">
      <a href="/" class="flex items-center gap-2 font-medium text-slate-600 hover:text-slate-900">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-black text-white text-base leading-none"></span>
        EPCVINA
      </a>
      <span class="text-slate-300">/</span>
      <span class="font-medium text-slate-500">App Store nội bộ</span>
    </div>

    <div class="rounded-[2.25rem] bg-white p-5 shadow-[0_20px_90px_rgba(15,23,42,0.08)] ring-1 ring-black/5 sm:p-6 lg:p-8">
      <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-4 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-slate-600">
            <span class="inline-block h-2 w-2 rounded-full bg-black" />
            App Store
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-[#fbfbfd] p-4 sm:p-5">
            <div class="flex items-center gap-3">
              <div class="flex-1 rounded-full border border-slate-200 bg-white px-4 py-3 shadow-sm">
                <div class="flex items-center gap-3 text-slate-400">
                  <span class="text-base">⌕</span>
                  <span class="text-sm">Tìm kiếm ứng dụng EPCVINA</span>
                </div>
              </div>
              <button class="hidden rounded-full bg-black px-4 py-3 text-sm font-semibold text-white md:inline-flex">
                Tìm
              </button>
            </div>
            <div class="mt-4 flex gap-2 overflow-x-auto pb-1">
              {categories.map((category, index) => (
                <button
                  class={`whitespace-nowrap rounded-full px-4 py-2 text-sm font-medium transition-colors ${
                    index === 0 ? 'bg-black text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50'
                  }`}
                >
                  {category}
                </button>
              ))}
            </div>
          </div>

          <div class="space-y-4">
            <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
              Ứng dụng EPCVINA
            </h1>
            <p class="max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
              Giao diện nội bộ lấy cảm hứng từ App Store, dành cho việc giới thiệu app EPCVINA mà không đưa người dùng ra ngoài hệ thống.
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-3">
            <div class="rounded-3xl bg-slate-50 p-4">
              <p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-500">Xếp hạng</p>
              <p class="mt-2 text-2xl font-semibold text-slate-950">4.9/5</p>
              <p class="mt-1 text-sm text-slate-500">Theo phản hồi nội bộ</p>
            </div>
            <div class="rounded-3xl bg-slate-50 p-4">
              <p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-500">Tốc độ</p>
              <p class="mt-2 text-2xl font-semibold text-slate-950">Nhanh</p>
              <p class="mt-1 text-sm text-slate-500">Mở dự án, báo cáo, hỗ trợ</p>
            </div>
            <div class="rounded-3xl bg-slate-50 p-4">
              <p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-500">Kết nối</p>
              <p class="mt-2 text-2xl font-semibold text-slate-950">24/7</p>
              <p class="mt-1 text-sm text-slate-500">Theo dõi và phản hồi</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <a href="/lien-he" class="inline-flex items-center justify-center rounded-full bg-black px-5 py-3 text-sm font-semibold text-white transition-transform hover:scale-[1.01] active:scale-[0.98]">
              Liên hệ hỗ trợ
            </a>
            <a href="/ung-dung/chplay" class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50">
              Xem CH Play nội bộ
            </a>
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 p-5 text-white sm:p-6">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-[11px] uppercase tracking-[0.22em] text-white/50">EPCVINA Mobile</p>
                <h2 class="mt-2 text-2xl font-semibold">Quản lý dự án trong một chạm</h2>
              </div>
              <div class="hidden rounded-full border border-white/10 bg-white/10 px-3 py-1 text-xs font-medium text-white/80 sm:inline-flex">iOS style</div>
            </div>
            <div class="mt-6 grid gap-3 md:grid-cols-3">
              {features.map((feature) => (
                <div class="rounded-2xl border border-white/10 bg-white/6 p-4">
                  <p class="text-sm font-semibold text-white">{feature.title}</p>
                  <p class="mt-1 text-sm leading-6 text-white/70">{feature.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-[#fbfbfd] p-4 sm:p-5">
            <div class="mb-4 flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-[0.22em] text-slate-500">Screenshots</p>
                <p class="mt-1 text-sm font-semibold text-slate-900">Xem nhanh luồng sử dụng</p>
              </div>
              <span class="text-xs text-slate-400">Swipe để xem</span>
            </div>
            <div class="flex gap-4 overflow-x-auto pb-2 snap-x snap-mandatory">
              {screenshots.map((shot, index) => (
                <div class="min-w-[78%] snap-start sm:min-w-[320px]">
                  <div class={`rounded-[2rem] p-4 shadow-sm ring-1 ring-black/5 ${index === 0 ? 'bg-slate-950 text-white' : index === 1 ? 'bg-slate-100 text-slate-900' : 'bg-[#fdfdfd] text-slate-900'}`}>
                    <div class="flex items-center justify-between">
                      <span class={`text-xs font-semibold uppercase tracking-[0.22em] ${index === 0 ? 'text-white/50' : 'text-slate-400'}`}>01</span>
                      <span class={`rounded-full px-3 py-1 text-xs font-medium ${index === 0 ? 'bg-white/10 text-white' : 'bg-black/5 text-slate-600'}`}>{shot.title}</span>
                    </div>
                    <div class="mt-4 rounded-[1.5rem] border border-dashed border-current/15 p-4">
                      <div class={`aspect-[9/16] rounded-[1.2rem] p-4 ${index === 0 ? 'bg-white/6' : index === 1 ? 'bg-white' : 'bg-slate-50'}`}>
                        <div class="flex h-full flex-col justify-between rounded-[1rem] p-4" style={`background: ${index === 0 ? 'linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02))' : index === 1 ? 'linear-gradient(180deg, #ffffff, #f8fafc)' : 'linear-gradient(180deg, #ffffff, #f8fafc)'}`}>
                          <div class="space-y-2">
                            <div class="h-3 w-20 rounded-full bg-current/10"></div>
                            <div class="h-6 w-3/4 rounded-full bg-current/15"></div>
                            <div class="grid grid-cols-2 gap-2 pt-2">
                              <div class="h-20 rounded-2xl bg-current/10"></div>
                              <div class="h-20 rounded-2xl bg-current/10"></div>
                            </div>
                          </div>
                          <div class="space-y-2">
                            <div class="h-10 rounded-2xl bg-current/10"></div>
                            <div class="h-3 w-3/4 rounded-full bg-current/10"></div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <p class={`mt-4 text-sm leading-6 ${index === 0 ? 'text-white/75' : 'text-slate-600'}`}>{shot.note}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-[#fbfbfd]">
            <div class="border-b border-slate-200 px-5 py-4">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-black text-white"></div>
                <div>
                  <p class="text-xs uppercase tracking-[0.2em] text-slate-500">App Store nội bộ</p>
                  <p class="text-sm font-semibold text-slate-900">EPCVINA Mobile</p>
                </div>
              </div>
            </div>
            <div class="space-y-4 p-5">
              <div class="rounded-[1.5rem] bg-white p-4 shadow-sm ring-1 ring-black/5">
                <div class="flex items-start gap-4">
                  <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-[1.25rem] bg-gradient-to-br from-slate-900 to-slate-700 text-xl text-white"></div>
                  <div class="min-w-0 flex-1">
                    <p class="text-base font-semibold text-slate-950">EPCVINA Mobile</p>
                    <p class="mt-1 text-sm text-slate-500">Ứng dụng nội bộ cho khách hàng EPCVINA</p>
                    <div class="mt-3 flex items-center gap-3">
                      <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700">4.9 ★</span>
                      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-600">Miễn phí</span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-3">
                <div class="rounded-[1.25rem] bg-slate-100 p-3 text-center">
                  <div class="text-lg font-semibold text-slate-900">365</div>
                  <div class="mt-1 text-[11px] text-slate-500">Ngày hỗ trợ</div>
                </div>
                <div class="rounded-[1.25rem] bg-slate-100 p-3 text-center">
                  <div class="text-lg font-semibold text-slate-900">24/7</div>
                  <div class="mt-1 text-[11px] text-slate-500">Giám sát</div>
                </div>
                <div class="rounded-[1.25rem] bg-slate-100 p-3 text-center">
                  <div class="text-lg font-semibold text-slate-900">1 chạm</div>
                  <div class="mt-1 text-[11px] text-slate-500">Liên hệ</div>
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-600">
            Badge App Store bên sidebar đã được trỏ về trang này để người dùng vẫn ở trong hệ thống nội bộ.
          </div>
        </div>
      </div>
    </div>
  </section>
</StoreAppLayout>
