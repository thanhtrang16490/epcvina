---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell.astro';
import ApplicationPage from '../../components/pages/application/ApplicationPage';

export function getStaticPaths() {
  return [
    // Existing application types (using slug)
    { params: { slug: 'nha-o' } },
    { params: { slug: 'van-phong' } },
    { params: { slug: 'nha-xuong' } },
    { params: { slug: 'khach-san' } },
    { params: { slug: 'nha-hang' } },
    // Note: dien-cong-nghiep, dien-dan-dung, dien-nong-nghiep now have dedicated pages
  ];
}

const { slug } = Astro.params;

const appLabelMap: Record<string, string> = {
  'nha-o': 'Nhà ở',
  'van-phong': 'Văn phòng',
  'nha-xuong': 'Nhà xưởng',
  'khach-san': 'Khách sạn',
  'nha-hang': 'Nhà hàng',
};

const appLabel = appLabelMap[slug] || slug;
const seoTitle = `Ứng dụng ${appLabel} - Điện Mặt Trời EPCVINA Solar`;
const seoDescription = `Giải pháp điện mặt trời cho ${appLabel.toLowerCase()}. Lắp đặt trọn gói, tiết kiệm đến 90% hóa đơn điện.`;
---
<DashboardLayout title={seoTitle} description={seoDescription}>
  <DashboardShell>
    <ApplicationPage applicationType={slug as any} client:idle />
  </DashboardShell>
</DashboardLayout>
