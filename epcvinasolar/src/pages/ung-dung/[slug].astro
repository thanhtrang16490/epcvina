---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import ApplicationPage from '../../components/pages/application/ApplicationPage';

export function getStaticPaths() {
  return [
    // Existing application types (using slug)
    { params: { slug: 'nha-o' } },
    { params: { slug: 'van-phong' } },
    { params: { slug: 'nha-xuong' } },
    { params: { slug: 'khach-san' } },
    { params: { slug: 'nha-hang' } },
    // Note: dien-cong-nghiep, dien-dan-dung, dien-nong-nghiep now have dedicated pages
  ];
}

const { slug } = Astro.params;
---
<DashboardLayout title={`Ứng dụng ${slug} - Điện mặt trời EPC Solar`} description={`Giải pháp điện mặt trời cho ${slug === 'nha-o' ? 'nhà ở' : slug === 'van-phong' ? 'văn phòng' : slug === 'nha-xuong' ? 'nhà xưởng' : slug === 'khach-san' ? 'khách sạn' : slug === 'nha-hang' ? 'nhà hàng' : slug}. Lắp đặt trọn gói, tiết kiệm đến 90% hóa đơn điện.`}>
  <DashboardShell client:load>
    <ApplicationPage applicationType={slug as any} client:idle />
  </DashboardShell>
</DashboardLayout>
