---
import GooglePlayLayout from '../../layouts/GooglePlayLayout.astro';

const screenshots = [
  { title: 'Tổng quan', note: 'Theo dõi dự án, thông báo và lối tắt.' },
  { title: 'Hỗ trợ', note: 'Gửi yêu cầu, xem trạng thái xử lý.' },
  { title: 'Tài liệu', note: 'Catalogue, hướng dẫn và checklist.' },
  { title: 'Công trình', note: 'Xem lịch thi công và cập nhật nội bộ.' },
];

const features = [
  'Theo dõi dự án',
  'Nhận thông báo',
  'Tra cứu nhanh',
  'Kết nối kỹ thuật',
  'An toàn nội bộ',
  'Hỗ trợ 24/7',
];

const reviews = [
  {
    name: 'Nguyễn Minh',
    date: '2 tháng 8, 2026',
    text: 'Giao diện gọn, mở nhanh và rất dễ tìm tài liệu khi cần hỗ trợ.',
  },
  {
    name: 'Thu Hà',
    date: '1 tháng 8, 2026',
    text: 'Phần thông báo và trạng thái xử lý giúp theo dõi công việc tiện hơn trước.',
  },
  {
    name: 'Trung Dũng',
    date: '30 tháng 7, 2026',
    text: 'Nhìn giống Google Play thật và quan trọng là vẫn ở trong hệ thống nội bộ.',
  },
];

const ratingBreakdown = [
  { star: 5, value: 74 },
  { star: 4, value: 16 },
  { star: 3, value: 6 },
  { star: 2, value: 2 },
  { star: 1, value: 2 },
];
---

<GooglePlayLayout
  title="CH Play EPCVINA"
  description="Trang nội bộ kiểu Google Play giới thiệu ứng dụng EPCVINA."
>
  <section class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">
      <span class="rounded-full bg-white px-3 py-1 shadow-sm ring-1 ring-black/5">Trò chơi</span>
      <span class="rounded-full bg-[#34A853] px-3 py-1 text-white shadow-sm">Ứng dụng</span>
      <span class="rounded-full bg-white px-3 py-1 shadow-sm ring-1 ring-black/5">Sách</span>
      <span class="rounded-full bg-white px-3 py-1 shadow-sm ring-1 ring-black/5">Trẻ em</span>
    </div>

    <div class="rounded-[2.5rem] bg-white p-5 shadow-[0_20px_90px_rgba(15,23,42,0.08)] ring-1 ring-black/5 sm:p-6 lg:p-8">
      <div class="grid gap-8 lg:grid-cols-[1.02fr_0.98fr] lg:items-start">
        <div class="min-w-0 space-y-6">
          <div class="flex items-start gap-5">
            <div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-[1.9rem] bg-gradient-to-br from-[#34A853] to-emerald-600 text-4xl text-white shadow-[0_18px_50px_rgba(52,168,83,0.26)]">
              ▶
            </div>
            <div class="min-w-0 flex-1 pt-1">
              <div class="inline-flex items-center gap-2 rounded-full bg-[#34A853]/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-[#34A853]">
                Đoạn giới thiệu
              </div>
              <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950 font-display sm:text-4xl lg:text-5xl">
                CH Play EPCVINA
              </h1>
              <p class="mt-2 text-xl font-medium tracking-tight text-slate-700 font-display sm:text-2xl">
                Kênh thao tác nhanh cho kỹ thuật và khách hàng
              </p>
              <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-500">
                <span>Chứa quảng cáo</span>
                <span>·</span>
                <span>Mua trong ứng dụng</span>
              </div>
            </div>
          </div>

          <div class="flex min-w-0 flex-wrap items-center gap-3 text-sm text-slate-500">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1.5 font-medium text-slate-700">
              <span class="text-slate-900">4,5</span>
              <span>★</span>
            </span>
            <span class="whitespace-nowrap">327 N bài đánh giá</span>
            <span class="whitespace-nowrap">3 tuổi trở lên</span>
            <span class="whitespace-nowrap">100 Tr+ lượt tải xuống</span>
          </div>

          <div class="grid grid-cols-1 gap-3 sm:flex sm:flex-wrap">
            <a href="/lien-he" class="inline-flex items-center justify-center rounded-full bg-[#34A853] px-5 py-3 text-sm font-semibold text-white transition-transform hover:scale-[1.01] active:scale-[0.98]">
              Cài đặt
            </a>
            <a href="#reviews" class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50">
              Chia sẻ
            </a>
            <a href="#privacy" class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50">
              Thêm vào danh sách yêu thích
            </a>
          </div>

          <div class="w-full max-w-full overflow-hidden rounded-[1.75rem] border border-slate-200 bg-[#f8f9fa] p-4 sm:p-5">
            <div class="mb-4 flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-[0.22em] text-slate-500 font-display">Đoạn giới thiệu</p>
                <p class="mt-1 text-sm font-semibold text-slate-900 font-display">Ảnh chụp màn hình</p>
              </div>
            </div>
            <div class="flex gap-4 overflow-x-auto pb-2 snap-x snap-mandatory">
              {screenshots.map((shot, index) => (
                <div class="min-w-[78%] max-w-full snap-start sm:min-w-[320px]">
                  <div class={`rounded-[2rem] p-4 shadow-sm ring-1 ring-black/5 ${index % 2 === 0 ? 'bg-[#0f172a] text-white' : 'bg-slate-100 text-slate-900'}`}>
                    <div class="flex items-center justify-between">
                      <span class={`text-xs font-semibold uppercase tracking-[0.22em] font-display ${index % 2 === 0 ? 'text-white/50' : 'text-slate-400'}`}>0{index + 1}</span>
                      <span class={`rounded-full px-3 py-1 text-xs font-medium ${index % 2 === 0 ? 'bg-white/10 text-white' : 'bg-black/5 text-slate-600'}`}>{shot.title}</span>
                    </div>
                    <div class="mt-4 rounded-[1.5rem] border border-dashed border-current/15 p-4">
                      <div class={`aspect-[9/16] rounded-[1.2rem] p-4 ${index % 2 === 0 ? 'bg-white/6' : 'bg-white'}`}>
                        <div class="flex h-full flex-col justify-between rounded-[1rem] p-4" style={`background: ${index % 2 === 0 ? 'linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02))' : 'linear-gradient(180deg, #ffffff, #f8fafc)'}`}>
                          <div class="space-y-2">
                            <div class="h-3 w-24 rounded-full bg-current/10"></div>
                            <div class="h-6 w-2/3 rounded-full bg-current/15"></div>
                            <div class="grid grid-cols-2 gap-2 pt-2">
                              <div class="h-20 rounded-2xl bg-current/10"></div>
                              <div class="h-20 rounded-2xl bg-current/10"></div>
                            </div>
                          </div>
                          <div class="space-y-2">
                            <div class="h-10 rounded-2xl bg-current/10"></div>
                            <div class="h-3 w-3/4 rounded-full bg-current/10"></div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <p class={`mt-4 text-sm leading-6 ${index % 2 === 0 ? 'text-white/75' : 'text-slate-600'}`}>{shot.note}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="min-w-0 space-y-4">
            <h2 class="text-xl font-semibold tracking-tight text-slate-950 font-display">Giới thiệu về ứng dụng này</h2>
            <div class="w-full max-w-full overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white p-5 text-[15px] leading-7 text-slate-600 break-words">
              CH Play EPCVINA là trang nội bộ lấy cảm hứng từ Google Play, dành cho việc giới thiệu app EPCVINA và các luồng thao tác kỹ thuật mà vẫn giữ người dùng trong hệ thống.
            </div>
            <div class="w-full max-w-full overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white p-5">
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {features.map((feature) => (
                  <div class="rounded-[1.25rem] bg-slate-50 p-4">
                    <p class="text-sm font-semibold text-slate-950 font-display">{feature}</p>
                  </div>
                ))}
              </div>
            </div>
            <div class="w-full max-w-full overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white p-5">
              <p class="text-sm font-semibold text-slate-900 font-display">Lần cập nhật gần đây nhất</p>
              <p class="mt-2 text-sm text-slate-500">29 thg 7, 2026</p>
            </div>
          </div>
        </div>

        <div class="min-w-0 space-y-5">
          <div class="w-full max-w-full overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-5">
            <p class="text-xs uppercase tracking-[0.22em] text-slate-500 font-display">An toàn dữ liệu</p>
            <div class="mt-4 space-y-3 text-sm text-slate-600">
              <p>Sự an toàn bắt đầu từ việc nắm được cách nhà phát triển thu thập và chia sẻ dữ liệu của bạn.</p>
              <div class="rounded-[1.25rem] bg-slate-50 p-4">
                <p class="font-semibold text-slate-950">Không chia sẻ dữ liệu với bên thứ ba</p>
              </div>
              <div class="rounded-[1.25rem] bg-slate-50 p-4">
                <p class="font-semibold text-slate-950">Không thu thập dữ liệu nào</p>
              </div>
              <div class="rounded-[1.25rem] bg-slate-50 p-4">
                <p class="font-semibold text-slate-950">Đã cam kết tuân thủ Chính sách về gia đình của Play</p>
              </div>
            </div>
          </div>

          <div id="reviews" class="w-full max-w-full overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-5">
            <p class="text-xs uppercase tracking-[0.22em] text-slate-500 font-display">Xếp hạng và đánh giá</p>
            <div class="mt-4 grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
              <div>
                <div class="text-5xl font-semibold tracking-tight text-slate-950 font-display">4,5</div>
                <p class="mt-2 text-sm text-slate-500">278 N bài đánh giá</p>
                <div class="mt-4 space-y-2">
                  {ratingBreakdown.map((row) => (
                    <div class="flex items-center gap-3">
                      <span class="w-4 text-right text-xs font-medium text-slate-500">{row.star}</span>
                      <span class="text-xs text-slate-400">★</span>
                      <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-100">
                        <div class="h-full rounded-full bg-[#34A853]" style={`width:${row.value}%`}></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
              <div class="min-w-0 space-y-4">
                {reviews.map((review) => (
                  <div class="min-w-0 rounded-[1.25rem] bg-slate-50 p-4">
                    <div class="flex items-start justify-between gap-3">
                      <div class="min-w-0">
                        <p class="truncate font-semibold text-slate-950">{review.name}</p>
                        <div class="mt-1 flex min-w-0 flex-wrap items-center gap-2 text-xs text-slate-400">
                          <span>★★★★★</span>
                          <span class="whitespace-nowrap">{review.date}</span>
                        </div>
                      </div>
                      <button class="shrink-0 text-slate-400 transition-colors hover:text-slate-700" aria-label="more">
                        more_vert
                      </button>
                    </div>
                    <p class="mt-3 text-sm leading-6 text-slate-600">{review.text}</p>
                    <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-slate-500">
                      <span>Nội dung này có hữu ích cho bạn không?</span>
                      <button class="rounded-full bg-white px-3 py-1.5 font-medium text-slate-700 ring-1 ring-slate-200">Có</button>
                      <button class="rounded-full bg-white px-3 py-1.5 font-medium text-slate-700 ring-1 ring-slate-200">Không</button>
                    </div>
                  </div>
                ))}
                <a href="/" class="inline-flex text-sm font-medium text-[#34A853] hover:underline">
                  Xem tất cả bài đánh giá
                </a>
              </div>
            </div>
          </div>

          <div id="privacy" class="w-full max-w-full overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-5">
            <p class="text-xs uppercase tracking-[0.22em] text-slate-500 font-display">Chế độ riêng tư</p>
            <div class="mt-4 space-y-4">
              <div class="rounded-[1.25rem] bg-slate-50 p-4">
                <p class="font-semibold text-slate-950">Dữ liệu liên kết với bạn</p>
                <p class="mt-1 text-sm text-slate-600">Vị trí, thông tin liên hệ, danh bạ, nội dung của người dùng, mã định danh.</p>
              </div>
              <div class="rounded-[1.25rem] bg-slate-50 p-4">
                <p class="font-semibold text-slate-950">Dữ liệu không liên kết với bạn</p>
                <p class="mt-1 text-sm text-slate-600">Mã định danh, dữ liệu sử dụng, chẩn đoán.</p>
              </div>
            </div>
          </div>

          <div class="w-full max-w-full overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-5">
            <p class="text-xs uppercase tracking-[0.22em] text-slate-500 font-display">Thông tin hỗ trợ về ứng dụng</p>
            <div class="mt-4 space-y-3 text-sm text-slate-600">
              <p class="font-semibold text-slate-950">Email liên hệ hỗ trợ</p>
              <p>support@epcvina.com</p>
              <p class="font-semibold text-slate-950">Giới thiệu về nhà phát triển</p>
              <p>EPCVINA Digital Team</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</GooglePlayLayout>
