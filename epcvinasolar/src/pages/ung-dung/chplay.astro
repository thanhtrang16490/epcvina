---
import StoreAppLayout from '../../layouts/StoreAppLayout.astro';

const features = [
  { title: 'Nhận thông báo', desc: 'Cập nhật lịch thi công và trạng thái xử lý.' },
  { title: 'Tra cứu nhanh', desc: 'Mở tài liệu, catalogue và hướng dẫn.' },
  { title: 'Kết nối kỹ thuật', desc: 'Gửi yêu cầu hỗ trợ nhanh cho EPCVINA.' },
];

const screenshots = [
  { title: 'Home', note: 'Tổng quan dự án, thông báo và lối tắt.' },
  { title: 'Tickets', note: 'Tạo yêu cầu hỗ trợ và theo dõi trạng thái.' },
  { title: 'Library', note: 'Tài liệu, catalogue và checklist.' },
];
---

<StoreAppLayout
  title="CH Play EPCVINA"
  description="Trang nội bộ kiểu Google Play giới thiệu ứng dụng EPCVINA."
  variant="chplay"
>
  <section class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="mb-4 flex items-center gap-3 text-sm text-slate-500">
      <a href="/" class="flex items-center gap-2 font-medium text-slate-600 hover:text-slate-900">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-[#34A853] text-white text-base leading-none">▶</span>
        EPCVINA
      </a>
      <span class="text-slate-300">/</span>
      <span class="font-medium text-slate-500">CH Play nội bộ</span>
    </div>

    <div class="rounded-[2.25rem] bg-white p-5 shadow-[0_20px_90px_rgba(15,23,42,0.08)] ring-1 ring-black/5 sm:p-6 lg:p-8">
      <div class="grid gap-6 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <div class="order-2 space-y-4 lg:order-1">
          <div class="relative overflow-hidden rounded-[2rem] border border-slate-200 bg-[#0f172a] p-5 text-white sm:p-6">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(52,168,83,0.22),_transparent_35%)]" />
            <div class="relative">
              <div class="flex items-center justify-between gap-3">
                <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-white/70">
                  Google Play
                </div>
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-white/70">Android style</span>
              </div>
              <h2 class="mt-5 max-w-md text-2xl font-semibold tracking-tight text-white sm:text-3xl">
                Kênh thao tác nhanh cho kỹ thuật và khách hàng
              </h2>
              <div class="mt-6 grid gap-3">
                {features.map((feature) => (
                  <div class="rounded-2xl border border-white/10 bg-white/6 p-4">
                    <p class="text-sm font-semibold text-white">{feature.title}</p>
                    <p class="mt-1 text-sm leading-6 text-white/70">{feature.desc}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-3">
            <div class="rounded-3xl bg-[#34A853]/10 p-4">
              <p class="text-xs font-medium uppercase tracking-[0.18em] text-[#34A853]">Tốc độ</p>
              <p class="mt-2 text-2xl font-semibold text-slate-950">Mượt</p>
              <p class="mt-1 text-sm text-slate-500">Mở nhanh, thao tác gọn</p>
            </div>
            <div class="rounded-3xl bg-slate-100 p-4">
              <p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-500">Kết nối</p>
              <p class="mt-2 text-2xl font-semibold text-slate-950">Luôn sẵn</p>
              <p class="mt-1 text-sm text-slate-500">Gửi yêu cầu hỗ trợ ngay</p>
            </div>
            <div class="rounded-3xl bg-slate-100 p-4">
              <p class="text-xs font-medium uppercase tracking-[0.18em] text-slate-500">Nội bộ</p>
              <p class="mt-2 text-2xl font-semibold text-slate-950">An toàn</p>
              <p class="mt-1 text-sm text-slate-500">Không rời khỏi hệ thống</p>
            </div>
          </div>
        </div>

        <div class="order-1 space-y-6 lg:order-2">
          <div class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-4 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] text-slate-600">
            <span class="inline-block h-2 w-2 rounded-full bg-[#34A853]" />
            Google Play
          </div>
          <div class="space-y-4">
            <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
              Ứng dụng EPCVINA
            </h1>
            <p class="max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
              Giao diện nội bộ lấy cảm hứng từ Google Play, dành cho việc giới thiệu app EPCVINA mà không đưa người dùng ra ngoài hệ thống.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="/lien-he" class="inline-flex items-center justify-center rounded-full bg-[#34A853] px-5 py-3 text-sm font-semibold text-white transition-transform hover:scale-[1.01] active:scale-[0.98]">
              Liên hệ hỗ trợ
            </a>
            <a href="/ung-dung/app-store" class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50">
              Xem App Store nội bộ
            </a>
          </div>

          <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white">
            <div class="border-b border-slate-200 px-5 py-4">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <p class="text-xs uppercase tracking-[0.22em] text-slate-500">About this app</p>
                  <p class="mt-1 text-base font-semibold text-slate-950">EPCVINA Mobile</p>
                </div>
                <div class="rounded-full bg-[#34A853]/10 px-3 py-1 text-xs font-semibold text-[#34A853]">
                  Nội bộ
                </div>
              </div>
            </div>
            <div class="grid gap-3 p-5 sm:grid-cols-2 lg:grid-cols-4">
              <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Đánh giá</p>
                <p class="mt-2 text-2xl font-semibold text-slate-950">4.8</p>
                <p class="mt-1 text-sm text-slate-500">1.2K nhận xét</p>
              </div>
              <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Độ tuổi</p>
                <p class="mt-2 text-2xl font-semibold text-slate-950">3+</p>
                <p class="mt-1 text-sm text-slate-500">Phù hợp mọi người dùng</p>
              </div>
              <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Kích thước</p>
                <p class="mt-2 text-2xl font-semibold text-slate-950">24 MB</p>
                <p class="mt-1 text-sm text-slate-500">Cài đặt nhanh</p>
              </div>
              <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Danh mục</p>
                <p class="mt-2 text-2xl font-semibold text-slate-950">Công cụ</p>
                <p class="mt-1 text-sm text-slate-500">Năng suất & hỗ trợ</p>
              </div>
            </div>
          </div>

          <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-[#fdfdfd]">
            <div class="border-b border-slate-200 px-5 py-4">
              <p class="text-xs uppercase tracking-[0.22em] text-slate-500">Featured app</p>
              <p class="mt-1 text-base font-semibold text-slate-950">EPCVINA Mobile</p>
            </div>
            <div class="p-5">
              <div class="rounded-[1.5rem] bg-white p-4 shadow-sm ring-1 ring-black/5">
                <div class="flex items-start gap-4">
                  <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-[1.25rem] bg-gradient-to-br from-[#34A853] to-emerald-600 text-white">
                    ▶
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-base font-semibold text-slate-950">EPCVINA Mobile</p>
                    <p class="mt-1 text-sm text-slate-500">Ứng dụng nội bộ cho khách hàng EPCVINA</p>
                    <div class="mt-3 flex items-center gap-3">
                      <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700">4.8 ★</span>
                      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-600">Tối ưu mobile</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mt-4 grid grid-cols-3 gap-3">
                <div class="rounded-[1.25rem] bg-slate-100 p-3 text-center">
                  <div class="text-lg font-semibold text-slate-900">24/7</div>
                  <div class="mt-1 text-[11px] text-slate-500">Giám sát</div>
                </div>
                <div class="rounded-[1.25rem] bg-slate-100 p-3 text-center">
                  <div class="text-lg font-semibold text-slate-900">1 chạm</div>
                  <div class="mt-1 text-[11px] text-slate-500">Liên hệ</div>
                </div>
                <div class="rounded-[1.25rem] bg-slate-100 p-3 text-center">
                  <div class="text-lg font-semibold text-slate-900">Nội bộ</div>
                  <div class="mt-1 text-[11px] text-slate-500">An toàn</div>
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-[1.75rem] border border-slate-200 bg-[#fdfdfd] p-4 sm:p-5">
            <div class="mb-4 flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-[0.22em] text-slate-500">Screenshots</p>
                <p class="mt-1 text-sm font-semibold text-slate-900">Trình bày như trang CH Play</p>
              </div>
              <span class="text-xs text-slate-400">Swipe để xem</span>
            </div>
            <div class="flex gap-4 overflow-x-auto pb-2 snap-x snap-mandatory">
              {screenshots.map((shot, index) => (
                <div class="min-w-[78%] snap-start sm:min-w-[320px]">
                  <div class={`rounded-[2rem] p-4 shadow-sm ring-1 ring-black/5 ${index === 0 ? 'bg-[#0f172a] text-white' : index === 1 ? 'bg-slate-100 text-slate-900' : 'bg-white text-slate-900'}`}>
                    <div class="flex items-center justify-between">
                      <span class={`text-xs font-semibold uppercase tracking-[0.22em] ${index === 0 ? 'text-white/50' : 'text-slate-400'}`}>0{index + 1}</span>
                      <span class={`rounded-full px-3 py-1 text-xs font-medium ${index === 0 ? 'bg-white/10 text-white' : 'bg-black/5 text-slate-600'}`}>{shot.title}</span>
                    </div>
                    <div class="mt-4 rounded-[1.5rem] border border-dashed border-current/15 p-4">
                      <div class={`aspect-[9/16] rounded-[1.2rem] p-4 ${index === 0 ? 'bg-white/6' : 'bg-white'}`}>
                        <div class="flex h-full flex-col justify-between rounded-[1rem] p-4" style={`background: ${index === 0 ? 'linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02))' : 'linear-gradient(180deg, #ffffff, #f8fafc)'}`}>
                          <div class="space-y-2">
                            <div class="h-3 w-24 rounded-full bg-current/10"></div>
                            <div class="h-6 w-2/3 rounded-full bg-current/15"></div>
                            <div class="grid grid-cols-2 gap-2 pt-2">
                              <div class="h-20 rounded-2xl bg-current/10"></div>
                              <div class="h-20 rounded-2xl bg-current/10"></div>
                            </div>
                          </div>
                          <div class="space-y-2">
                            <div class="h-10 rounded-2xl bg-current/10"></div>
                            <div class="h-3 w-3/4 rounded-full bg-current/10"></div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <p class={`mt-4 text-sm leading-6 ${index === 0 ? 'text-white/75' : 'text-slate-600'}`}>{shot.note}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</StoreAppLayout>
