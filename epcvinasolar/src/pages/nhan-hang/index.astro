---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import { localBrands } from '../../data/brands';
import { getCollection } from 'astro:content';
import { Shield, ArrowRight, Globe, MapPin, Star, Buildings, Package, Lightning } from '@phosphor-icons/react';

const brands = localBrands
  .filter(b => b.logo_url || b.description)
  .sort((a, b) => a.name.localeCompare(b.name));

const products = await getCollection('products');
const brandStats = localBrands.map((brand) => {
  const count = products.filter((product) => product.data.brand.toLowerCase() === brand.name.toLowerCase()).length;
  return { ...brand, productCount: count };
});

const featuredBrands = brandStats
  .filter((brand) => brand.productCount > 0)
  .sort((a, b) => b.productCount - a.productCount)
  .slice(0, 6);

const solutionGroups = [
  { name: 'Tấm pin', brands: ['AIKO', 'Canadian Solar', 'JA Solar', 'Longi', 'Sharp'], tone: 'from-sky-50 to-cyan-50', accent: 'text-sky-700' },
  { name: 'Biến tần', brands: ['Huawei', 'Growatt', 'SAJ', 'Sungrow', 'Deye', 'Hope Trek'], tone: 'from-orange-50 to-amber-50', accent: 'text-orange-700' },
  { name: 'Lưu trữ', brands: ['Pylontech', 'CFE', 'Deye', 'Growatt'], tone: 'from-emerald-50 to-teal-50', accent: 'text-emerald-700' },
  { name: 'Phụ kiện lắp đặt', brands: ['QUANG MINH TECH', 'Leader', 'Genix Green'], tone: 'from-slate-50 to-zinc-50', accent: 'text-slate-700' },
];

const seoTitle = 'Nhãn Hàng Chính Hãng - EPCVINA Solar';
const seoDescription = 'Danh sách nhãn hàng EPCVINA Solar phân phối và bảo chứng thương hiệu cho từng nhóm giải pháp: tấm pin, biến tần, lưu trữ và phụ kiện.';
const seoKeywords = 'nhãn hàng điện mặt trời, thương hiệu solar chính hãng, EPCVINA nhãn hàng, tấm pin, biến tần, pin lưu trữ, phụ kiện';
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Nhãn Hàng', url: 'https://epcvina.com/nhan-hang' }
  ]}
>
  <DashboardShell client:load>
    <div class="flex-1 flex flex-col">
      <section class="relative overflow-hidden bg-[radial-gradient(circle_at_top_right,_rgba(251,146,60,0.18),_transparent_30%),linear-gradient(135deg,#0f172a_0%,#111827_50%,#1e293b_100%)] text-white pt-16 pb-14">
        <div class="absolute inset-0 opacity-10">
          <div class="absolute top-0 right-0 w-96 h-96 bg-amber-500/20 rounded-full -translate-y-1/2 translate-x-1/4" />
          <div class="absolute bottom-0 left-0 w-72 h-72 bg-cyan-500/10 rounded-full translate-y-1/4 -translate-x-1/4" />
        </div>
        <div class="relative w-full px-4 sm:px-6 lg:px-8">
          <div class="max-w-7xl mx-auto grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
            <div class="max-w-2xl">
              <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/8 px-4 py-2 mb-5">
                <Shield className="w-5 h-5 text-amber-300" />
                <span class="text-sm font-medium tracking-wide">Nhãn hàng chính hãng</span>
              </div>
              <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-none">
                Nhãn Hàng EPCVINA Solar
              </h1>
              <p class="mt-5 text-base sm:text-lg text-slate-200 max-w-xl leading-relaxed">
                Chọn theo nhóm giải pháp, xem ngay thương hiệu phù hợp và đi đến trang chi tiết từng nhãn hàng.
              </p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href="#brands" class="inline-flex items-center gap-2 rounded-full bg-white text-slate-900 px-5 py-3 text-sm font-semibold shadow-sm transition-transform hover:-translate-y-0.5 active:translate-y-[1px]">
                  Xem nhãn hàng
                  <ArrowRight className="w-4 h-4" />
                </a>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="rounded-3xl border border-white/10 bg-white/8 p-5 backdrop-blur-sm">
                <div class="flex items-center gap-3 text-amber-300 mb-3">
                  <Buildings className="w-5 h-5" />
                  <span class="text-xs uppercase tracking-[0.2em]">Tổng quan</span>
                </div>
                <div class="text-3xl font-bold">{brandStats.length}</div>
                <p class="mt-1 text-sm text-slate-300">nhãn hàng trong hệ thống</p>
              </div>
              <div class="rounded-3xl border border-white/10 bg-white/8 p-5 backdrop-blur-sm">
                <div class="flex items-center gap-3 text-cyan-300 mb-3">
                  <Package className="w-5 h-5" />
                  <span class="text-xs uppercase tracking-[0.2em]">Sản phẩm</span>
                </div>
                <div class="text-3xl font-bold">{products.length}</div>
                <p class="mt-1 text-sm text-slate-300">thiết bị đang phân phối</p>
              </div>
              <div class="rounded-3xl border border-white/10 bg-white/8 p-5 backdrop-blur-sm">
                <div class="flex items-center gap-3 text-emerald-300 mb-3">
                  <Star className="w-5 h-5" />
                  <span class="text-xs uppercase tracking-[0.2em]">Nổi bật</span>
                </div>
                <div class="text-3xl font-bold">{featuredBrands.length}</div>
                <p class="mt-1 text-sm text-slate-300">thương hiệu chủ lực</p>
              </div>
              <div class="rounded-3xl border border-white/10 bg-white/8 p-5 backdrop-blur-sm">
                <div class="flex items-center gap-3 text-orange-300 mb-3">
                  <Lightning className="w-5 h-5" />
                  <span class="text-xs uppercase tracking-[0.2em]">Danh mục</span>
                </div>
                <div class="text-3xl font-bold">{solutionGroups.length}</div>
                <p class="mt-1 text-sm text-slate-300">nhóm giải pháp</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-white border-b border-gray-200">
        <div class="w-full px-4 sm:px-6 lg:px-8 py-3">
          <div class="max-w-7xl mx-auto">
            <nav class="flex items-center space-x-2 text-sm text-gray-600">
              <a href="/" class="hover:text-orange-600 transition-colors">Trang chủ</a>
              <span>/</span>
              <span class="text-gray-900 font-medium">Nhãn hàng</span>
            </nav>
          </div>
        </div>
      </section>

      <section class="w-full px-4 sm:px-6 lg:px-8 pt-8">
        <div class="max-w-7xl mx-auto">
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            {solutionGroups.map((group) => (
              <div class={`rounded-3xl border border-gray-200 bg-gradient-to-br ${group.tone} p-5 shadow-sm`}>
                <h2 class={`text-lg font-bold ${group.accent}`}>{group.name}</h2>
                <div class="mt-4 flex flex-wrap gap-2">
                  {group.brands.map((name) => (
                    <span class="rounded-full bg-white/70 px-3 py-1 text-xs font-medium text-gray-700">
                      {name}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="brands" class="w-full px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
        <div class="max-w-7xl mx-auto">
          <div class="flex items-end justify-between gap-4 mb-6">
            <div>
              <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Tất cả nhãn hàng</h2>
              <p class="text-sm text-gray-600 mt-1">Chọn thương hiệu để xem sản phẩm, mô tả và thông tin chi tiết.</p>
            </div>
            <p class="text-sm text-gray-500">{brands.length} nhãn hàng</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
            {brandStats.map((brand) => (
              <a
                href={`/nhan-hang/${brand.slug}`}
                class="group block overflow-hidden rounded-3xl border border-gray-200 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-orange-200 hover:shadow-[0_20px_40px_rgba(249,115,22,0.10)]"
              >
                <div class="p-6 flex items-start gap-4">
                  {brand.logo_url ? (
                    <div class="w-14 h-14 flex-shrink-0 rounded-2xl bg-gray-50 p-2 flex items-center justify-center ring-1 ring-gray-100">
                      <img src={brand.logo_url} alt={brand.name} class="w-full h-full object-contain" loading="lazy" />
                    </div>
                  ) : (
                    <div class="w-14 h-14 flex-shrink-0 rounded-2xl bg-orange-50 flex items-center justify-center">
                      <Shield className="w-7 h-7 text-orange-300" />
                    </div>
                  )}
                  <div class="flex-1 min-w-0">
                    <h3 class="text-lg font-bold text-gray-900 group-hover:text-orange-600 transition-colors">
                      {brand.name}
                    </h3>
                    <p class="mt-1 text-sm text-gray-500 line-clamp-2">
                      {brand.description}
                    </p>
                  </div>
                </div>
                <div class="px-6 pb-6 flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3">
                    {brand.country && (
                      <span class="flex items-center gap-1 text-xs text-gray-500">
                        <MapPin className="w-3 h-3" />
                        {brand.country}
                      </span>
                    )}
                    {brand.website && (
                      <span class="flex items-center gap-1 text-xs text-gray-500">
                        <Globe className="w-3 h-3" />
                        {brand.website.replace(/^https?:\/\//, '')}
                      </span>
                    )}
                    <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">
                      {brand.productCount} sản phẩm
                    </span>
                  </div>
                  <span class="text-xs text-orange-600 font-medium flex items-center gap-1 opacity-0 transition-opacity group-hover:opacity-100">
                    Xem chi tiết
                    <ArrowRight className="w-3 h-3" />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    </div>
  </DashboardShell>
</DashboardLayout>
