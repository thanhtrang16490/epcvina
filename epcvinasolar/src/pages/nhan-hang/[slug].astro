---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import BrandPage from '../../components/pages/brand/BrandPage';
import { getBrandBySlug, localBrands } from '../../data/brands';

export function getStaticPaths() {
  return localBrands.map((brand) => ({
    params: { slug: brand.slug },
    props: { brand },
  }));
}

const { brand } = Astro.props;
const currentBrand = getBrandBySlug(brand.slug);

const seoTitle = `${currentBrand?.name || brand.name} | EPCVINA`;
const seoDescription = currentBrand?.description || `Trang nhãn hàng chính hãng ${brand.name} tại EPCVINA Solar.`;
const seoKeywords = `${currentBrand?.name || brand.name}, nhãn hàng solar, thương hiệu điện mặt trời, EPCVINA Solar`;
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Nhãn Hàng', url: 'https://epcvina.com/nhan-hang' },
    { name: currentBrand?.name || brand.name, url: `https://epcvina.com/nhan-hang/${brand.slug}` }
  ]}
>
  <BrandPage brand={brand.slug} brandName={currentBrand?.name || brand.name} client:load />
</DashboardLayout>
