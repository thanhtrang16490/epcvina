---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell.astro';
import PartnersList from '../../components/pages/partner/PartnersList';
import { getCollection } from 'astro:content';

const partners = await getCollection('partners');
const activePartners = partners
  .filter(p => p.data.is_active)
  .sort((a, b) => a.data.display_order - b.data.display_order);

const seoTitle = 'Đối Tác EPCVINA Solar - EPCVINA và QUANG MINH Tech';
const seoDescription = 'Hai đối tác chính thức của EPCVINA Solar là EPCVINA và QUANG MINH Tech, tập trung vào thiết bị điện mặt trời và phụ kiện lắp đặt chính hãng.';
const seoKeywords = 'đối tác EPCVINA, QUANG MINH Tech, EPCVINA Solar, đối tác điện mặt trời';
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Đối Tác', url: 'https://epcvina.com/doi-tac' }
  ]}
>
  <DashboardShell>
    <div class="mx-auto max-w-7xl px-4 pt-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl border border-orange-200 bg-gradient-to-r from-orange-50 to-white p-5 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-2xl">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">Kênh lead riêng cho EPC</p>
            <h2 class="mt-2 text-2xl font-black text-slate-950">Đăng ký đối tác EPC để nhận giá dự án và hỗ trợ kho hàng nhanh hơn</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">
              Dành cho EPC, nhà thầu và đại lý cần báo giá, tồn kho, BOM, CO/CQ và cấu hình thiết bị theo dự án.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              href="/doi-tac/dang-ky-epc"
              class="inline-flex min-h-[48px] items-center justify-center rounded-xl bg-orange-500 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-orange-400"
            >
              Đăng ký đối tác EPC
            </a>
            <a
              href="tel:0988446113"
              class="inline-flex min-h-[48px] items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition-colors hover:border-orange-200 hover:text-orange-600"
            >
              Gọi tư vấn nhanh
            </a>
          </div>
        </div>
      </div>
    </div>
    <PartnersList client:idle partners={activePartners} />
  </DashboardShell>
</DashboardLayout>
