---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import PartnersList from '../../components/pages/partner/PartnersList';
import { getCollection } from 'astro:content';

const partners = await getCollection('partners');
const activePartners = partners
  .filter(p => p.data.is_active)
  .sort((a, b) => a.data.display_order - b.data.display_order);

const seoTitle = 'Đối Tác Chính Hãng - Thiết Bị Điện Mặt Trời AIKO, Sungrow, Growatt, Pylontech, CFE | EPCVINA Solar';
const seoDescription = 'Danh sách đối tác chính hãng của EPCVINA Solar: AIKO, JA Solar, Canadian Solar, Sharp, Huawei, Growatt, Pylontech, SAJ, Deye, Sungrow, CFE, Longi. Cam kết hàng chính hãng, bảo hành đầy đủ.';
const seoKeywords = 'đối tác điện mặt trời, thương hiệu solar chính hãng, AIKO Solar, JA Solar, Canadian Solar, Sharp Solar, Huawei Solar, Growatt, Pylontech, Sungrow, CFE, EPCVINA đối tác';
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Đối Tác', url: 'https://epcvina.com/doi-tac' }
  ]}
>
  <DashboardShell client:load>
    <PartnersList client:idle partners={activePartners} />
  </DashboardShell>
</DashboardLayout>
