    'warranty-policy': { title: 'Warranty Policy', description: 'Coverage and warranty periods for equipment and systems.' },
    terms: { title: 'Terms of Use', description: 'Rules for using the EPCVINA website and services.' },
  },
  zh: {
    policies: { title: '公司政策', description: 'EPCVINA Solar 适用政策概览。' },
    'privacy-policy': { title: '隐私政策', description: '我们如何保护客户与个人信息。' },
    'payment-policy': { title: '付款政策', description: '项目与设备付款规则。' },
