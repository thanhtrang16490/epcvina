    terms: { title: '使用条款', description: '使用 EPCVINA 网站和服务的规则。' },
  },
  ja: {
    policies: { title: '会社ポリシー', description: 'EPCVINA Solar に適用される各種ポリシー一覧。' },
    'privacy-policy': { title: 'プライバシーポリシー', description: 'お客様情報と個人情報の保護方針。' },
    'payment-policy': { title: 'お支払いポリシー', description: '案件・機器の支払い条件。' },
    'returns-policy': { title: '返品・キャンセルポリシー', description: '返品、返金、キャンセルの条件。' },
    'delivery-policy': { title: '納品・施工ポリシー', description: '納品、物流、施工の流れ。' },
    'warranty-policy': { title: '保証ポリシー', description: '機器とシステムの保証範囲と期間。' },
    terms: { title: '利用規約', description: 'EPCVINA のサイトとサービスの利用条件。' },
  },
  ko: {
    policies: { title: '회사 정책', description: 'EPCVINA Solar에 적용되는 정책 안내입니다.' },
    'privacy-policy': { title: '개인정보 처리방침', description: '고객 및 개인정보 보호 원칙입니다.' },
    'payment-policy': { title: '결제 정책', description: '프로젝트와 장비에 대한 결제 규정입니다.' },
    'returns-policy': { title: '반품 및 취소 정책', description: '반품, 환불, 취소 조건입니다.' },
    'delivery-policy': { title: '배송 및 시공 정책', description: '배송, 물류, 시공 절차입니다.' },
    'warranty-policy': { title: '보증 정책', description: '장비와 시스템의 보증 범위와 기간입니다.' },
    terms: { title: '이용 약관', description: 'EPCVINA 사이트와 서비스 이용 조건입니다.' },
  },
