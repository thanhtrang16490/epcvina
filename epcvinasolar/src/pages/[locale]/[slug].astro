      '보증 문의나 진단은 기술팀으로 연락해 주세요.',
    ],
    terms: [
      '본 웹사이트를 사용하면 게시된 약관과 정책에 동의한 것으로 간주됩니다.',
      '별도 명시가 없는 한 콘텐츠, 이미지, 문서는 EPCVINA의 자산입니다.',
      '법적 또는 운영상 변경을 반영하기 위해 약관을 업데이트할 수 있습니다.',
    ],
  },
} satisfies Record<Exclude<Locale, 'vi'>, Record<string, string[]>>;

export function getStaticPaths() {
  return ['en', 'zh', 'ja', 'ko'].flatMap((locale) =>
    ['policies', 'privacy-policy', 'payment-policy', 'returns-policy', 'delivery-policy', 'warranty-policy', 'terms'].map((slug) => ({
      params: { locale, slug },
    })),
  );
}

const { locale, slug } = Astro.params as { locale: Locale; slug: string };
const page = policyRoutes[locale]?.[slug];
if (!page) {
  return Astro.redirect('/', 302);
}

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const backHref = getLocalizedRoute(locale, 'policies');
---

<DashboardLayout
  title={`${page.title} - EPCVINA Solar`}
  description={page.description}
  noindex={false}
  breadcrumbs={[
    { name: locale === 'vi' ? 'Trang chủ' : 'Home', url: `https://epcvina.com${getLocalizedRoute(locale, 'home')}` },
    { name: page.title, url: canonical },
  ]}
>
  <DashboardShell client:load>
    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
      <div class="mb-8">
        <a href={backHref} class="text-sm text-gray-500 hover:text-gray-700 transition-colors">← {locale === 'vi' ? 'Tất cả chính sách' : 'All policies'}</a>
      </div>

      <h1 class="text-3xl font-bold text-gray-900 mb-2">{page.title}</h1>
      <p class="text-sm text-gray-500 mb-10">{page.description}</p>

      <div class="space-y-5 text-gray-700 leading-relaxed">
        {policyContent[locale][slug]?.map((item) => (
          <p>{item}</p>
        ))}
      </div>
    </main>
  </DashboardShell>
</DashboardLayout>
