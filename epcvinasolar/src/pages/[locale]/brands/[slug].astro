---
import { type Locale } from '../../../i18n/messages';
import { getLocalizedRoute } from '../../../i18n/routes';

export const prerender = false;

const { locale } = Astro.params as { locale: Locale; slug: string };
const { slug } = Astro.params as { locale: Locale; slug: string };
const target = `${getLocalizedRoute(locale, 'brands')}/${slug}`;
---

<meta http-equiv="refresh" content={`0; url=${target}`} />
