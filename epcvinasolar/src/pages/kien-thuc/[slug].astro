---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell.astro';
import HeaderBar from '../../components/home/layout/HeaderBar';
import { getCollection } from 'astro:content';

export const prerender = true;

const categoryEntries = [
  ['dien-mat-troi-co-ban', {
    title: 'Điện Mặt Trời Cơ Bản',
    description: 'Kiến thức nền tảng về điện mặt trời, nguyên lý hoạt động và các hệ thống phổ biến.',
    intro: 'Đây là cụm nội dung dành cho người mới bắt đầu, giúp bạn nắm nhanh khái niệm và cách hệ thống vận hành.',
    posts: [
      'dien-mat-troi-la-gi',
      'cac-loai-he-thong-solar',
      'so-sanh-on-grid-vs-hybrid',
      'tam-pin-monocrystal-vs-polycrystal',
    ],
  }],
  ['chi-phi-dau-tu', {
    title: 'Chi Phí & Đầu Tư',
    description: 'Phân tích chi phí, thời gian hoàn vốn, ROI và các yếu tố ảnh hưởng đến giá hệ thống.',
    intro: 'Cụm này gom các bài về chi phí để bạn ước lượng ngân sách và thời gian thu hồi vốn rõ ràng hơn.',
    posts: [
      'chi-phi-lap-dien-mat-troi-2026',
      'thoi-gian-hoan-von-solar',
      'co-nen-lap-dien-mat-troi',
      'gia-mua-dien-cua-evn',
    ],
  }],
  ['pin-luu-tru', {
    title: 'Pin Lưu Trữ & BESS',
    description: 'Tìm hiểu về pin lưu trữ, hệ thống BESS, công nghệ Lithium và ứng dụng thực tế.',
    intro: 'Khu vực này phù hợp cho người đang cân nhắc hybrid, backup điện hoặc hệ lưu trữ quy mô lớn.',
    posts: [
      'pin-luu-tru-la-gi',
      'cong-nghe-pin-lithium-vs-lfp',
      'bess-la-gi',
      'cach-chon-pin-luu-tru',
    ],
  }],
  ['ky-thuat-lap-dat', {
    title: 'Kỹ Thuật & Lắp Đặt',
    description: 'Hướng dẫn kỹ thuật, quy trình lắp đặt, vị trí tối ưu và bảo trì hệ thống.',
    intro: 'Nhóm này tổng hợp các bước kỹ thuật quan trọng để hệ thống chạy ổn định và an toàn hơn.',
    posts: [
      'quy-trinh-lap-dat-solar',
      'huong-mai-nha-tot-nhat',
      'bao-tri-he-thong-solar',
      'chong-set-cho-solar',
    ],
  }],
  ['chinh-sach-phap-luat', {
    title: 'Chính Sách & Pháp Luật',
    description: 'Cập nhật chính sách, quy định pháp luật, cơ chế giá và thủ tục đấu nối.',
    intro: 'Mục này giúp bạn đọc nhanh các thay đổi chính sách và hiểu thủ tục triển khai thực tế.',
    posts: [
      'chinh-sach-dien-mat-troi-2026',
      'thu-tuc-dau-noi-dien-luc',
      'dpm-cao-cap-la-gi',
      'co-che-mua-dien-moi',
    ],
  }],
  ['ung-dung-thuc-te', {
    title: 'Ứng Dụng Thực Tế',
    description: 'Case study thực tế, kinh nghiệm lắp đặt, câu chuyện khách hàng và xu hướng ứng dụng.',
    intro: 'Cụm này hướng vào tình huống thật, để bạn nhìn rõ cách điện mặt trời được áp dụng trong đời sống.',
    posts: [
      'lap-solar-cho-nha-pho',
      'lap-solar-cho-biet-thu',
      'solar-ket-hop-sac-xe-dien',
      'ung-dung-solar-nong-nghiep',
    ],
  }],
] as const;

const categoryMap = Object.fromEntries(categoryEntries);
export function getStaticPaths() {
  return [
    'dien-mat-troi-co-ban',
    'chi-phi-dau-tu',
    'pin-luu-tru',
    'ky-thuat-lap-dat',
    'chinh-sach-phap-luat',
    'ung-dung-thuc-te',
  ].map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const category = categoryMap[slug as keyof typeof categoryMap];

const allPosts = await getCollection('blog');
const posts = category.posts
  .map((postSlug) => allPosts.find((post) => post.id === postSlug))
  .filter((post): post is (typeof allPosts)[number] => Boolean(post));
---

<DashboardLayout
  title={`${category.title} | Kiến Thức Điện Mặt Trời`}
  description={category.description}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Kiến thức', url: 'https://epcvina.com/kien-thuc' },
    { name: category.title, url: `https://epcvina.com/kien-thuc/${slug}` },
  ]}
>
  <DashboardShell>
    <HeaderBar client:idle />
    <main class="min-h-screen bg-slate-50 md:pt-16">
      <section class="bg-gradient-to-br from-blue-900 via-blue-800 to-indigo-900 text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <p class="text-xs font-bold tracking-[0.22em] uppercase text-blue-200 mb-3">Mục chi tiết</p>
          <h1 class="text-4xl sm:text-5xl font-bold">{category.title}</h1>
          <p class="mt-4 max-w-3xl text-lg text-blue-100">{category.intro}</p>
        </div>
      </section>

      <section class="py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-8">
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Bài viết trong mục này</h2>
            <p class="mt-2 text-slate-600">Các bài đang hoạt động để bạn đọc theo luồng đúng chủ đề.</p>
          </div>
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            {posts.map((post) => (
              <a href={`/tin-tuc/${post.id}`} class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md transition-all">
                <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-blue-700">Bài viết</p>
                <h3 class="mt-3 text-lg font-bold text-slate-900 leading-snug">{post.data.title}</h3>
                <p class="mt-2 text-sm text-slate-600 line-clamp-3">{post.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>
  </DashboardShell>
</DashboardLayout>
