---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import HeaderBar from '../../components/home/layout/HeaderBar';
import KienThucHubPage from '../../components/pages/kienthuc/KienThucHubPage';
import { buildFaqSchema } from '../../lib/schema';

export const prerender = true;

const seoTitle = 'Kiến Thức Điện Mặt Trời 2026 - Tổng Hợp Từ A-Z | EPCVINA';
const seoDescription = 'Thư viện kiến thức điện mặt trời đầy đủ: hướng dẫn lắp đặt, chi phí, chính sách, pin lưu trữ, kỹ thuật. Cập nhật mới nhất 2026.';
const seoKeywords = 'kiến thức điện mặt trời, tài liệu solar, hướng dẫn lắp điện mặt trời, điện mặt trời cơ bản, pin lưu trữ, EPCVINA';

const faqSchema = buildFaqSchema([
  { q: 'Điện mặt trời có những loại hệ thống nào?', a: 'Có 3 loại chính: On-Grid (hòa lưới), Hybrid (kết hợp lưu trữ), và Off-Grid (độc lập). Mỗi loại phù hợp với nhu cầu khác nhau.' },
  { q: 'Chi phí lắp điện mặt trời bao nhiêu?', a: 'Từ 40-300 triệu tùy công suất. Hệ 3kWp cho gia đình từ 40 triệu, hệ 10kWp từ 110 triệu. Hoàn vốn 3-6 năm.' },
  { q: 'Thời gian hoàn vốn của điện mặt trời?', a: 'Trung bình 3-6 năm tùy công suất, vị trí và mức tiêu thụ điện. Sau hoàn vốn, hệ thống tạo điện miễn phí 20-25 năm.' },
]);
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Kiến Thức', url: 'https://epcvina.com/kien-thuc' }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <DashboardShell client:idle>
      <HeaderBar client:idle />
      <KienThucHubPage client:visible />
    </DashboardShell>
</DashboardLayout>
