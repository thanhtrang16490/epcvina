---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DashboardShell from '../../../components/layout/DashboardShell';
import OnGridListingPage from '../../../components/combo/OnGridListingPage';
---

<DashboardLayout
  title="On-Grid Solar | EPCVINA Solar"
  description="Hệ thống điện mặt trời On-Grid hòa lưới - tiết kiệm 70-90% hóa đơn điện. Combo trọn gói từ 5kW-50kW. Hoàn vốn 3-5 năm. Lắp đặt chuyên nghiệp tại Hà Nội."
  keywords="combo on-grid, điện mặt trời hòa lưới, solar on grid, tiết kiệm tiền điện, EPCVINA Solar on-grid, lắp điện mặt trời giá rẻ"
  breadcrumbs={[{name: "Trang Chủ", url: "https://epcvina.com"}, {name: "Solar Home", url: "https://epcvina.com/solar-home"}, {name: "On-Grid", url: "https://epcvina.com/solar-home/on-grid"}]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Lắp Đặt Hệ Thống Điện Mặt Trời On-Grid",
    "description": "Lắp đặt hệ thống điện mặt trời on-grid trọn gói, tiết kiệm điện 70-90%. Bảo hành 25 năm. Tư vấn miễn phí tại Hà Nội.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "EPCVINA Solar",
      "url": "https://epcvina.com"
    },
    "areaServed": {
      "@type": "City",
      "name": "Hà Nội"
    },
    "serviceType": "Solar Panel Installation",
    "priceRange": "$$"
  })} />
  <DashboardShell>
    <OnGridListingPage />
  </DashboardShell>
</DashboardLayout>
