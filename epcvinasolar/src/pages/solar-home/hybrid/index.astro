    "provider": {
      "@type": "LocalBusiness",
      "name": "EPC Solar",
      "url": "https://epcvina.com"
    },
    "areaServed": {
      "@type": "City",
      "name": "Hà Nội"
    },
    "serviceType": "Hybrid Solar Panel Installation",
    "priceRange": "$$$"
  })} />
  <DashboardShell client:load>
    <HybridListingPage client:idle />
  </DashboardShell>
</DashboardLayout>
