---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import DashboardShell from '../../../components/layout/DashboardShell.astro';
import HybridListingPage from '../../../components/combo/HybridListingPage';
---

<DashboardLayout
  title="Combo Hybrid Solar | EPCVINA Solar"
  description="Hệ thống điện mặt trời Hybrid có pin lưu trữ - đảm bảo nguồn điện liên tục 24/7. Combo 5kW-15kW, phù hợp khi cần dự phòng mất điện và tự chủ năng lượng."
  keywords="combo hybrid, điện mặt trời hybrid, pin lưu trữ, solar hybrid, EPCVINA hybrid, hệ thống điện độc lập, dự phòng mất điện"
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[{name: "Trang Chủ", url: "https://epcvina.com"}, {name: "Giải Pháp", url: "https://epcvina.com/solar-home"}, {name: "Hybrid", url: "https://epcvina.com/solar-home/hybrid"}]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Lắp Đặt Hệ Thống Điện Mặt Trời Hybrid",
    "description": "Lắp đặt hệ thống điện mặt trời hybrid có pin lưu trữ trọn gói, đảm bảo nguồn điện 24/7 và dự phòng khi mất điện. Bảo hành 25 năm. Tư vấn miễn phí tại Hà Nội.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "EPCVINA Solar",
      "url": "https://epcvina.com"
    },
    "areaServed": {
      "@type": "City",
      "name": "Hà Nội"
    },
    "serviceType": "Hybrid Solar Panel Installation",
    "priceRange": "$$$"
  })} />
  <DashboardShell>
    <HybridListingPage client:idle />
  </DashboardShell>
</DashboardLayout>
