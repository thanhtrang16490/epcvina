---
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import HybridPage from '../../components/pages/hybrid/HybridPage';

const { slug } = Astro.params;
---

<DashboardLayout title={`${slug} - Combo Hybrid - EPC Solar`} description={`Combo điện mặt trời Hybrid ${slug} - Lưu trữ pin BESS, backup toàn bộ tải. Tiết kiệm 90% điện, hoạt động độc lập khi mất điện. EPC Solar báo giá miễn phí.`}>
  <DashboardShell client:load>
    <HybridPage comboSlug={slug} client:idle />
  </DashboardShell>
</DashboardLayout>
