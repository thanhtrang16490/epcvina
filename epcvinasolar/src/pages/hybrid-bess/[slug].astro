---
export const prerender = false;

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell.astro';
import HybridPage from '../../components/pages/hybrid/HybridPage';

const slug = Astro.params.slug ?? '';

const formatHybridSlug = (value: string) => {
  const normalized = value.replace(/^hybrid-/, '');
  const parts = normalized.split('-').filter(Boolean);

  const power = parts[0] || '';
  const phasePart = parts.find((part) => part.includes('pha')) || '';
  const batteryPart = parts.find((part) => part.includes('kwh')) || '';
  const suffix = parts.find((part) => ['at', 'ac'].includes(part)) || '';

  const formatPower = (input: string) => {
    const match = input.match(/^(\d+(?:\.\d+)?)(kwp?|kwh)$/i);
    if (!match) return input;
    const [, number, unit] = match;
    const label = unit.toLowerCase() === 'kwh' ? 'kWh' : 'kWp';
    return `${number} ${label}`;
  };

  const phaseLabel =
    phasePart === '1pha' ? '1 pha' :
    phasePart === '3pha' ? '3 pha' :
    phasePart ? phasePart.replace(/pha/i, ' pha') : '';

  const batteryLabel = batteryPart ? formatPower(batteryPart) : '';
  const suffixLabel = suffix === 'at' ? 'AT' : suffix === 'ac' ? 'AC' : '';

  return [
    'Hybrid',
    formatPower(power),
    phaseLabel,
    suffixLabel,
    batteryLabel,
  ].filter(Boolean).join(' ');
};

const readableTitle = formatHybridSlug(slug);
const seoTitle = `Hybrid BESS ${readableTitle} | EPCVINA Solar`;
const seoDescription = `Combo điện mặt trời ${readableTitle} - Lưu trữ pin BESS, backup toàn bộ tải. Tiết kiệm 90% điện, hoạt động độc lập khi mất điện. EPCVINA Solar báo giá miễn phí.`;
---

<DashboardLayout title={seoTitle} description={seoDescription}>
  <DashboardShell>
    <HybridPage comboSlug={slug} client:idle />
  </DashboardShell>
</DashboardLayout>
