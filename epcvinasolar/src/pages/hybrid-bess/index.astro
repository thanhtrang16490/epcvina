---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import HybridBESSPage from '../../components/pages/hybrid/HybridBESSPage';
import { buildFaqSchema, buildProductSchema } from '../../lib/schema';
---

<DashboardLayout
  title="Hybrid Solar + Pin Lưu Trữ BESS - Điện 24/7 | EPC Solar Hà Nội"
  description="Hệ thống Hybrid Solar kết hợp pin lưu trữ BESS - cung cấp điện 24/7 không phụ thuộc lưới. Tối ưu chi phí, bảo hành 25 năm. Tư vấn miễn phí."
  keywords="hybrid solar, BESS, pin lưu trữ năng lượng, battery storage, lưu trữ điện mặt trời, backup điện, EPCVINA Solar"
  breadcrumbs={[{name: "Trang Chủ", url: "https://epcvina.com"}, {name: "Giải Pháp", url: "https://epcvina.com"}, {name: "Hybrid BESS", url: "https://epcvina.com/hybrid-bess"}]}
>
  <!-- Service Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(buildProductSchema({
    name: 'Lắp Đặt Hệ Thống Hybrid Solar + Pin Lưu Trữ BESS',
    description: 'Hệ thống hybrid solar kết hợp pin lưu trữ BESS, cung cấp điện 24/7. Tối ưu chi phí điện năng. Bảo hành 25 năm.',
    brandName: 'EPCVINA Solar',
    url: 'https://epcvina.com/hybrid-bess',
  }))} />
  
  <!-- FAQ Schema for Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(buildFaqSchema([
    { q: 'Hybrid Solar Là Gì? Khác On-Grid Chỗ Nào?', a: 'Hybrid Solar là hệ thống điện mặt trời kết hợp pin lưu trữ (BESS), có thể hoạt động độc lập khi mất điện. Khác với On-Grid (phụ thuộc lưới điện), Hybrid cung cấp điện 24/7.' },
    { q: 'Pin Lưu Trữ BESS Bền Bao Lâu?', a: 'Pin lithium LiFePO4 có tuổi thọ 10-15 năm (6000-8000 chu kỳ sạc), bảo hành 5 năm. Sau 10 năm vẫn đạt 80% dung lượng.' },
    { q: 'Chi Phí Lắp Hybrid Bao Nhiêu?', a: 'Chi phí trung bình: 5kWp + 10kWh pin: 120-150 triệu, 10kWp + 16kWh pin: 200-250 triệu. Hoàn vốn 5-7 năm, sau đó dùng điện miễn phí.' },
    { q: 'Hybrid Có Hoạt Động Khi Mất Điện Không?', a: 'Có! Hệ Hybrid tự động chuyển sang chế độ backup khi mất điện, sử dụng điện từ pin lưu trữ cung cấp cho tải quan trọng.' },
    { q: 'Nên Chọn On-Grid Hay Hybrid?', a: 'Chọn On-Grid nếu: khu vực ít mất điện, ngân sách hạn chế. Chọn Hybrid nếu: hay mất điện, cần backup 24/7, muốn tối đa hóa sử dụng điện mặt trời.' },
  ]))} />
  <DashboardShell client:load>
    <HybridBESSPage client:idle />
  </DashboardShell>
</DashboardLayout>
