---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell';
import { buildFaqSchema } from '../lib/schema';
---

<script type="module">
  import { redirectToThankYou, submitCrmLead } from '../lib/crm-leads';

  const structuredData = buildFaqSchema([
    { q: 'EPCVINA Solar tuyển dụng những vị trí nào?', a: 'EPCVINA Solar thường xuyên tuyển dụng: Kỹ sư điện – năng lượng mặt trời, Kỹ thuật viên lắp đặt, Nhân viên kinh doanh, Thiết kế hệ thống điện, và Thực tập sinh các ngành kỹ thuật.' },
    { q: 'Quyền lợi khi làm việc tại EPCVINA Solar?', a: 'Lương cạnh tranh, thưởng theo dự án, bảo hiểm sức khỏe PVI, đào tạo chuyên sâu về điện mặt trời, cơ hội thăng tiến, môi trường làm việc năng động và nhiều chế độ phúc lợi khác.' },
    { q: 'Nộp hồ sơ ứng tuyển qua kênh nào?', a: 'Bạn có thể nộp hồ sơ qua email: epcvinasolar@gmail.com, liên hệ Zalo: 0988 446 113, hoặc điền form trực tiếp trên trang này.' },
  ]);

  document.addEventListener('DOMContentLoaded', () => {
    const structuredDataEl = document.createElement('script');
    structuredDataEl.type = 'application/ld+json';
    structuredDataEl.text = JSON.stringify(structuredData);
    document.head.appendChild(structuredDataEl);

    const applyForm = document.getElementById('apply-form');
    const applySuccess = document.getElementById('apply-success');

    applyForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;

      const getValue = (selector) => {
        const element = form.querySelector(selector);
        return element && 'value' in element ? element.value : '';
      };

      const name = getValue('[name="name"]');
      const phone = getValue('[name="phone"]');
      const email = getValue('[name="email"]');
      const position = getValue('[name="position"]');
      const experience = getValue('[name="experience"]');
      const cv = getValue('[name="cv"]');

      const lines = [
        'Ứng tuyển từ website EPCVINA Solar:',
        `Họ tên: ${name}`,
        `SĐT: ${phone}`,
        email ? `Email: ${email}` : '',
        `Vị trí: ${position}`,
        experience ? `Kinh nghiệm: ${experience}` : '',
        cv ? `CV: ${cv}` : '',
      ].filter(Boolean);

      try {
        await submitCrmLead({
          name,
          phone,
          email: email || undefined,
          message: lines.join('\n'),
          source_form: 'recruitment_application',
          metadata: {
            position,
            experience: experience || undefined,
            cv: cv || undefined,
          },
        });
        redirectToThankYou('recruitment_application');
      } catch {
        window.open(`https://zalo.me/0368927332?msg=${encodeURIComponent(lines.join('\n'))}`, '_blank');
        form.classList.add('hidden');
        applySuccess?.classList.remove('hidden');
      }
    });
  });
</script>
