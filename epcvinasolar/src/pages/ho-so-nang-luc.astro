import DashboardShell from '../components/layout/DashboardShell.astro';
import HoSoNangLucPage from '../components/pages/profile/HoSoNangLucPage';
---

<DashboardLayout
  title="Hồ Sơ Năng Lực EPCVINA Solar | Năng Lực Tổng Thầu EPC"
  description="Hồ sơ năng lực EPCVINA Solar: năng lực tổng thầu EPC, đội ngũ kỹ sư, chứng nhận chất lượng, đối tác thương hiệu và phạm vi dịch vụ cho dự án điện mặt trời và MEP."
