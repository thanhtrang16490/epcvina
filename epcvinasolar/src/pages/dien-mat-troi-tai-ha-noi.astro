ink-0 bg-transparent" src="data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2024%2024%27%20fill=%27none%27%20stroke=%27%23DC2626%27%20stroke-width=%272%27%3E%3Ccircle%20cx=%2712%27%20cy=%2712%27%20r=%279%27/%3E%3Cpath%20d=%27m8%2012%202.5%202.5%205-5%27/%3E%3C/svg%3E"><p class="leading-[120%]">Khi thiếu điện mặt trời, hệ thống tự động chuyển sang điện lưới</p></div></div><div class="typo-body flex flex-col border-t border-[#D1D5DB] md:border-t-0 divide-y divide-[#D1D5DB] md:divide-y-0 md:gap-4 pt-0 md:pt-1 text-[#4B4B4B]"><div class="grid grid-cols-2 gap-3 sm:gap-4 md:gap-8 py-2.5 md:py-0"><div class="flex items-center md:items-start gap-3"><img alt="" class="h-6 w-6 md:h-7 md:w-7 object-contain shrink-0 bg-transparent" src="data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2024%2024%27%20fill=%27none%27%20stroke=%27%23DC2626%27%20stroke-width=%272%27%3E%3Ccircle%20cx=%2712%27%20cy=%2712%27%20r=%279%27/%3E%3Cpath%20d=%27m8%2012%202.5%202.5%205-5%27/%3E%3C/svg%3E"><p class="text-left leading-[120%] md:leading-[125%]">Lưu trữ điện dư để sử dụng vào buổi tối hoặc khi mất điện</p></div><div class="flex items-center md:items-start gap-3"><img alt="" class="h-6 w-6 md:h-7 md:w-7 object-contain shrink-0 bg-transparent" src="data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2024%2024%27%20fill=%27none%27%20stroke=%27%23DC2626%27%20stroke-width=%272%27%3E%3Ccircle%20cx=%2712%27%20cy=%2712%27%20r=%279%27/%3E%3Cpath%20d=%27m8%2012%202.5%202.5%205-5%27/%3E%3C/svg%3E"><p class="text-left leading-[120%] md:leading-[125%]">Không lưu trữ, phần điện dư không được tận dụng</p></div></div><div class="grid grid-cols-2 gap-3 sm:gap-4 md:gap-8 py-2.5 md:py-0"><div class="flex items-center md:items-start gap-3"><img alt="" class="h-6 w-6 md:h-7 md:w-7 object-contain shrink-0 bg-transparent" src="data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2