      }

      .carousel-item .combo-price-block p:last-child {
        color: #ea580c !important;
        font-size: 18px !important;
        font-weight: 700 !important;
      }

      .carousel-item .flex.flex-col.gap-2.p-3 {
        padding: 14px 16px 16px !important;
