---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import DashboardShell from "../components/layout/DashboardShell.astro";
import FooterSection from "../components/home/layout/FooterSection";
import { buildFaqSchema } from "../lib/schema";

export const prerender = true;

const faqSchema = buildFaqSchema([
  { question: "Hệ thống điện mặt trời EPCVINA tạo ra bao nhiêu điện mỗi tháng?", answer: "Sản lượng phụ thuộc vào công suất, hướng mái, bóng che và thời tiết. EPCVINA Solar khảo sát biểu đồ tiêu thụ và diện tích mái để tư vấn công suất phù hợp." },
  { question: "Nên chọn On-grid hay Hybrid có pin lưu trữ?", answer: "On-grid phù hợp để giảm tiền điện với chi phí đầu tư tối ưu. Hybrid phù hợp khi cần dùng điện vào buổi tối hoặc duy trì tải ưu tiên khi mất điện." },
  { question: "Tấm pin Aiko 650W có phù hợp với mọi mái nhà không?", answer: "EPCVINA kiểm tra kết cấu, hướng mái, bóng che và diện tích thực tế trước khi chốt cấu hình Aiko 650W." },
  { question: "EPCVINA khảo sát và báo giá như thế nào?", answer: "EPCVINA khảo sát nhu cầu sử dụng điện, hiện trạng mái và vị trí lắp đặt. Báo giá thể hiện rõ thiết bị, phạm vi thi công, tiến độ và chính sách bảo hành." },
]);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://epcvina.com/dien-mat-troi-tai-ha-noi#service",
  "name": "Lắp đặt điện mặt trời trọn gói tại Hà Nội",
  "serviceType": "Tư vấn, thiết kế và thi công hệ thống điện mặt trời",
  "provider": { "@type": "Organization", "name": "EPCVINA Solar", "url": "https://epcvina.com" },
  "areaServed": { "@type": "City", "name": "Hà Nội" },
  "brand": { "@type": "Brand", "name": "EPCVINA Solar" },
  "description": "Giải pháp On-grid và Hybrid sử dụng tấm pin Aiko 650W, biến tần SAJ và pin lưu trữ theo nhu cầu thực tế.",
  "url": "https://epcvina.com/dien-mat-troi-tai-ha-noi",
};
---

<DashboardLayout
  title="Điện Mặt Trời Hà Nội | Lắp Đặt On-grid & Hybrid | EPCVINA Solar"
  description="EPCVINA Solar tư vấn, thiết kế và lắp đặt điện mặt trời trọn gói tại Hà Nội. Giải pháp On-grid, Hybrid pin lưu trữ, Aiko 650W và SAJ, khảo sát theo nhu cầu thực tế."
  keywords="điện mặt trời Hà Nội, lắp đặt điện mặt trời Hà Nội, điện mặt trời áp mái Hà Nội, điện mặt trời Hybrid Hà Nội, điện mặt trời On-grid Hà Nội, pin Aiko 650W, biến tần SAJ"
  ogImage="/hero-epcvina-hanoi.png"
  ogType="website"
  breadcrumbs={[{name: "Trang Chủ", url: "https://epcvina.com"}, {name: "Điện Mặt Trời Tại Hà Nội", url: "https://epcvina.com/dien-mat-troi-tai-ha-noi"}]}
  updatedTime="2026-10-03"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
