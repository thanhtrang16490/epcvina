        lightning: makeIcon('<path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z"/>')
      };
      document.querySelectorAll('img[src^="data:image/svg+xml"]').forEach((image) => {
        const text = image.parentElement?.textContent?.toLowerCase() || '';
