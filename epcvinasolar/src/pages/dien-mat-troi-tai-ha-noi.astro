          ['Dự án Hybrid 7.5 kWp - Anh Linh Dương Nội', 'Hybrid có lưu trữ', 'Dương Nội - Hà Nội', 'T9.2024', 'Longi 550 Wp · Deye 8kW 3phase · SMB 10kWh', '/du-an/anh-linh-duong-noi-7-5kwp'],
          ['Dự án 5.4 kWp - Chị Hà Long Biên', 'Hòa Lưới bám tải', 'Long Biên - Hà Nội', 'T3.2024', 'Canadian 545 Wp · Growatt 5kW 1phase', '/du-an/chi-ha-long-bien-5-4kwp'],
          ['Dự án Hybrid 5.4 kWp - Anh Thọ Uông Bí', 'Hybrid có lưu trữ', 'Uông Bí - Quảng Ninh', 'T10.2023', 'Canadian 545 Wp · Deye 5kW 1phase · PowerX 5kWh', '/du-an/anh-tho-uong-bi-5-4kwp'],
          ['Dự án Hybrid 6.5 kWp - Anh Tùng Tây Tựu', 'Hybrid có lưu trữ', 'Tây Tựu - Hà Nội', 'T12.2024', 'Longi 580 Wp · SolaX 6kW 1phase · SMB 5kWh', '/du-an/anh-tung-tay-tuu-6-5kwp']
        ];
        const projectImages = [
          '/du-an/solar-nha-dan/du-an-chi-ha-ha-dong.png',
          '/du-an/solar-nha-dan/du-an-anh-thang-hai-duong.png',
          '/du-an/solar-nha-dan/du-an-anh-linh-duong-noi.png',
          '/du-an/DU-AN-VINHOMES-GOLDEN-RIVER-BA-SON-1.jpg',
          '/du-an/solar-nha-dan/du-an-anh-tho-uong-bi.png',
          '/du-an/DU-AN-STARCITY-CENTRER-TRAN-DUY-HUNG.jpg'
        ];
        projectSection.querySelectorAll('div.cursor-pointer.snap-start').forEach((card, index) => {
          const [projectTitle, systemType, location, date, equipment, projectHref] = projectData[index] || projectData[0];
          const cardTitle = card.querySelector('h3');
          const cardImage = card.querySelector('img');
          if (cardTitle) cardTitle.textContent = projectTitle;
          if (cardImage) {
            cardImage.src = projectImages[index] || projectImages[0];
            cardImage.alt = projectTitle;
            cardImage.classList.add('aspect-square', 'object-cover', 'w-full');
            cardImage.style.aspectRatio = '1 / 1';
          }
          const imageFrame = cardImage?.parentElement;
          if (imageFrame) {
            imageFrame.classList.add('aspect-square', 'overflow-hidden');
            imageFrame.style.aspectRatio = '1 / 1';
          }
          const details = document.createElement('p');
          details.className = 'px-2 text-[13px] leading-[18px] text-[#5B6470]';
          details.textContent = `${systemType} · ${location} · ${date}`;
          const equipmentLine = document.createElement('p');
          equipmentLine.className = 'px-2 text-[12px] leading-[17px] text-[#737477]';
          equipmentLine.textContent = equipment;
          const actions = card.querySelector('.min-h-\\[91px\\]');
          if (actions && !actions.querySelector('[data-project-meta]')) {
            details.dataset.projectMeta = 'true';
            actions.insertBefore(details, actions.firstChild);
            actions.insertBefore(equipmentLine, actions.children[1]);
          }
          card.setAttribute('role', 'link');
          card.setAttribute('tabindex', '0');
          card.setAttribute('aria-label', `Xem ${card.textContent?.trim().split('Xem dự án')[0] || 'dự án'} tại EPCVINA Solar`);
          card.addEventListener('click', () => { window.location.href = projectHref; });
          card.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              window.location.href = projectHref;
            }
          });
          card.querySelectorAll('button').forEach((button) => button.remove());
        });
      }

      const faqHeading = [...document.querySelectorAll('h2')].find((heading) => heading.textContent?.trim() === 'Hỏi đáp');
      if (faqHeading) {
        faqHeading.id = 'faq';
        const faqSection = faqHeading.closest('div.mt-\\[39px\\]');
        faqSection?.querySelectorAll('button').forEach((button) => {
          if (button.textContent?.includes('Tìm hiểu thêm')) {
            button.textContent = 'Xem toàn bộ hỏi đáp';
            button.addEventListener('click', () => { faqHeading.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
          }
        });
        const answers = [
          'Sản lượng phụ thuộc vào công suất hệ thống, hướng mái, mức độ che bóng và thời tiết. EPCVINA Solar khảo sát biểu đồ tiêu thụ, diện tích mái và tư vấn công suất phù hợp để tối ưu lượng điện tự dùng.',
          'On-grid phù hợp khi mục tiêu chính là giảm tiền điện và tối ưu chi phí đầu tư. Hybrid có pin lưu trữ phù hợp khi cần dùng điện vào buổi tối hoặc duy trì tải ưu tiên khi mất điện. EPCVINA Solar sẽ tư vấn theo nhu cầu thực tế.',
          'Aiko 650W giúp tối ưu diện tích mái nhờ hiệu suất cao, nhưng cấu hình cần căn cứ vào kết cấu, hướng mái, bóng che và diện tích thực tế. EPCVINA Solar kiểm tra các yếu tố này trước khi chốt phương án.',
          'EPCVINA Solar khảo sát nhu cầu sử dụng điện, hiện trạng mái và vị trí lắp đặt. Báo giá thể hiện rõ tấm pin Aiko, biến tần SAJ, pin lưu trữ nếu có, phạm vi thi công, tiến độ và chính sách bảo hành.'
        ];
        faqSection?.querySelectorAll('h3').forEach((question, index) => {
          const answer = question.closest('.w-full')?.querySelector('.typo-longform');
          if (answer && answers[index]) answer.innerHTML = `<p>${answers[index]}</p>`;
        });
        faqSection?.querySelectorAll('.w-full.md\\:max-w-\\[845px\\]').forEach((item, index) => {
          const trigger = item.querySelector('.cursor-pointer');
          const panel = trigger?.nextElementSibling;
          const icon = trigger?.querySelector('svg');
          if (!trigger || !panel) return;
          const triggerId = `faq-question-${index + 1}`;
          const panelId = `faq-answer-${index + 1}`;
          trigger.setAttribute('role', 'button');
          trigger.setAttribute('tabindex', '0');
          trigger.setAttribute('aria-expanded', 'false');
          trigger.setAttribute('aria-controls', panelId);
          trigger.id = triggerId;
          panel.id = panelId;
          panel.setAttribute('role', 'region');
          panel.setAttribute('aria-labelledby', triggerId);

          const toggleFaq = () => {
            const isOpen = trigger.getAttribute('aria-expanded') === 'true';
            trigger.setAttribute('aria-expanded', String(!isOpen));
            panel.classList.toggle('max-h-0', isOpen);
            panel.classList.toggle('max-h-[1000px]', !isOpen);
            if (icon) icon.classList.toggle('rotate-180', !isOpen);
          };
          trigger.addEventListener('click', toggleFaq);
          trigger.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              toggleFaq();
            }
          });
        });
      }

      const formatComboPrice = (value) => `${new Intl.NumberFormat('vi-VN').format(value || 0)} đ`;
      const comboBrand = (combo) => [...(combo.components || [])]
        .map((component) => component.snapshot?.brand)
        .filter(Boolean)
        .filter((brand, index, brands) => brands.indexOf(brand) === index)
        .join(' - ');
      fetch('/api/combos')
        .then((response) => response.ok ? response.json() : null)
        .then((payload) => {
          const combos = payload?.data;
          if (!Array.isArray(combos)) return;
          document.querySelectorAll('.carousel-item').forEach((card, index) => {
            const combo = combos[index];
            if (!combo) return;
            const title = card.querySelector('h2');
            const brand = [...card.querySelectorAll('p')].find((item) => item.textContent?.includes('Aiko -'));
            const price = [...card.querySelectorAll('p')].find((item) => item.textContent?.includes('đ'));
            const power = card.querySelector('.grid-cols-\\[minmax\\(0\\,1fr\\)_minmax\\(0\\,1fr\\)\\] > span:last-child');
            const battery = [...card.querySelectorAll('span')].find((item) => item.textContent?.includes('kWh'));
            if (title) title.textContent = combo.name;
            if (brand) brand.textContent = comboBrand(combo) || 'EPCVINA Solar';
            if (price) price.textContent = formatComboPrice(combo.pricing?.total);
            const priceBlock = price?.closest('.py-4.px-4');
            const specsBlock = card.querySelector('.flex.flex-col.gap-2.p-3');
            if (priceBlock && specsBlock) {
              priceBlock.classList.add('combo-price-block');
              specsBlock.appendChild(priceBlock);
            }
            if (power && combo.system?.solar_capacity?.value) power.textContent = `${combo.system.solar_capacity.value} kWp`;
            if (battery && combo.system?.battery_capacity?.value) battery.textContent = `${combo.system.battery_capacity.value} kWh`;
            const infoRows = [...card.querySelectorAll('.grid-cols-\\[minmax\\(0\\,1fr\\)_minmax\\(0\\,1fr\\)\\]')];
            const updateRow = (label, value) => {
              const row = infoRows.find((item) => item.textContent?.toLowerCase().includes(label));
              const valueNode = row?.querySelector('span:last-child');
              if (valueNode && value) valueNode.textContent = value;
            };
            const monthly = combo.system?.estimated_generation?.monthly_kwh;
            const payback = combo.meta?.payback_label || combo.payback_period;
            const area = combo.meta?.roof_area_m2;
            const panel = (combo.components || []).find((item) => item.type === 'solar_panel');
            const inverter = (combo.components || []).find((item) => item.type === 'inverter');
            const storage = (combo.components || []).find((item) => item.type === 'battery');
            updateRow('sản lượng', monthly ? `${monthly} kWh/tháng` : 'Đang cập nhật');
            updateRow('hoàn vốn', payback ? (typeof payback === 'number' ? `${payback} năm` : payback) : 'Đang cập nhật');
            updateRow('diện tích', area ? `${area} m²` : 'Đang cập nhật');
            updateRow('aiko', panel?.quantity ? `${panel.quantity} tấm` : undefined);
            updateRow('biến tần', inverter?.snapshot?.model || inverter?.snapshot?.brand ? `${inverter?.snapshot?.brand || ''} ${inverter?.snapshot?.model || ''}`.trim() : undefined);
            updateRow('lưu trữ', storage?.quantity ? `${combo.system?.battery_capacity?.value || ''} kWh` : undefined);
            const image = card.querySelector('img[src="/sample-combo.jpg"]');
            const imageWrap = image?.parentElement;
            if (imageWrap) imageWrap.dataset.comboImageWrap = 'true';
            if (imageWrap && !imageWrap.querySelector('[data-combo-badge]')) {
              const badge = document.createElement('span');
              badge.dataset.comboBadge = 'true';
              badge.textContent = combo.system?.technology === 'hybrid' ? 'Hybrid' : 'On-Grid';
              badge.style.backgroundColor = combo.system?.technology === 'hybrid' ? 'rgba(59, 130, 246, .92)' : 'rgba(249, 115, 22, .92)';
              imageWrap.appendChild(badge);
            }
            card.dataset.comboSlug = combo.slug;
            card.setAttribute('role', 'link');
            card.setAttribute('tabindex', '0');
            card.setAttribute('aria-label', `Xem chi tiết ${combo.name}`);
            const comboHref = `/goi-combo/${combo.slug}`;
            const openCombo = () => { window.location.href = comboHref; };
            card.addEventListener('click', openCombo);
            card.addEventListener('keydown', (event) => {
              if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                openCombo();
              }
            });
          });
        })
        .catch(() => {});
    })();
  </script>
  </DashboardShell>
  <FooterSection pathname={Astro.url.pathname} />
</DashboardLayout>
