      }

      .carousel-item .grid-cols-\[minmax\(0\,1fr\)_minmax\(0\,1fr\)\] {
        min-height: 28px;
        padding-bottom: 6px;
        border-bottom: 1px solid #f1f5f9;
      }

      .carousel-item .grid-cols-\[minmax\(0\,1fr\)_minmax\(0\,1fr\)\] > span:first-child {
        color: #64748b !important;
        font-size: 12px !important;
      }

