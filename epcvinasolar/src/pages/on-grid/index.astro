---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DashboardShell from '../../components/layout/DashboardShell';
import OnGridListingPage from '../../components/combo/OnGridListingPage';
---

<DashboardLayout
  title="On-Grid Solar - Giải Pháp Tiết Kiệm Điện 70-90% | EPC Solar"
  description="Hệ thống điện mặt trời On-Grid hòa lưới - tiết kiệm 70-90% hóa đơn điện. Combo trọn gói từ 5kW-50kW. Hoàn vốn 3-5 năm. Lắp đặt chuyên nghiệp tại Hà Nội."
  keywords="combo on-grid, điện mặt trời hòa lưới, solar on grid, tiết kiệm tiền điện, EPC Solar on-grid, lắp điện mặt trời giá rẻ"
  breadcrumbs={[{name: "Trang Chủ", url: "https://epcvina.com"}, {name: "Giải Pháp", url: "https://epcvina.com"}, {name: "On-Grid", url: "https://epcvina.com/on-grid"}]}
>
  <!-- Service Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Lắp Đặt Hệ Thống Điện Mặt Trời On-Grid",
    "description": "Lắp đặt hệ thống điện mặt trời on-grid trọn gói, tiết kiệm điện 70-90%. Bảo hành 25 năm. Tư vấn miễn phí tại Hà Nội.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "EPC Solar",
      "url": "https://epcvina.com"
    },
    "areaServed": {
      "@type": "City",
      "name": "Hà Nội"
    },
    "serviceType": "Solar Panel Installation",
    "priceRange": "$$",
  })} />
  
  <!-- FAQ Schema for Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "On-Grid Solar Là Gì?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Hệ thống On-Grid (hòa lưới) là hệ thống điện mặt trời kết nối trực tiếp với lưới điện quốc gia, không sử dụng pin lưu trữ. Điện dư được bán lại cho EVN theo giá 1.866 đồng/kWh."
        }
      },
      {
        "@type": "Question",
        "name": "Chi Phí Lắp On-Grid Bao Nhiêu?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Chi phí trung bình: 5kWp: 70-90 triệu, 10kWp: 130-160 triệu, 15kWp: 180-220 triệu. Thời gian hoàn vốn 3-5 năm, sau đó sử dụng điện miễn phí 25+ năm."
        }
      },
      {
        "@type": "Question",
        "name": "On-Grid Có Hoạt Động Khi Mất Điện Không?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Không. Hệ thống On-Grid tự động ngắt khi mất điện lưới để đảm bảo an toàn cho kỹ thuật viên sửa chữa. Nếu khu vực hay mất điện, nên chọn hệ Hybrid."
        }
      },
      {
        "@type": "Question",
        "name": "Lắp On-Grid Có Cần Xin Phép Không?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Theo Nghị định 135/2024/NĐ-CP, hệ thống dưới 1MWp cần thông báo với Điện lực địa phương. EPCVINA hỗ trợ toàn bộ thủ tục đăng ký đấu nối và hợp đồng mua bán điện với EVN miễn phí."
        }
      },
      {
        "@type": "Question",
        "name": "On-Grid Tiết Kiệm Bao Nhiêu Tiền Điện?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Hệ thống On-Grid giúp giảm 70-90% hóa đơn điện hàng tháng. Ví dụ: hệ 5kWp tiết kiệm 1.5-2.5 triệu/tháng, hệ 10kWp tiết kiệm 3-5 triệu/tháng."
        }
      }
    ]
  })} />
  <DashboardShell client:load>
    <OnGridListingPage client:idle />
  </DashboardShell>
</DashboardLayout>
