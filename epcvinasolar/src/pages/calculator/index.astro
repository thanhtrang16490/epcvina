---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import CalculatorMainPage from '../../components/pages/calculator/CalculatorMainPage';

export const prerender = true;

const seoTitle = 'Công Cụ Tính Điện Mặt Trời | EPCVINA Solar';
const seoDescription = 'Nhập hóa đơn điện để EPCVINA ước lượng công suất solar, ngân sách đầu tư, pin lưu trữ và thời gian thu hồi vốn trước khi khảo sát.';
const seoKeywords = 'ước tính điện mặt trời, tư vấn solar EPCVINA, tính công suất solar, chi phí điện mặt trời, hoàn vốn điện mặt trời';
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Công Cụ Tính Toán', url: 'https://epcvina.com/calculator' }
  ]}
>
  <CalculatorMainPage client:load />
</DashboardLayout>
