---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ChiPhiDauTuPage from '../../components/pages/calculator/ChiPhiDauTuPage';

export const prerender = true;
---

<DashboardLayout
  title="Tính điện mặt trời online | Ước tính kWp, chi phí và hoàn vốn | EPCVINA"
  description="Công cụ tính chi phí đầu tư điện mặt trời online: ước tính kWp, chi phí hệ thống và thời gian hoàn vốn nhanh chóng."
  keywords="calculator điện mặt trời, tính chi phí điện mặt trời, ước tính kWp, hoàn vốn solar, EPCVINA"
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Công Cụ', url: 'https://epcvina.com/calculator' },
    { name: 'Chi Phí Đầu Tư', url: 'https://epcvina.com/calculator/chi-phi-dau-tu' }
  ]}
>
  <h1 class="sr-only">Tính Chi Phí Đầu Tư Điện Mặt Trời</h1>
  <ChiPhiDauTuPage client:visible />
</DashboardLayout>
