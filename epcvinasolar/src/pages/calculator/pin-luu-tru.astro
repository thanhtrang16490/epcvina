---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PinLuuTruPage from '../../components/pages/calculator/PinLuuTruPage';

export const prerender = true;
---

<DashboardLayout
  title="Tính Toán Dung Lượng Pin Lưu Trữ BESS Phù Hợp | EPCVINA"
  description="Tính dung lượng pin lưu trữ phù hợp nhu cầu. Bao lâu dự phòng, công suất tải ưu tiên. Chọn pin Pylontech, BYD chính hãng."
  keywords="tính pin lưu trữ, calculator BESS, dung lượng pin solar, pin lưu trữ bao nhiêu kWh, EPCVINA"
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Công Cụ', url: 'https://epcvina.com/calculator' },
    { name: 'Pin Lưu Trữ', url: 'https://epcvina.com/calculator/pin-luu-tru' }
  ]}
>
  <PinLuuTruPage client:visible />
</DashboardLayout>
