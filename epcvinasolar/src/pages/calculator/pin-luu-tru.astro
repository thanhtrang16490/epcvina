---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import PinLuuTruPage from '../../components/pages/calculator/PinLuuTruPage';

export const prerender = true;
---

<DashboardLayout
  title="Tính Toán Pin Lưu Trữ BESS | EPCVINA"
  description="Tính dung lượng pin lưu trữ phù hợp. Bao lâu dự phòng, công suất tải ưu tiên."
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Công Cụ', url: 'https://epcvina.com/calculator' },
    { name: 'Pin Lưu Trữ', url: 'https://epcvina.com/calculator/pin-luu-tru' }
  ]}
>
  <PinLuuTruPage client:visible />
</DashboardLayout>
