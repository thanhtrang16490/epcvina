---
import { buildFaqSchema } from '../lib/schema';

import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell';
import HeaderBar from '../components/home/layout/HeaderBar';
import HeroSection from '../components/home/hero/HeroSection';
import ComparisonSection from '../components/home/combos/ComparisonSection';
import SolarSolutionFinder from '../components/home/tools/SolarSolutionFinder';
import BenefitsSection from '../components/home/sections/BenefitsSection';
import MidPageCTA from '../components/home/sections/MidPageCTA';
import ProcessSection from '../components/home/sections/ProcessSection';
import ProjectsPreviewSection from '../components/home/sections/ProjectsPreviewSection';
import ReviewsSection from '../components/home/sections/ReviewsSection';
import FAQSection from '../components/home/sections/FAQSection';
import CTASection from '../components/home/contact/CTASection';
import FooterSection from '../components/home/layout/FooterSection';

// WebSite schema with SearchAction for Google
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "EPCVINA Solar - Điện Mặt Trời Trọn Gói",
  "url": "https://epcvina.com",
  "description": "Hub thương hiệu EPCVINA Solar cho gia đình, công nghiệp, hybrid, EV và báo giá. Tiết kiệm 70-90% tiền điện.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://epcvina.com/thiet-bi?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  },
  "publisher": {
    "@type": "Organization",
    "name": "EPCVINA Solar",
    "url": "https://epcvina.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://epcvina.com/favicon.svg"
    }
  }
};

// VideoObject schema for construction video
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Quy trình thi công điện mặt trời EPCVINA Solar",
  "description": "Video thực tế quy trình lắp đặt hệ thống điện mặt trời 15kWp từ khảo sát đến nghiệm thu",
  "thumbnailUrl": "https://epcvina.com/thumb-video.png",
  "contentUrl": "https://epcvina.com/home_image.mp4",
  "uploadDate": new Date().toISOString(),
  "duration": "PT1M45S",
  "publisher": {
    "@type": "Organization",
    "name": "EPCVINA Solar",
    "logo": {
      "@type": "ImageObject",
      "url": "https://epcvina.com/favicon.svg"
    }
  }
};
---

<DashboardLayout
  title="Lắp Đặt Điện Mặt Trời Trọn Gói | EPCVINA Solar"
  description="Hub chính của EPCVINA Solar cho gia đình, công nghiệp, hybrid, EV và báo giá. Khảo sát 0đ, thiết kế theo nhu cầu thật, tối ưu tiết kiệm 70-90% điện."
  keywords="EPCVINA Solar, điện mặt trời Hà Nội, solar home, hybrid bess, solar công nghiệp, sạc ev, báo giá điện mặt trời, calculator solar"
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(buildFaqSchema([
    {
      q: "Lắp điện mặt trời có cần xin phép không?",
      a: "Có. Theo Nghị định 135/2024/NĐ-CP, hệ thống điện mặt trời mái nhà dưới 1 MWp cần thông báo với Đọc điện lực địa phương. EPCVINA hỗ trợ toàn bộ thủ tục phép, đấu nối lưới và đăng ký bán điện dư với EVN miễn phí cho khách hàng.",
    },
    {
      q: "Lắp điện mặt trời có thực sự tiết kiệm tiền điện không?",
      a: "Có. Hệ thống điện mặt trời giúp giảm 70–90% hóa đơn điện hàng tháng. Với giá điện ngày càng tăng, mức tiết kiệm sẽ càng lớn theo thời gian. Trung bình một hệ 5 kWp tiết kiệm được 1.5–2.5 triệu đồng/tháng.",
    },
    {
      q: "Thời gian hoàn vốn là bao lâu?",
      a: "Thời gian hoàn vốn trung bình từ 3–5 năm cho hệ On-Grid và 5–7 năm cho hệ Hybrid. Sau khi hoàn vốn, bạn sẽ sử dụng điện miễn phí trong suốt tuổi thọ còn lại của hệ thống (20–25 năm).",
    },
    {
      q: "Tấm pin mặt trời bền được bao lâu? Bảo hành như thế nào?",
      a: "Tấm pin chất lượng cao có tuổi thọ trên 25 năm với hiệu suất giảm dần khoảng 0.5%/năm. EPCVINA bảo hành tấm pin 25 năm, inverter 5–10 năm, thi công 2 năm. Hỗ trợ kỹ thuật và bảo trì định kỳ trong suốt vòng đời hệ thống.",
    },
    {
      q: "Hệ thống có hoạt động trong ngày mưa hoặc trời âm u không?",
      a: "Có, hệ thống vẫn phát điện trong điều kiện ít nắng, tuy nhiên sản lượng sẽ giảm 50–80% so với ngày nắng. Hệ thống được thiết kế dựa trên sản lượng trung bình cả năm nên đã tính đến các ngày mưa.",
    },
    {
      q: "Chi phí phát sinh sau khi lắp đặt là bao nhiêu?",
      a: "Chi phí bảo trì rất thấp: chủ yếu là vệ sinh tấm pin 2–4 lần/năm (có thể tự làm bằng nước sạch). Không có chi phí nhiên liệu hay phụ tùng thay thế định kỳ. Bảo trì chuyên nghiệp khoảng 500.000–1.000.000đ/năm. EPCVINA có gói bảo trì O&M dài hạn.",
    },
  ]) ?? { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [] })} />
  <DashboardShell client:idle showFooter={false}>
    <HeaderBar />
    <div class="lg:-ml-16 lg:w-[calc(100%+4rem)]">
      <HeroSection />
    </div>
    <ComparisonSection />
    <SolarSolutionFinder client:visible />
    <BenefitsSection />
    <MidPageCTA variant="benefits" />
    <ProcessSection />
    <ProjectsPreviewSection />
    <ReviewsSection />
    <MidPageCTA variant="reviews" />
    <FAQSection />
    <CTASection client:visible />
    <FooterSection />
  </DashboardShell>
</DashboardLayout>
