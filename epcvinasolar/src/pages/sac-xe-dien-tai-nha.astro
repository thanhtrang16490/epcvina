---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashboardShell from '../components/layout/DashboardShell';
import SacXeDienLandingPage from '../components/pages/sacxe/SacXeDienLandingPage';
import { buildFaqSchema } from '../lib/schema';

export const prerender = true;

const seoTitle = 'Sạc Xe Điện Tại Nhà | EPCVINA Solar';
const seoDescription = 'Lắp đặt trạm sạc xe điện tại nhà. Tích hợp năng lượng mặt trời, sạc VF3/VF5/VF6. Tiết kiệm 50% chi phí sạc. Tư vấn miễn phí: 0988 446 113';
const seoKeywords = 'sạc xe điện tại nhà, trạm sạc xe điện gia đình, lắp sạc VF3, sạc VF5, sạc VF6, EPCVINA, EPCVINA Solar';

const faqSchema = buildFaqSchema([
  { q: 'Có thể lắp trạm sạc tại nhà không?', a: 'Có. EPCVINA lắp đặt trạm sạc Wallbox tại nhà cho VF3, VF5, VF6. Công suất 7-22kW, sạc đầy 4-8 tiếng.' },
  { q: 'Chi phí lắp trạm sạc bao nhiêu?', a: 'Từ 15-50 triệu tùy loại trạm. Trạm 7kW từ 15 triệu, trạm 22kW từ 30 triệu. Kết hợp điện mặt trời giảm 50% chi phí sạc.' },
  { q: 'Có thể kết hợp điện mặt trời để sạc xe không?', a: 'Có. Kết hợp điện mặt trời với trạm sạc giúp giảm 50-70% chi phí sạc. Xe chạy hoàn toàn bằng năng lượng sạch.' },
]);
---

<DashboardLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/hero-bg-1920.webp"
  breadcrumbs={[
    { name: 'Trang chủ', url: 'https://epcvina.com' },
    { name: 'Sạc Xe Điện Tại Nhà', url: 'https://epcvina.com/sac-xe-dien-tai-nha' }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <DashboardShell client:load>
      <SacXeDienLandingPage client:visible />
    </DashboardShell>
</DashboardLayout>
