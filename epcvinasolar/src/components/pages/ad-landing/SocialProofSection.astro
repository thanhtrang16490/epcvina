---
// SocialProofSection.astro - Static social proof (no React needed)
---

<section class="py-16 bg-gradient-to-r from-orange-600 via-orange-500 to-yellow-500 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        EPCVINA Trong Những Con Số
      </h2>
      <p class="text-xl opacity-90">Kết quả thực tế đã chứng minh, không phải lời hứa</p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Stat 1 -->
      <div class="text-center space-y-3">
        <div class="bg-white/20 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="text-5xl sm:text-6xl font-black mb-2">500+</div>
        <h3 class="text-xl font-bold mb-1">Gia đình đã tư vấn</h3>
        <p class="text-sm opacity-90">Tin tưởng lựa chọn EPCVINA</p>
      </div>

      <!-- Stat 2 -->
      <div class="text-center space-y-3">
        <div class="bg-white/20 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M13.414 2.92a2 2 0 0 1 2.828 0l3.293 3.293a2 2 0 0 1 0 2.829L7.414 21.164a2 2 0 0 1-2.828 0L1.293 17.871a2 2 0 0 1 0-2.828L13.414 2.92Z"/></svg>
        </div>
        <div class="text-5xl sm:text-6xl font-black mb-2">13+</div>
        <h3 class="text-xl font-bold mb-1">Dự án đã triển khai</h3>
        <p class="text-sm opacity-90">100% hoàn thành đúng hạn</p>
      </div>

      <!-- Stat 3 -->
      <div class="text-center space-y-3">
        <div class="bg-white/20 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><path d="M12 5v9"/><path d="M4.38995 10.4105L4 12L4.38995 13.5895C5.08995 16.4395 7.65995 18.5 10.69 18.5H13.31C16.34 18.5 18.91 16.4395 19.61 13.5895L20 12L19.61 10.4105C18.91 7.56047 16.34 5.5 13.31 5.5H10.69C7.65995 5.5 5.08995 7.56047 4.38995 10.4105Z"/></svg>
        </div>
        <div class="text-5xl sm:text-6xl font-black mb-2">98%</div>
        <h3 class="text-xl font-bold mb-1">Khách hàng hài lòng</h3>
        <p class="text-sm opacity-90">Đánh giá 4.8-5 sao</p>
      </div>

      <!-- Stat 4 -->
      <div class="text-center space-y-3">
        <div class="bg-white/20 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><path d="M12 22C6.5 22 2 17.5 2 12S6.5 2 12 2s10 4.5 10 10"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <div class="text-5xl sm:text-6xl font-black mb-2">45+</div>
        <h3 class="text-xl font-bold mb-1">Tấn CO2 giảm/năm</h3>
        <p class="text-sm opacity-90">Bảo vệ môi trường</p>
      </div>
    </div>

    <!-- Trust Indicators -->
    <div class="mt-16 pt-8 border-t border-white/30">
      <div class="grid md:grid-cols-3 gap-6 text-center">
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6">
          <div class="flex items-center justify-center gap-2 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-yellow-400"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <p class="text-3xl font-bold">4.9/5.0</p>
          </div>
          <p class="text-sm opacity-90">Đánh giá trung bình từ khách hàng</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6">
          <div class="flex items-center justify-center gap-2 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-yellow-400"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            <p class="text-3xl font-bold">TOP 10</p>
          </div>
          <p class="text-sm opacity-90">Nhà thầu điện mặt trời uy tín tại miền Bắc</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6">
          <div class="flex items-center justify-center gap-2 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-yellow-400"><path d="M8 2h8"/><path d="M8 6h8"/><path d="M8 10h8"/><path d="M8 14h8"/><path d="M8 18h8"/><rect width="18" height="18" x="3" y="2" rx="2"/></svg>
            <p class="text-3xl font-bold">Chứng chỉ</p>
          </div>
          <p class="text-sm opacity-90">Năng lực xây dựng & điện mặt trời</p>
        </div>
      </div>
    </div>
  </div>
</section>
