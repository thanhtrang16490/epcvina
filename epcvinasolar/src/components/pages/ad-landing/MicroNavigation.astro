---
// MicroNavigation.astro - Static HTML navigation (no React needed)
---

<nav class="sticky top-0 z-40 bg-white border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2 cursor-pointer" aria-label="EPCVINA Solar Homepage">
        <img 
          src="/logo-epcvina-solar.png" 
          alt="EPCVINA Solar" 
          class="h-10 w-auto object-contain"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-6">
        <a href="#du-an" class="text-slate-700 hover:text-orange-600 font-medium text-sm transition-colors cursor-pointer min-h-[44px] flex items-center">
          Dự án thực tế
        </a>
        <a href="#bang-gia" class="text-slate-700 hover:text-orange-600 font-medium text-sm transition-colors cursor-pointer min-h-[44px] flex items-center">
          Bảng giá tham khảo
        </a>
        <a href="#bao-hanh" class="text-slate-700 hover:text-orange-600 font-medium text-sm transition-colors cursor-pointer min-h-[44px] flex items-center">
          Chính sách bảo hành
        </a>
      </div>

      <!-- Right Actions -->
      <div class="flex items-center gap-3">
        <a href="tel:0988446113" class="hidden lg:flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white font-semibold px-4 py-2 rounded-lg transition-all cursor-pointer min-h-[44px]" aria-label="Gọi hotline 0988 446 113">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>0988 446 113</span>
        </a>
        <a href="https://zalo.me/0988446113" class="hidden sm:flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition-all cursor-pointer min-h-[44px]" aria-label="Chat Zalo với EPCVINA">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          <span>Chat Zalo</span>
        </a>
        <a href="#contact" class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-5 py-2 rounded-lg transition-all shadow-md hover:shadow-lg cursor-pointer min-h-[44px]" aria-label="Nhận tư vấn miễn phí">
          Nhận tư vấn miễn phí
        </a>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div class="md:hidden overflow-x-auto -mx-4 px-4 py-2 border-t border-slate-200 scrollbar-hide">
      <div class="flex gap-4 min-w-max">
        <a href="#du-an" class="text-slate-700 hover:text-orange-600 font-medium text-sm whitespace-nowrap transition-colors cursor-pointer min-h-[44px] flex items-center px-2">
          Dự án thực tế
        </a>
        <a href="#bang-gia" class="text-slate-700 hover:text-orange-600 font-medium text-sm whitespace-nowrap transition-colors cursor-pointer min-h-[44px] flex items-center px-2">
          Bảng giá tham khảo
        </a>
        <a href="#bao-hanh" class="text-slate-700 hover:text-orange-600 font-medium text-sm whitespace-nowrap transition-colors cursor-pointer min-h-[44px] flex items-center px-2">
          Chính sách bảo hành
        </a>
      </div>
    </div>
  </div>
</nav>
