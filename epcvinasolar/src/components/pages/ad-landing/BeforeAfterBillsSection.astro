---
// BeforeAfterBillsSection.astro - Static bill comparison (no React needed)
---

<section class="py-16 sm:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
        Hóa Đơn Điện Trước & Sau Khi Lắp
      </h2>
      <p class="text-xl text-slate-600">Bằng chứng thực tế, không phải con số ước tính</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Bill 1 -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all border border-slate-200">
        <div class="bg-slate-50 p-4 border-b border-slate-200">
          <h3 class="font-bold text-lg text-slate-900">Chị Hà - Hà Đông</h3>
          <p class="text-sm text-slate-600">15 kWp Hybrid</p>
        </div>

        <div class="p-6 space-y-4">
          <!-- Before -->
          <div class="bg-gradient-to-r from-red-500 to-red-600 rounded-xl p-4 text-white">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-semibold opacity-90">TRƯỚC</span>
              <span class="text-xs bg-white/20 px-2 py-1 rounded">Hóa đơn cũ</span>
            </div>
            <p class="text-3xl font-black">3.000.000đ/tháng</p>
          </div>

          <!-- Arrow -->
          <div class="flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-orange-500 rotate-90"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>

          <!-- After -->
          <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-xl p-4 text-white">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-semibold opacity-90">SAU</span>
              <span class="text-xs bg-white/20 px-2 py-1 rounded">Có điện mặt trời</span>
            </div>
            <p class="text-3xl font-black">400.000đ/tháng</p>
          </div>

          <!-- Savings Badge -->
          <div class="bg-gradient-to-r from-orange-500 to-yellow-500 rounded-xl p-4 text-white text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 mx-auto mb-2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
            <p class="text-sm font-semibold opacity-90 mb-1">Tiết kiệm hàng tháng</p>
            <p class="text-4xl font-black">2.6 triệu</p>
            <p class="text-lg font-bold mt-1">Giảm 87%</p>
          </div>
        </div>

        <!-- Annual Savings -->
        <div class="bg-green-50 p-4 border-t border-green-200">
          <div class="flex items-center gap-2 mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-green-600"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            <p class="text-sm text-green-700">Tiết kiệm hàng năm</p>
          </div>
          <p class="text-2xl font-bold text-green-600">
            31.000.000đ
          </p>
        </div>
      </div>

      <!-- Bill 2 -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all border border-slate-200">
        <div class="bg-slate-50 p-4 border-b border-slate-200">
          <h3 class="font-bold text-lg text-slate-900">Chú Thanh - Hải Dương</h3>
          <p class="text-sm text-slate-600">22 kWp Hybrid</p>
        </div>

        <div class="p-6 space-y-4">
          <!-- Before -->
          <div class="bg-gradient-to-r from-red-500 to-red-600 rounded-xl p-4 text-white">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-semibold opacity-90">TRƯỚC</span>
              <span class="text-xs bg-white/20 px-2 py-1 rounded">Hóa đơn cũ</span>
            </div>
            <p class="text-3xl font-black">5.000.000đ/tháng</p>
          </div>

          <!-- Arrow -->
          <div class="flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-orange-500 rotate-90"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>

          <!-- After -->
          <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-xl p-4 text-white">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-semibold opacity-90">SAU</span>
              <span class="text-xs bg-white/20 px-2 py-1 rounded">Có điện mặt trời</span>
            </div>
            <p class="text-3xl font-black">500.000đ/tháng</p>
          </div>

          <!-- Savings Badge -->
          <div class="bg-gradient-to-r from-orange-500 to-yellow-500 rounded-xl p-4 text-white text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 mx-auto mb-2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
            <p class="text-sm font-semibold opacity-90 mb-1">Tiết kiệm hàng tháng</p>
            <p class="text-4xl font-black">4.5 triệu</p>
            <p class="text-lg font-bold mt-1">Giảm 90%</p>
          </div>
        </div>

        <!-- Annual Savings -->
        <div class="bg-green-50 p-4 border-t border-green-200">
          <div class="flex items-center gap-2 mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-green-600"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            <p class="text-sm text-green-700">Tiết kiệm hàng năm</p>
          </div>
          <p class="text-2xl font-bold text-green-600">
            54.000.000đ
          </p>
        </div>
      </div>

      <!-- Bill 3 -->
      <div class="bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all border border-slate-200">
        <div class="bg-slate-50 p-4 border-b border-slate-200">
          <h3 class="font-bold text-lg text-slate-900">Anh Linh - Dương Nội</h3>
          <p class="text-sm text-slate-600">7.5 kWp Hybrid</p>
        </div>

        <div class="p-6 space-y-4">
          <!-- Before -->
          <div class="bg-gradient-to-r from-red-500 to-red-600 rounded-xl p-4 text-white">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-semibold opacity-90">TRƯỚC</span>
              <span class="text-xs bg-white/20 px-2 py-1 rounded">Hóa đơn cũ</span>
            </div>
            <p class="text-3xl font-black">2.000.000đ/tháng</p>
          </div>

          <!-- Arrow -->
          <div class="flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-orange-500 rotate-90"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>

          <!-- After -->
          <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-xl p-4 text-white">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-semibold opacity-90">SAU</span>
              <span class="text-xs bg-white/20 px-2 py-1 rounded">Có điện mặt trời</span>
            </div>
            <p class="text-3xl font-black">250.000đ/tháng</p>
          </div>

          <!-- Savings Badge -->
          <div class="bg-gradient-to-r from-orange-500 to-yellow-500 rounded-xl p-4 text-white text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 mx-auto mb-2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
            <p class="text-sm font-semibold opacity-90 mb-1">Tiết kiệm hàng tháng</p>
            <p class="text-4xl font-black">1.8 triệu</p>
            <p class="text-lg font-bold mt-1">Giảm 88%</p>
          </div>
        </div>

        <!-- Annual Savings -->
        <div class="bg-green-50 p-4 border-t border-green-200">
          <div class="flex items-center gap-2 mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-green-600"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            <p class="text-sm text-green-700">Tiết kiệm hàng năm</p>
          </div>
          <p class="text-2xl font-bold text-green-600">
            21.000.000đ
          </p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <p class="text-xl text-slate-600 mb-4">Bạn muốn tiết kiệm tương tự?</p>
      <a 
        href="#calculator" 
        class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-bold px-8 py-4 rounded-xl text-lg transition-all shadow-lg hover:shadow-xl cursor-pointer min-h-[44px]"
      >
        Tính Toán Tiết Kiệm Cho Nhà Bạn →
      </a>
    </div>
  </div>
</section>
