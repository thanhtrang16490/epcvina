        <div class="p-6 space-y-4">
          <h3 class="text-xl font-bold text-slate-900">Điện Mặt Trời 15kWp Hybrid</h3>

          <div class="flex items-center gap-2 text-slate-600">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="text-sm">Hà Đông - Hà Nội</span>
          </div>

          <div class="grid grid-cols-2 gap-4 py-4 border-t border-b border-slate-200">
            <div>
              <p class="text-sm text-slate-500">Loại hệ thống</p>
              <p class="font-semibold text-slate-900">Hybrid</p>
            </div>
            <div>
              <p class="text-sm text-slate-500">Hoàn thành</p>
              <p class="font-semibold text-slate-900">08/2024</p>
            </div>
